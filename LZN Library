    local function RefreshPopupOverlay()
        local anyVisible = false
        for _, p in ipairs(ActivePopups) do
            if p.Visible then
                anyVisible = true
                break
            end
        end
        if anyVisible and not ModalActive then
            ModalActive = true
            BlackOverlay.Visible = true
            BlackOverlay.BackgroundTransparency = 1
            TweenService:Create(BlackOverlay, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundTransparency = 0.025
            }):Play()
        elseif not anyVisible and ModalActive then
            ModalActive = false
            local fade = TweenService:Create(BlackOverlay, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundTransparency = 1
            })
            fade:Play()
            fade.Completed:Connect(function()
                if not ModalActive then BlackOverlay.Visible = false end
            end)
        end
    end

