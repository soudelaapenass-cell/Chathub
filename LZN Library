    end

    local function HideAllPagesExcept(targetKey)
        ContentContainer.Visible = (targetKey == "Home")
        GamePage.Visible = (targetKey == "Game")
        PlayerPage.Visible = (targetKey == "Player")
        for key, entry in pairs(CustomTabs) do
            local isMatch = (key == targetKey)
            entry.Frame.Visible = isMatch
            if isMatch then
                entry.Frame.Position = UDim2.new(entry.Frame.Position.X.Scale, entry.Frame.Position.X.Offset + 12, entry.Frame.Position.Y.Scale, entry.Frame.Position.Y.Offset)
                TweenService:Create(entry.Frame, TweenInfo.new(animSpeed, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                    Position = ContentContainer.Position
                }):Play()
            end
        end
        SetTabColor(HomeTabIcon, HomeTabText, HomeTab, targetKey == "Home")
        SetTabColor(GameTabIcon, GameTabText, GameTab, targetKey == "Game")
        SetTabColor(PlayerTabIcon, PlayerTabText, PlayerTab, targetKey == "Player")
        for key, entry in pairs(CustomTabs) do
            SetTabColor(entry.Icon, entry.Text, entry.Button, key == targetKey)
        end
    end

