local function GetTimePhaseColor(clockTime)
    local white = Color3.fromRGB(255, 255, 255)
    local orange = Color3.fromRGB(255, 130, 20)
    local deepPurple = Color3.fromRGB(115, 0, 225)

    if clockTime >= 6 and clockTime < 15.5 then
        return white
    elseif clockTime >= 15.5 and clockTime < 18.5 then
        local t = (clockTime - 15.5) / 3
        return white:Lerp(orange, t)
    elseif clockTime >= 18.5 and clockTime < 20.2 then
        local t = (clockTime - 18.5) / 1.7
        return orange:Lerp(deepPurple, t)
    elseif clockTime >= 20.2 or clockTime < 5 then
        return deepPurple
    else
        local t = (clockTime - 5) / 1
        return deepPurple:Lerp(white, t)
    end
end

local function FormatClock(clockTime)
    local totalMinutes = math.floor((clockTime % 24) * 60)
    local hours = math.floor(totalMinutes / 60) % 24
    local minutes = totalMinutes % 60
    return string.format("%02d:%02d", hours, minutes)
end

