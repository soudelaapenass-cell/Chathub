    local animatedGradients = {}
    local function createShineEffect(uiStroke, baseColor)
        local gradient = Instance.new("UIGradient")
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.0, baseColor),
            ColorSequenceKeypoint.new(0.35, baseColor),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(0.65, baseColor),
            ColorSequenceKeypoint.new(1.0, baseColor)
        })
        gradient.Parent = uiStroke
