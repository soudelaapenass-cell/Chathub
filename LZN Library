        ["PXP ESP"] = "-- =====================================================================\n-- Universal ProximityPrompt Hub (Elite Professional Version - Ultimate V12)\n-- =====================================================================\n\nlocal Players = game:GetService(\"Players\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal RunService = game:GetService(\"RunService\")\nlocal TweenService = game:GetService(\"TweenService\")\nlocal CoreGui = game:GetService(\"CoreGui\")\n\nlocal LocalPlayer = Players.LocalPlayer\nlocal Camera = Workspace.CurrentCamera\n\n-- Armazenamento de estado\nlocal activeESPs = {}\nlocal allESPActive = false\nlocal hubOpen = false \nlocal grabCheckConnection = nil\nlocal cachedInteractables = {}\n\n-- =====================================================================\n-- 1. Funções de Utilidade e Verificação (Otimizadas)\n-- =====================================================================\nlocal function isHeld(obj)\n    for _, player in ipairs(Players:GetPlayers()) do\n        if player.Character and obj:IsDescendantOf(player.Character) then\n            return true\n        end\n    end\n    return false\nend\n\nlocal function getPartFromPrompt(prompt)\n    if not prompt or not prompt.Parent then return nil end\n    if prompt.Parent:IsA(\"BasePart\") then return prompt.Parent end\n    \n    local model = prompt:FindFirstAncestorWhichIsA(\"Model\")\n    if model then\n        if model.PrimaryPart then return model.PrimaryPart end\n        local part = model:FindFirstChildWhichIsA(\"BasePart\", true)\n        if part then return part end\n    end\n    \n    local ancestorPart = prompt:FindFirstAncestorWhichIsA(\"BasePart\")\n    if ancestorPart then return ancestorPart end\n    \n    local childPart = prompt.Parent:FindFirstChildWhichIsA(\"BasePart\", true)\n    return childPart\nend\n\nlocal function handleDroppedItems()\n    pcall(function()\n        for _, obj in ipairs(Workspace:GetDescendants()) do\n            if obj:IsA(\"Tool\") and not isHeld(obj) then\n                local handle = obj:FindFirstChild(\"Handle\") or obj:FindFirstChildWhichIsA(\"BasePart\")\n                if handle and not handle:FindFirstChildOfClass(\"ProximityPrompt\") then\n                    local prompt = Instance.new(\"ProximityPrompt\")\n                    prompt.ActionText = \"Pegar\"\n                    prompt.ObjectText = obj.Name\n                    prompt.HoldDuration = 0\n                    prompt.MaxActivationDistance = 9e9\n                    prompt.RequiresLineOfSight = false\n                    prompt.Parent = handle\n                end\n            end\n        end\n    end)\nend\n\nlocal function getInteractables()\n    local list = {}\n    handleDroppedItems()\n    \n    for _, obj in ipairs(Workspace:GetDescendants()) do\n        if isHeld(obj) then continue end\n\n        if obj:IsA(\"ProximityPrompt\") then\n            local p = getPartFromPrompt(obj)\n            if p then\n                table.insert(list, {\n                    id = obj,\n                    part = p,\n                    name = (obj.ObjectText ~= \"\" and obj.ObjectText or (obj.ActionText ~= \"\" and obj.ActionText or (obj.Parent and obj.Parent.Name or \"Prompt\"))),\n                    type = \"Prompt\"\n                })\n            end\n        elseif obj:IsA(\"ClickDetector\") then\n            local p = obj.Parent\n            if p and p:IsA(\"BasePart\") then\n                table.insert(list, {\n                    id = obj,\n                    part = p,\n                    name = p.Name,\n                    type = \"Click\"\n                })\n            end\n        elseif obj:IsA(\"TouchTransmitter\") then\n            local p = obj.Parent\n            if p and p:IsA(\"BasePart\") and p.Size.Magnitude <= 25 then\n                if not p:FindFirstChildOfClass(\"ProximityPrompt\") and not p:FindFirstChildOfClass(\"ClickDetector\") then\n                    table.insert(list, {\n                        id = p,\n                        part = p,\n                        name = p.Name .. \" [Tocar]\",\n                        type = \"Touch\"\n                    })\n                end\n            end\n        end\n    end\n    return list\nend\n\n-- =====================================================================\n-- 2. Sistema de ESP e Grab Distance Bypass\n-- =====================================================================\nlocal function createESP(targetId, targetPart, itemName)\n    if activeESPs[targetId] then return end\n    if not targetPart then return end\n\n    local itemColor = Color3.fromRGB(255, 255, 255)\n    pcall(function()\n        if targetPart:IsA(\"BasePart\") then\n            itemColor = targetPart.Color\n            if (itemColor.R + itemColor.G + itemColor.B) < 0.2 then\n                itemColor = Color3.fromRGB(255, 255, 100)\n            end\n        end\n    end)\n\n    local bill = Instance.new(\"BillboardGui\")\n    bill.Name = \"ESP_Prompt\"\n    bill.AlwaysOnTop = true\n    bill.Size = UDim2.new(0, 150, 0, 50)\n    bill.StudsOffset = Vector3.new(0, 2, 0)\n    bill.Parent = targetPart\n\n    local txt = Instance.new(\"TextLabel\")\n    txt.Size = UDim2.new(1, 0, 1, 0)\n    txt.BackgroundTransparency = 1\n    txt.Text = itemName\n    txt.TextColor3 = itemColor\n    txt.TextStrokeTransparency = 0.2\n    txt.Font = Enum.Font.GothamBold\n    txt.TextSize = 14\n    txt.Parent = bill\n\n    activeESPs[targetId] = {billboard = bill, textLabel = txt, name = itemName, part = targetPart}\nend\n\nlocal function removeESP(targetId)\n    if activeESPs[targetId] then\n        if activeESPs[targetId].billboard then activeESPs[targetId].billboard:Destroy() end\n        activeESPs[targetId] = nil\n    end\nend\n\nlocal function remoteGrab(targetId, interactionType, targetPart)\n    task.spawn(function()\n        if interactionType == \"Prompt\" and targetId:IsA(\"ProximityPrompt\") then\n            local originalDistance = targetId.MaxActivationDistance\n            local originalDuration = targetId.HoldDuration\n            \n            targetId.MaxActivationDistance = 9e9\n            targetId.HoldDuration = 0\n            \n            if fireproximityprompt then\n                pcall(function() fireproximityprompt(targetId) end)\n            end\n            pcall(function()\n                targetId:InputHoldBegin()\n                task.wait(0.02)\n                targetId:InputHoldEnd()\n            end)\n            \n            task.wait(0.05)\n            targetId.MaxActivationDistance = originalDistance\n            targetId.HoldDuration = originalDuration\n\n        elseif interactionType == \"Click\" and targetId:IsA(\"ClickDetector\") then\n            if fireclickdetector then\n                pcall(function() fireclickdetector(targetId) end)\n            end\n\n        elseif interactionType == \"Touch\" and targetId:IsA(\"BasePart\") then\n            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\") then\n                if firetouchinterest then\n                    pcall(function()\n                        firetouchinterest(LocalPlayer.Character.HumanoidRootPart, targetId, 0)\n                        task.wait(0.02)\n                        firetouchinterest(LocalPlayer.Character.HumanoidRootPart, targetId, 1)\n                    end)\n                else\n                    pcall(function()\n                        local hrp = LocalPlayer.Character.HumanoidRootPart\n                        local oldCFrame = hrp.CFrame\n                        hrp.CFrame = targetId.CFrame\n                        task.wait(0.05)\n                        hrp.CFrame = oldCFrame\n                    end)\n                end\n            end\n        end\n    end)\nend\n\n-- =====================================================================\n-- 3. Interface Gráfica\n-- =======================================================