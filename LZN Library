local function MakeDraggable(gui)
    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil
    local inputChangedConnection = nil

    gui.InputBegan:Connect(function(input)
        if dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        dragging = true
        dragStart = input.Position
        startPos = gui.Position
        dragInput = input

        if inputChangedConnection then
            inputChangedConnection:Disconnect()
            inputChangedConnection = nil
        end

        inputChangedConnection = UserInputService.InputChanged:Connect(function(changedInput)
            if not dragging or not dragInput or not dragStart or not startPos then return end

            local isMouseMove = dragInput.UserInputType == Enum.UserInputType.MouseButton1
                and changedInput.UserInputType == Enum.UserInputType.MouseMovement
            local isSameTouch = dragInput.UserInputType == Enum.UserInputType.Touch
                and changedInput == dragInput

            if isMouseMove or isSameTouch then
                local delta = changedInput.Position - dragStart
                gui.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end)

        local endedConnection
        endedConnection = UserInputService.InputEnded:Connect(function(endedInput)
            local isSameMouse = dragInput and dragInput.UserInputType == Enum.UserInputType.MouseButton1
                and endedInput.UserInputType == Enum.UserInputType.MouseButton1
            local isSameTouch = dragInput and dragInput.UserInputType == Enum.UserInputType.Touch
                and endedInput == dragInput

            if isSameMouse or isSameTouch then
                dragging = false
                dragInput = nil
                dragStart = nil
                startPos = nil
                if inputChangedConnection then
                    inputChangedConnection:Disconnect()
                    inputChangedConnection = nil
                end
                if endedConnection then
                    endedConnection:Disconnect()
                    endedConnection = nil
                end
            end
        end)
    end)
end

local function AddClickEffect(btn)
    local clickScale = Instance.new("UIScale")
    clickScale.Scale = 1
    clickScale.Parent = btn

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(clickScale, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Scale = 0.93
            }):Play()
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(clickScale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Scale = 1
            }):Play()
        end
    end)
end

local function AddGlow(parent, color, size, transparency)
    local glow = Instance.new("UIStroke")
    glow.Color = color or Color3.fromRGB(0, 190, 255)
    glow.Thickness = size or 1.8
    glow.Transparency = transparency or 0.25
    glow.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    glow.Parent = parent
    return glow
end

local function AddGradient(parent, c1, c2, rotation)
    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, c1),
        ColorSequenceKeypoint.new(1, c2)
    })
    grad.Rotation = rotation or 135
    grad.Parent = parent
    return grad
end

