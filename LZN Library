            if hotbarSlots[s] ~= nil then
                hasAny = true
                break
            end
        end
        if not hasAny and #backpackItems > 0 then
            hasAny = true
        end

        HotbarFrame.Visible = hasAny
        EquippedActionBar.Visible = (equippedSlotIdx ~= nil and hotbarSlots[equippedSlotIdx] ~= nil)

        for s = 1, 10 do
            local entry = slotButtons[s]
            local itemName = hotbarSlots[s]
            local isEq = (equippedSlotIdx == s and itemName ~= nil)

            entry.stroke.Color = isEq and secondaryColor or accentColor
            entry.stroke.Thickness = isEq and 2 or 1.15
            entry.btn.BackgroundTransparency = isEq and 0.08 or 0.25

            if itemName then
                local realTool = FindActualToolInstance(itemName) or toolTemplates[itemName]
                entry.icon.Image = GetToolIcon(realTool)
                entry.icon.Visible = true
                entry.nameLbl.Text = itemName
                local cnt = lastKnownToolCounts[itemName] or 1
                entry.countLbl.Text = cnt > 1 and ("x" .. tostring(cnt)) or ""
            else
                entry.icon.Visible = false
                entry.nameLbl.Text = ""
                entry.countLbl.Text = ""
            end
        end

        if backpackOpen then
            for _, child in ipairs(BackpackScroll:GetChildren()) do
                if child:IsA("TextButton") then
                    child:Destroy()
                end
            end

            local q = string.lower(searchQuery)
            local visibleCount = 0

            for idx, item in ipairs(backpackItems) do
                if q == "" or string.find(string.lower(item.Name), q, 1, true) then
                    visibleCount = visibleCount + 1
                    local itemCard = Instance.new("TextButton")
                    itemCard.Size = UDim2.new(0, 100, 0, 62)
                    itemCard.LayoutOrder = idx
                    itemCard.BackgroundColor3 = surfaceColor
                    itemCard.BackgroundTransparency = 0.22
                    itemCard.Text = ""
                    itemCard.ZIndex = 14
                    itemCard.Parent = BackpackScroll
                    Instance.new("UICorner", itemCard).CornerRadius = UDim.new(0, 9)
                    RegisterStroke(AddGlow(itemCard, accentColor, 1, 0.45), true)
                    AddClickEffect(itemCard, animSpeed, windowTracker)

                    local realTool = FindActualToolInstance(item.Name) or toolTemplates[item.Name]
                    local ic = Instance.new("ImageLabel")
                    ic.Size = UDim2.new(0, 28, 0, 28)
                    ic.Position = UDim2.new(0.5, -14, 0, 5)
                    ic.BackgroundTransparency = 1
                    ic.Image = GetToolIcon(realTool)
                    ic.ZIndex = 15
                    ic.Parent = itemCard
                    Instance.new("UICorner", ic).CornerRadius = UDim.new(0, 6)

                    local nLbl = Instance.new("TextLabel")
                    nLbl.Size = UDim2.new(1, -8, 0, 22)
                    nLbl.Position = UDim2.new(0, 4, 1, -24)
                    nLbl.BackgroundTransparency = 1
                    nLbl.Text = item.Name .. (item.Count > 1 and (" (x" .. tostring(item.Count) .. ")") or "")
                    nLbl.TextColor3 = textColor
                    nLbl.Font = activeFont
                    nLbl.TextSize = 9
                    nLbl.TextWrapped = true
                    nLbl.ZIndex = 15
                    nLbl.Parent = itemCard

                    windowTracker:Add(itemCard.MouseButton1Click:Connect(function()
                        PlaySFX(ClickSFX, 1.05)
                        local alreadyInSlot = nil
                        for s = 1, 10 do
                            if hotbarSlots[s] == item.Name then
                                alreadyInSlot = s
                                break
                            end
                        end
                        if alreadyInSlot then
                            EquipSlot(alreadyInSlot)
                        else
                            local emptySlot = nil
                            for s = 1, 10 do
                                if hotbarSlots[s] == nil then
                                    emptySlot = s
                                    break
                                end
                            end
                            local targetSlot = emptySlot or 1
                            hotbarSlots[targetSlot] = item.Name
                            EquipSlot(targetSlot)
                        end
                        backpackOpen = false
                        BackpackPanel.Visible = false
                        SyncInventoryState()
                        RefreshInventoryUI()
                    end))
                end
            end

            local rows = math.ceil(visibleCount / 5)
            BackpackScroll.CanvasSize = UDim2.new(0, 0, 0, math.max(0, rows * 70))
        end
    end

    for s = 1, 10 do
        local slotBtn = Instance.new("TextButton")
        slotBtn.Name = "Slot_" .. tostring(s)
        slotBtn.Size = UDim2.new(0, 56, 0, 62)
        slotBtn.Position = UDim2.new(0, (s - 1) * 62, 0, 3)
        slotBtn.BackgroundColor3 = Color3.fromRGB(11, 15, 24)
        slotBtn.BackgroundTransparency = 0.25
        slotBtn.Text = ""
        slotBtn.ZIndex = 7
        slotBtn.Parent = HotbarFrame
        Instance.new("UICorner", slotBtn).CornerRadius = UDim.new(0, 10)
        local st = RegisterStroke(AddGlow(slotBtn, accentColor, 1.15, 0.35), true)
        AddClickEffect(slotBtn, animSpeed, windowTracker)

        local numLbl = Instance.new("TextLabel")
        numLbl.Size = UDim2.new(0, 16, 0, 14)
        numLbl.Position = UDim2.new(0, 4, 0, 2)
        numLbl.BackgroundTransparency = 1
        numLbl.Text = tostring(s)
        numLbl.TextColor3 = accentColor
        numLbl.Font = Enum.Font.GothamBlack
        numLbl.TextSize = 9
        numLbl.TextXAlignment = Enum.TextXAlignment.Left
        numLbl.ZIndex = 8
        numLbl.Parent = slotBtn

        local countLbl = Instance.new("TextLabel")
        countLbl.Size = UDim2.new(0, 24, 0, 14)
        countLbl.Position = UDim2.new(1, -28, 0, 2)
        countLbl.BackgroundTransparency = 1
        countLbl.Text = ""
        countLbl.TextColor3 = secondaryColor
        countLbl.Font = Enum.Font.GothamBlack
        countLbl.TextSize = 9
        countLbl.TextXAlignment = Enum.TextXAlignment.Right
        countLbl.ZIndex = 8
        countLbl.Parent = slotBtn

        local iconImg = Instance.new("ImageLabel")
        iconImg.Size = UDim2.new(0, 28, 0, 28)
        iconImg.Position = UDim2.new(0.5, -14, 0, 15)
        iconImg.BackgroundTransparency = 1
        iconImg.Image = ""
        iconImg.Visible = false
        iconImg.ZIndex = 8
        iconImg.Parent = slotBtn
        Instance.new("UICorner", iconImg).CornerRadius = UDim.new(0, 6)

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size = UDim2.new(1, -6, 0, 14)
        nameLbl.Position = UDim2.new(0, 3, 1, -15)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = ""
        nameLbl.TextColor3 = textColor
        nameLbl.Font = activeFont
        nameLbl.TextSize = 8
        nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
        nameLbl.ZIndex = 8
        nameLbl.Parent = slotBtn

        slotButtons[s] = {
            btn = slotBtn,
            stroke = st,
            icon = iconImg,
            nameLbl = nameLbl,
            countLbl = countLbl
        }

        windowTracker:Add(slotBtn.MouseButton1Click:Connect(function()
            PlaySFX(ClickSFX, 1.05)
            EquipSlot(s)
            SyncInventoryState()
            RefreshInventoryUI()
        end))
    end

    windowTracker:Add(DropToolBtn.MouseButton1Click:Connect(function()
        PlaySFX(ToggleOffSFX, 0.9)
        DropEquippedTool()
        SyncInventoryState()
        RefreshInventoryUI()
    end))

    windowTracker:Add(UnequipToolBtn.MouseButton1Click:Connect(function()
        PlaySFX(ClickSFX, 1)
        UnequipCurrentTool()
        SyncInventoryState()
        RefreshInventoryUI()
    end))

    windowTracker:Add(BackpackButton.MouseButton1Click:Connect(function()
        backpackOpen = not backpackOpen
        PlaySFX(DropdownSFX, backpackOpen and 1.12 or 0.92)
        BackpackPanel.Visible = backpackOpen
        SyncInventoryState()
        RefreshInventoryUI()
    end))

    windowTracker:Add(SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
        searchQuery = SearchBox.Text or ""
        RefreshInventoryUI()
    end))

    local numberKeys = {
        Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five,
        Enum.KeyCode.Six, Enum.KeyCode.Seven, Enum.KeyCode.Eight, Enum.KeyCode.Nine, Enum.KeyCode.Zero
    }
    windowTracker:Add(UserInputService.InputBegan:Connect(function(input, gp)
        if gp or not customInventoryEnabled then return end
        for idx, kc in ipairs(numberKeys) do
            if input.KeyCode == kc then
                PlaySFX(ClickSFX, 1.05)
                EquipSlot(idx)
                SyncInventoryState()
                RefreshInventoryUI()
                break
            end
        end
    end))

    local function HookBackpackContainer(container)
        if not container then return end
        windowTracker:Add(container.ChildAdded:Connect(function()
            SyncInventoryState()
            RefreshInventoryUI()
        end))
        windowTracker:Add(container.ChildRemoved:Connect(function()
            SyncInventoryState()
            RefreshInventoryUI()
        end))
    end

    task.spawn(function()
        local bp = Player:FindFirstChild("Backpack") or Player:WaitForChild("Backpack", 5)
        HookBackpackContainer(bp)
        SyncInventoryState()
        RefreshInventoryUI()
    end)

    windowTracker:Add(Player.CharacterAdded:Connect(function(newChar)
        equippedSlotIdx = nil
        HookBackpackContainer(newChar)
        task.spawn(function()
            local bp = Player:FindFirstChild("Backpack") or Player:WaitForChild("Backpack", 5)
            HookBackpackContainer(bp)
            SyncInventoryState()
            RefreshInventoryUI()
        end)
    end))

    if Player.Character then
        HookBackpackContainer(Player.Character)
    end

    windowTracker:Add(RunService.RenderStepped:Connect(function()
        local char = Player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")

        if godModeActive and char and hrp then
            if hrp.Position.Y <= workspace.FallenPartsDestroyHeight + 25 and lastSavedPos then
                pcall(function()
                    hrp.CFrame = CFrame.new(lastSavedPos + Vector3.new(0, 4, 0))
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end)
            elseif hrp.Position.Y > workspace.FallenPartsDestroyHeight + 35 then
                lastSavedPos = hrp.Position
            end
        end

        if platformActive and platformPart and hrp then
            if platformFixedY == nil then
                platformFixedY = hrp.Position.Y - 3.6
            end
            platformPart.Position = Vector3.new(hrp.Position.X, platformFixedY, hrp.Position.Z)
        end

        if customInventoryEnabled and char then
            local equippedToolInChar = nil
            for _, ch in ipairs(char:GetChildren()) do
                if ch:IsA("Tool") then
                    equippedToolInChar = ch
                    break
                end
            end
            if equippedToolInChar then
                for s = 1, 10 do
                    if hotbarSlots[s] == equippedToolInChar.Name then
                        equippedSlotIdx = s
                        break
                    end
                end
            else
                equippedSlotIdx = nil
            end
            EquippedActionBar.Visible = (equippedSlotIdx ~= nil and hotbarSlots[equippedSlotIdx] ~= nil)
        end
    end))

    UpdateHubHeight()
    return Window
end

return LZNLib
