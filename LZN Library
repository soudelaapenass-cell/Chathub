                box.Text = tostring(num)
            else
                box.Text = tostring(AudioSound.PlaybackSpeed)
            end
        end)

        makeMiniBox(0.515, "volume", "Volume (1 a 10)", "1", function(txt, box)
            local num = tonumber(txt)
            if num then
                num = math.clamp(num, 0, 10)
                box.Text = tostring(num)
                if num <= 1 then
                    AudioSound.Volume = num
                    Distortion.Enabled = false
                    Distortion.Level = 0
                elseif num <= 5 then
                    AudioSound.Volume = 1 + ((num - 1) * 1.5)
                    Distortion.Enabled = true
                    Distortion.Level = (num - 1) * 0.14
                else
                    AudioSound.Volume = 7 + ((num - 5) * 0.6)
                    Distortion.Enabled = true
                    Distortion.Level = math.clamp(0.56 + ((num - 5) * 0.085), 0, 0.98)
                end
            else
