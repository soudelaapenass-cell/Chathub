    local function UpdateTabNavigation(selectedButton)
        local contentWidth = NavLayout.AbsoluteContentSize.X + 8
        PageNav.CanvasSize = UDim2.new(0, contentWidth, 0, 0)
        if selectedButton then
            task.defer(function()
                if not selectedButton.Parent then return end
                local left = selectedButton.AbsolutePosition.X - PageNav.AbsolutePosition.X + PageNav.CanvasPosition.X
                local right = left + selectedButton.AbsoluteSize.X
                local viewLeft = PageNav.CanvasPosition.X
                local viewRight = viewLeft + PageNav.AbsoluteSize.X
                local target = viewLeft
                if left < viewLeft then target = left - 8
                elseif right > viewRight then target = right - PageNav.AbsoluteSize.X + 8 end
                local maxCanvas = math.max(contentWidth - PageNav.AbsoluteSize.X, 0)
                target = math.clamp(target, 0, maxCanvas)
                TweenService:Create(PageNav, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {CanvasPosition = Vector2.new(target, 0)}):Play()
            end)
        end
