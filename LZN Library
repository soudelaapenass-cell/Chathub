            if pickerFollowConnection then pickerFollowConnection:Disconnect() end
            pickerFollowConnection = RunService.RenderStepped:Connect(function()
                if popupOpen and picker.Parent then placePopup() end
            end)
            PlaySFX(DropdownSFX, 1)
        end
        local function closePicker()
            hue, saturation, value = committedColor:ToHSV()
            updateDraft()
            animatePopup(false)
            if pickerFollowConnection then
                pickerFollowConnection:Disconnect()
                pickerFollowConnection = nil
            end
        end
        table.insert(ColorPickerCloseHandlers, closePicker)
        local draggingSV = false
        local draggingHue = false
        local activePickerInput = nil
        local activePickerType = nil
        local function updateSV(pos)
            saturation = math.clamp((pos.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
            value = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
            updateDraft()
        end
        local function updateHue(pos)
            hue = math.clamp((pos.Y - hueBar.AbsolutePosition.Y) / math.max(hueBar.AbsoluteSize.Y, 1), 0, 1)
            updateDraft()
        end
        sv.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingSV = true
                activePickerInput = input
                activePickerType = input.UserInputType
                updateSV(input.Position)
            end
        end)
        hueBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingHue = true
                activePickerInput = input
                activePickerType = input.UserInputType
                updateHue(input.Position)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if not activePickerInput then return end
            local move = activePickerType == Enum.UserInputType.Touch and input == activePickerInput
                or activePickerType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement
            if move then
                if draggingSV then updateSV(input.Position) end
                if draggingHue then updateHue(input.Position) end
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if activePickerInput and (input == activePickerInput or (activePickerType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)) then
                draggingSV = false
                draggingHue = false
                activePickerInput = nil
                activePickerType = nil
            end
        end)
        swatch.MouseButton1Click:Connect(function()
            PlaySFX(SFX.ColorPicker, 1)
            if popupOpen then closePicker() else openPicker() end
        end)
        closeBtn.MouseButton1Click:Connect(closePicker)
        resetBtn.MouseButton1Click:Connect(function()
            hue, saturation, value = defaultColor:ToHSV()
            updateDraft()
        end)
        okBtn.MouseButton1Click:Connect(function()
            committedColor = draftColor
            swatch.BackgroundColor3 = committedColor
            SafeCallback(cfg.Callback, committedColor, committedColor:ToHSV())
            Window.NotifyAction(cfg.Text or "ColorPicker", "Cor aplicada: " .. string.format("#%02X%02X%02X", math.floor(committedColor.R * 255 + 0.5), math.floor(committedColor.G * 255 + 0.5), math.floor(committedColor.B * 255 + 0.5)), "success")
            closePicker()
        end)
        row.Destroying:Connect(function()
            if picker and picker.Parent then picker:Destroy() end
        end)
        updateDraft()
        local handle = MakeComponentHandle(row, function() return committedColor end, function(v)
            if typeof(v) == "Color3" then
                committedColor = v
                draftColor = v
                hue, saturation, value = v:ToHSV()
                swatch.BackgroundColor3 = committedColor
                updateDraft()
                SafeCallback(cfg.Callback, committedColor, committedColor:ToHSV())
            end
        end)
        local oldDestroy = handle.Destroy
        function handle:Destroy()
            draggingSV = false
            draggingHue = false
            activePickerInput = nil
            if picker and picker.Parent then picker:Destroy() end
            if oldDestroy then oldDestroy(self) end
        end
        function handle:SetVisible(v) row.Visible = v == true end
        return handle
    end

