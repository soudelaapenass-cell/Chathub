local function SafeCall(fn, ...)
    if type(fn) ~= "function" then return nil end
    local results = {pcall(fn, ...)}
    if results[1] then
        table.remove(results, 1)
        return table.unpack(results)
    end
    return nil
end

local function CreateConnectionTracker()
    local list = {}
    local tracker = {}
    function tracker:Add(conn)
        if conn and typeof(conn) == "RBXScriptConnection" then
            table.insert(list, conn)
        end
        return conn
    end
    function tracker:Clear()
        for i = #list, 1, -1 do
            local c = list[i]
            if c then
                pcall(function()
                    if c.Connected then
                        c:Disconnect()
                    end
                end)
            end
            list[i] = nil
        end
    end
    return tracker
end

local function MakeDraggable(gui, tracker)
    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil
    local inputChangedConnection = nil

    local function addConn(c)
        if tracker then tracker:Add(c) end
        return c
    end

    addConn(gui.InputBegan:Connect(function(input)
        if dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        dragging = true
        dragStart = input.Position
        startPos = gui.Position
        dragInput = input

        if inputChangedConnection then
            inputChangedConnection:Disconnect()
            inputChangedConnection = nil
        end

        inputChangedConnection = addConn(UserInputService.InputChanged:Connect(function(changedInput)
            if not dragging or not dragInput or not dragStart or not startPos then return end

            local isMouseMove = dragInput.UserInputType == Enum.UserInputType.MouseButton1
                and changedInput.UserInputType == Enum.UserInputType.MouseMovement
            local isSameTouch = dragInput.UserInputType == Enum.UserInputType.Touch
                and changedInput == dragInput

            if isMouseMove or isSameTouch then
                local delta = changedInput.Position - dragStart
                gui.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end))

        local endedConnection
        endedConnection = addConn(UserInputService.InputEnded:Connect(function(endedInput)
            local isSameMouse = dragInput and dragInput.UserInputType == Enum.UserInputType.MouseButton1
                and endedInput.UserInputType == Enum.UserInputType.MouseButton1
            local isSameTouch = dragInput and dragInput.UserInputType == Enum.UserInputType.Touch
                and endedInput == dragInput

            if isSameMouse or isSameTouch then
                dragging = false
                dragInput = nil
                dragStart = nil
                startPos = nil
                if inputChangedConnection then
                    inputChangedConnection:Disconnect()
                    inputChangedConnection = nil
                end
                if endedConnection then
                    endedConnection:Disconnect()
                    endedConnection = nil
                end
            end
        end))
    end))
end

local function AddClickEffect(btn, animSpeed, tracker)
    local speed = animSpeed or 0.16
    local clickScale = Instance.new("UIScale")
    clickScale.Scale = 1
    clickScale.Parent = btn

    local function reg(c)
        if tracker then tracker:Add(c) end
        return c
    end

    reg(btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(clickScale, TweenInfo.new(speed * 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Scale = 0.93
            }):Play()
        end
    end))
    reg(btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(clickScale, TweenInfo.new(speed, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Scale = 1
            }):Play()
        end
    end))
    return clickScale
end

