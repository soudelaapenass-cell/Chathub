    local memoryStore = {}

    function Window:SaveConfig(configName)
        local key = tostring(configName or hubName .. "_default")
        local payload = {
            Theme = {
                Accent = SerializeColor(accentColor),
                Secondary = SerializeColor(secondaryColor),
                Background = SerializeColor(bgColor),
                Surface = SerializeColor(surfaceColor),
                Header = SerializeColor(headerColor),
                Text = SerializeColor(textColor),
                MutedText = SerializeColor(mutedTextColor),
                CornerRadius = cornerRadiusPx,
                AnimSpeed = animSpeed,
                BackgroundTransparency = bgTransparency,
                ElementTransparency = elementTransparency,
                CustomInventory = customInventoryEnabled,
                SoundEffects = sfxEnabled,
                Compact = compactMode
            },
            Components = {}
        }

        for _, entry in ipairs(ComponentRegistry) do
            if entry.StateKey and entry.GetValue then
                local okVal, val = pcall(entry.GetValue)
                if okVal then
                    if typeof(val) == "Color3" then
                        payload.Components[entry.StateKey] = {__type = "Color3", value = SerializeColor(val)}
                    elseif typeof(val) == "EnumItem" then
                        payload.Components[entry.StateKey] = {__type = "EnumItem", value = tostring(val)}
                    else
                        payload.Components[entry.StateKey] = val
                    end
                end
            end
        end

        local encoded = HttpService:JSONEncode(payload)
        memoryStore[key] = encoded
        if type(writefile) == "function" then
            pcall(function()
                writefile(key .. ".json", encoded)
            end)
        end
        return encoded
    end

    function Window:LoadConfig(configName)
        local key = tostring(configName or hubName .. "_default")
        local raw = memoryStore[key]
        if not raw and type(isfile) == "function" and type(readfile) == "function" then
            pcall(function()
                if isfile(key .. ".json") then
                    raw = readfile(key .. ".json")
                end
            end)
        end
        if type(raw) ~= "string" or #raw == 0 then
            return false
        end

        local okDecode, decoded = pcall(function()
            return HttpService:JSONDecode(raw)
        end)
        if not okDecode or type(decoded) ~= "table" then
            return false
        end

        if type(decoded.Theme) == "table" then
            local th = decoded.Theme
            ApplyThemeValues({
                Accent = DeserializeColor(th.Accent, accentColor),
                Secondary = DeserializeColor(th.Secondary, secondaryColor),
                Background = DeserializeColor(th.Background, bgColor),
                Surface = DeserializeColor(th.Surface, surfaceColor),
                Header = DeserializeColor(th.Header, headerColor),
                Text = DeserializeColor(th.Text, textColor),
                MutedText = DeserializeColor(th.MutedText, mutedTextColor),
                CornerRadius = th.CornerRadius or cornerRadiusPx,
                AnimSpeed = th.AnimSpeed or animSpeed,
                BackgroundTransparency = th.BackgroundTransparency or bgTransparency,
                ElementTransparency = th.ElementTransparency or elementTransparency
            })
            if th.CustomInventory ~= nil then
                SetCustomInventoryEnabled(th.CustomInventory == true)
            end
            if th.SoundEffects ~= nil then
                sfxEnabled = th.SoundEffects == true
            end
        end

        if type(decoded.Components) == "table" then
            for _, entry in ipairs(ComponentRegistry) do
                if entry.StateKey and decoded.Components[entry.StateKey] ~= nil and entry.SetValue then
                    local savedVal = decoded.Components[entry.StateKey]
                    if type(savedVal) == "table" and savedVal.__type == "Color3" then
                        SafeCall(entry.SetValue, DeserializeColor(savedVal.value, accentColor), true)
                    elseif type(savedVal) == "table" and savedVal.__type == "EnumItem" then
                        local parts = string.split(tostring(savedVal.value), ".")
                        local kName = parts[#parts]
                        if Enum.KeyCode[kName] then
                            SafeCall(entry.SetValue, Enum.KeyCode[kName], true)
                        end
                    else
                        SafeCall(entry.SetValue, savedVal, true)
                    end
                end
            end
        end

        return true
    end

