    local function SyncPlayerToolsToInventory()
        local countsNow = {}
        local texByName = {}

        local bp = Player:FindFirstChildOfClass("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") then
                    SaveToolTemplate(t)
                    countsNow[t.Name] = (countsNow[t.Name] or 0) + 1
                    if t.TextureId and t.TextureId ~= "" then texByName[t.Name] = t.TextureId end
                end
            end
        end
        if Player.Character then
            for _, t in ipairs(Player.Character:GetChildren()) do
                if t:IsA("Tool") then
                    SaveToolTemplate(t)
                    countsNow[t.Name] = (countsNow[t.Name] or 0) + 1
                    if t.TextureId and t.TextureId ~= "" then texByName[t.Name] = t.TextureId end
                end
            end
        end

        for name, cnt in pairs(countsNow) do
            local prev = lastKnownToolCounts[name] or 0
            local sup = suppressedToolNames[name] or 0
            if cnt > prev then
                local added = cnt - prev
                if sup > 0 then
                    local skip = math.min(sup, added)
                    suppressedToolNames[name] = sup - skip
                    added = added - skip
                end
                if added > 0 then
                    local alreadyInHotbar = false
                    for s = 1, 10 do
                        if hotbarSlots[s] == name then
                            alreadyInHotbar = true
                            break
                        end
                    end
                    if not alreadyInHotbar then
                        for s = 1, 10 do
                            if not hotbarSlots[s] then
                                hotbarSlots[s] = name
                                break
                            end
                        end
                    end
                end
            end
        end

        for s = 1, 10 do
            local hName = hotbarSlots[s]
            if hName then
                local inWorldOrBp = (countsNow[hName] or 0) > 0
                local inBackpackQueue = false
                for _, bE in ipairs(backpackItems) do
                    if bE.Name == hName and bE.Count > 0 then
                        inBackpackQueue = true
                        break
                    end
                end
                if not inWorldOrBp and not inBackpackQueue then
                    hotbarSlots[s] = nil
                    if equippedSlotIdx == s then
                        equippedSlotIdx = nil
                        EquippedActionBar.Visible = false
                    end
                end
            end
        end

        lastKnownToolCounts = countsNow
        RebuildHotbarAndBackpack()
    end

