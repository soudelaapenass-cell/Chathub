            highlight.BorderSizePixel = 0
            highlight.Parent = rowFrame
            Instance.new("UICorner", highlight).CornerRadius = UDim.new(1, 0)

            local ic = CreateCustomIcon(rowFrame, cfg.Icon or "success", state and secondaryColor or mutedTextColor, 13)
            ic.Position = UDim2.new(0, 14, 0.5, -6)

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -88, 1, 0)
            lbl.Position = UDim2.new(0, 32, 0, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = baseText
            lbl.TextColor3 = state and textColor or mutedTextColor
            lbl.Font = activeFont
            lbl.TextSize = 12
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.TextTruncate = Enum.TextTruncate.AtEnd
            lbl.Parent = rowFrame

            local pill = Instance.new("Frame")
            pill.Size = UDim2.new(0, 42, 0, 22)
            pill.Position = UDim2.new(1, -52, 0.5, -11)
            pill.BackgroundColor3 = state and secondaryColor or Color3.fromRGB(28, 36, 52)
            pill.Parent = rowFrame
            Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)

            local dot = Instance.new("Frame")
            dot.Size = UDim2.new(0, 16, 0, 16)
            dot.Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
            dot.BackgroundColor3 = Color3.new(1, 1, 1)
            dot.Parent = pill
            Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

            local function applyState(newState, fire)
                local prev = state
                state = newState == true
                TweenService:Create(pill, TweenInfo.new(animSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    BackgroundColor3 = state and secondaryColor or Color3.fromRGB(28, 36, 52)
                }):Play()
                TweenService:Create(dot, TweenInfo.new(animSpeed, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
                }):Play()
                TweenService:Create(rowFrame, TweenInfo.new(animSpeed), {
                    BackgroundTransparency = state and 0.18 or math.clamp(elementTransparency + 0.2, 0, 0.95)
                }):Play()
                TweenService:Create(highlight, TweenInfo.new(animSpeed), {
                    BackgroundTransparency = state and 0 or 1
                }):Play()
                lbl.TextColor3 = state and textColor or mutedTextColor
                stroke.Color = state and secondaryColor or accentColor
                local col = state and secondaryColor or mutedTextColor
                for _, ch in ipairs(ic:GetChildren()) do
                    if ch:IsA("Frame") then ch.BackgroundColor3 = col end
                end
                if fire and prev ~= state then
                    PlaySFX(state and ToggleOnSFX or ToggleOffSFX, state and 1.15 or 0.88)
                end
                if fire ~= false then
                    SafeCall(cfg.Callback, state)
                end
            end

            tTracker:Add(pill.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    applyState(not state, true)
                end
            end))

            local api = {_frame = rowFrame}
            function api:SetValue(v, fire) applyState(v == true, fire ~= false) end
            function api:GetValue() return state end
            function api:SetText(newTxt)
                baseText = tostring(newTxt or "")
                lbl.Text = baseText
            end
            function api:GetText() return baseText end
            local attached = AttachStandardComponentAPI(api, cfg)
            local prevDestroy = attached.Destroy
            function attached:Destroy()
                tTracker:Clear()
                prevDestroy(attached)
            end
            return attached
        end

        function sec:AddSlider(cfg)
            cfg = cfg or {}
            local minV = cfg.Min or 0
            local maxV = cfg.Max or 100
            local decimals = cfg.Decimals or 0
            local currentV = math.clamp(cfg.Default or minV, minV, maxV)
            local sTracker = CreateConnectionTracker()
            local dragging = false

            local function fmt(v)
                if decimals > 0 then
                    return string.format("%." .. tostring(decimals) .. "f", v)
                end
                return tostring(math.floor(v + 0.5))
            end

            local sliderCard = Instance.new("Frame")
            sliderCard.Size = UDim2.new(1, 0, 0, cfg.Height or 48)
            sliderCard.BackgroundColor3 = surfaceColor
            sliderCard.BackgroundTransparency = cfg.Transparency or elementTransparency
            sliderCard.LayoutOrder = NextOrder()
            sliderCard.ZIndex = 24
            sliderCard.Parent = parentScroll
            Instance.new("UICorner", sliderCard).CornerRadius = UDim.new(0, cornerRadiusPx)
            RegisterStroke(AddGlow(sliderCard, accentColor, borderThickness, borderTransparency), true)
            RegisterSurface(sliderCard)

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(0.65, -20, 0, 16)
            nameLbl.Position = UDim2.new(0, 10, 0, 5)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = cfg.Text or "Slider"
            nameLbl.TextColor3 = textColor
            nameLbl.Font = activeFont
            nameLbl.TextSize = 10
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.Parent = sliderCard

            local valLbl = Instance.new("TextLabel")
            valLbl.Size = UDim2.new(0.35, -10, 0, 16)
            valLbl.Position = UDim2.new(0.65, 0, 0, 5)
            valLbl.BackgroundTransparency = 1
            valLbl.Text = fmt(currentV)
            valLbl.TextColor3 = accentColor
            valLbl.Font = Enum.Font.GothamBlack
            valLbl.TextSize = 10
            valLbl.TextXAlignment = Enum.TextXAlignment.Right
            valLbl.Parent = sliderCard
            RegisterAccent(valLbl, "TextColor3")

            local hit = Instance.new("TextButton")
            hit.Size = UDim2.new(1, -20, 0, 20)
            hit.Position = UDim2.new(0, 10, 0, 23)
            hit.BackgroundTransparency = 1
            hit.Text = ""
            hit.Parent = sliderCard

            local track = Instance.new("Frame")
            track.Size = UDim2.new(1, 0, 0, 5)
            track.Position = UDim2.new(0, 0, 0.5, -2)
            track.BackgroundColor3 = Color3.fromRGB(22, 30, 46)
            track.BorderSizePixel = 0
            track.Parent = hit
            Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

            local fill = Instance.new("Frame")
            fill.Size = UDim2.new(0, 0, 1, 0)
            fill.BackgroundColor3 = accentColor
            fill.BorderSizePixel = 0
            fill.Parent = track
            Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
            RegisterAccent(fill, "BackgroundColor3")

            local thumb = Instance.new("Frame")
            thumb.Size = UDim2.new(0, 12, 0, 12)
            thumb.Position = UDim2.new(0, -6, 0.5, -6)
            thumb.BackgroundColor3 = Color3.new(1, 1, 1)
            thumb.BorderSizePixel = 0
            thumb.Parent = track
            Instance.new("UICorner", thumb).CornerRadius = UDim.new(1, 0)

            local function applyValue(v, fireCb)
                currentV = math.clamp(tonumber(v) or minV, minV, maxV)
                if decimals == 0 then
                    currentV = math.floor(currentV + 0.5)
                else
                    local mult = 10 ^ decimals
                    currentV = math.floor(currentV * mult + 0.5) / mult
                end
                local ratio = math.clamp((currentV - minV) / math.max(maxV - minV, 0.0001), 0, 1)
                fill.Size = UDim2.new(ratio, 0, 1, 0)
                thumb.Position = UDim2.new(ratio, -6, 0.5, -6)
                valLbl.Text = fmt(currentV)
                if fireCb ~= false then
                    SafeCall(cfg.Callback, currentV)
                end
            end

            local function updateFromX(posX)
                local rel = math.clamp((posX - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
                applyValue(minV + (rel * (maxV - minV)), true)
            end

            sTracker:Add(hit.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateFromX(input.Position.X)
                end
            end))
            sTracker:Add(UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateFromX(input.Position.X)
                end
            end))
            sTracker:Add(UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end))

