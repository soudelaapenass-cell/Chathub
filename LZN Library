    local configsTab = Window:CreateTab("configs", "settings")
    local function runLezinSource(source, label)
        if type(loadstring) ~= "function" then
            Window:Notify({Title = "Executor incompatível", Message = "loadstring não está disponível para " .. tostring(label), Type = "error"})
            return false
        end
        local fn, compileError = loadstring(source)
        if not fn then
            Window:Notify({Title = "Falha ao carregar", Message = tostring(compileError), Type = "fail"})
            return false
        end
        local ok, runtimeError = pcall(fn)
        if not ok then
            Window:Notify({Title = "Erro ao executar", Message = tostring(runtimeError), Type = "error"})
            return false
        end
        Window:Notify({Title = "Script iniciado", Message = tostring(label), Type = "success"})
        return true
    end

