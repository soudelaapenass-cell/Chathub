olor3.fromRGB(200, 100, 0) or Color3.fromRGB(35, 35, 35) end)\nsavesBtn.MouseButton1Click:Connect(function() savesFrame.Visible = true; refreshSaves() end)\ncloseSaves.MouseButton1Click:Connect(function() savesFrame.Visible = false end)\n\n-- Interação da Barra Timeline\nlocal isDraggingSeek = false\nlocal function updateSeek(input)\n    local pct = math.clamp((input.Position.X - seekBarBg.AbsolutePosition.X) / seekBarBg.AbsoluteSize.X, 0, 1)\n    playbackTime = totalDuration * pct\n    seekKnob.Position = UDim2.new(pct, 0, 0.5, 0); seekFill.Size = UDim2.new(pct, 0, 1, 0)\n    seekTimeLabel.Text = string.format(\"%.1fs / %.1fs\", playbackTime, totalDuration)\n    if not isPlaying and #recordedPath > 0 then camera.CameraType = Enum.CameraType.Scriptable; camera.CFrame = getFrameAtTime(playbackTime) end\nend\nseekBarBg.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then isDraggingSeek = true; updateSeek(i) end end)\nseekBarBg.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then isDraggingSeek = false end end)\nUserInputService.InputChanged:Connect(function(i) if isDraggingSeek and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then updateSeek(i) end end)\n\nmodeBtn.MouseButton1Click:Connect(function() is180Mode = not is180Mode; modeBtn.Text = is180Mode and \"MODO 180°: LIG\" or \"MODO 180°: DESL\" end)\nlockRotBtn.MouseButton1Click:Connect(function() rotationLocked = not rotationLocked; lockRotBtn.Text = rotationLocked and \"TRAVAR ROT: LIG\" or \"TRAVAR ROT: DESL\"; lockRotBtn.BackgroundColor3 = rotationLocked and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(35,35,35) end)\ncolTog.MouseButton1Click:Connect(function() collisionEnabled = not collisionEnabled; colTog.Text = collisionEnabled and \"COLISÃO: LIG\" or \"COLISÃO: DESL\" end)\nslideBtn.MouseButton1Click:Connect(function() slideEnabled = not slideEnabled; slideBtn.Text = slideEnabled and \"DESLIZAR: LIG\" or \"DESLIZAR: DESL\" end)\n\ndpadTog.MouseButton1Click:Connect(function() \n    isDpadMode = not isDpadMode\n    dpadTog.Text = isDpadMode and \"DPAD: LIG\" or \"DPAD: DESL\"\n    dpadFrame.Visible = isDpadMode\n    dpadTog.BackgroundColor3 = isDpadMode and Color3.fromRGB(255, 120, 0) or Color3.fromRGB(150, 80, 0)\n    player.DevTouchMovementMode = Enum.DevTouchMovementMode.UserChoice\nend)\n\nfpsTog.MouseButton1Click:Connect(function() fpsCapEnabled = not fpsCapEnabled; fpsTog.Text = fpsCapEnabled and \"TRAVAR FPS: LIG\" or \"TRAVAR FPS: DESL\" end)\ntpBtn.MouseButton1Click:Connect(function() if player.Character then player.Character:MoveTo(cameraCFrame.Position) Notify(\"Teleporte\", \"Personagem movido para a câmera! kkk\", 2) end end)\nhideBtn.MouseButton1Click:Connect(function() mainFrame.Visible = false end)\n\n-- Sistema de Redimensionamento e Arraste\nlocal isDrag, isResize, activeFrame, dStart, sPos, sSize = false, false, nil, nil, nil, nil\ndragHandle.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then isDrag=true; activeFrame=mainFrame; dStart=i.Position; sPos=mainFrame.Position end end)\nsavesHeader.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then isDrag=true; activeFrame=savesFrame; dStart=i.Position; sPos=savesFrame.Position end end)\nsettingsHeader.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then isDrag=true; activeFrame=settingsFrame; dStart=i.Position; sPos=settingsFrame.Position end end)\n\nresizeHandle.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then isResize=true; dStart=i.Position; sSize=mainFrame.Size end end)\n\nUserInputService.InputChanged:Connect(function(i)\n    if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then\n        if isDrag and activeFrame then \n            local delta = i.Position - dStart; activeFrame.Position = UDim2.new(sPos.X.Scale, sPos.X.Offset + delta.X, sPos.Y.Scale, sPos.Y.Offset + delta.Y)\n        elseif isResize then \n            local delta = i.Position - dStart; mainFrame.Size = UDim2.new(0, math.max(160, sSize.X.Offset + delta.X), 0, math.max(200, sSize.Y.Offset + delta.Y)) \n        end\n    end\nend)\nUserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then isDrag=false; isResize=false; activeFrame=nil end end)\n\nlocal function upDpad()\n    local x, z = (dpadState.Right and 1 or 0) - (dpadState.Left and 1 or 0), (dpadState.Down and 1 or 0) - (dpadState.Up and 1 or 0)\n    dpadMove = Vector3.new(x, 0, z); if dpadMove.Magnitude > 0 then dpadMove = dpadMove.Unit end\nend\nlocal function bindD(b, d)\n    b.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then dpadState[d] = true; upDpad(); b.BackgroundTransparency = 0.1 end end)\n    b.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then dpadState[d] = false; upDpad(); b.BackgroundTransparency = 0.4 end end)\nend\nbindD(btnU, \"Up\"); bindD(btnD, \"Down\"); bindD(btnL, \"Left\"); bindD(btnR, \"Right\")\n\n-- // CORREÇÃO DEFINITIVA DO ANALÓGICO x CÂMERA MOBILE //\nUserInputService.InputBegan:Connect(function(input, gpe)\n    if not isFreecamEnabled then return end\n    if input.UserInputType == Enum.UserInputType.MouseButton2 then\n        isRightMouseDown = true\n        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition\n    end\n    \n    -- Ignora interações do Roblox UI (botão de pular, analógico nativo)\n    if gpe then return end\n\n    -- Se o toque for na metade esquerda da tela (analógico), registra para isolar a câmera\n    if input.UserInputType == Enum.UserInputType.Touch then\n        if input.Position.X < (camera.ViewportSize.X * 0.45) then\n            joystickTouch = input\n        end\n    end\nend)\n\nUserInputService.InputEnded:Connect(function(input)\n    if input.UserInputType == Enum.UserInputType.MouseButton2 then\n        isRightMouseDown = false\n        UserInputService.MouseBehavior = Enum.MouseBehavior.Default\n    end\n    if input == joystickTouch then joystickTouch = nil end\nend)\n\nUserInputService.InputChanged:Connect(function(input, gpe)\n    if not isFreecamEnabled then return end\n    if gpe then return end\n    \n    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then\n        if not isDraggingSeek and not isDraggingFloat and not isDrag and not isResize then\n            -- Se for o toque do analógico esquerdo, NÃO move a câmera\n            if input.UserInputType == Enum.UserInputType.Touch and input == joystickTouch then\n                return\n            end\n            \n            -- Bloqueia toques na área esquerda do analógico\n            if input.UserInputType == Enum.UserInputType.Touch and input.Position.X < (camera.ViewportSize.X * 0.45) then\n                return\n            end\n\n            if input.UserInputType == Enum.UserInputType.Touch or (input.UserInputType == Enum.UserInputType.MouseMovement and isRightMouseDown) then\n                applyRot(Vector2.new(input.Delta.X * currentSens, input.Delta.Y * currentSens))\n            end\n        end\n    end\nend)\n\nNotify(\"LZN FREECAM v3.5 MOD\", \"Hub carregado com Save de imagens + Tamanhos! 🔥\", 4)\n",
        ["Hitbox Expander"] = "-- [[ SERVIÇOS DO MOTOR ]]\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal Players = game:GetService(\"Players\")\nlocal CoreGui = game:GetService(\"CoreGui\")\nlocal TweenService = game:GetService(\"TweenService\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal HttpService = game:GetService(\"HttpService\")\n\nlocal localPlayer = Players.LocalPlayer\nlocal camera = workspace.CurrentCamera or workspace:WaitForChild(\"Camera\", 5)\nlocal GUI_NAME = \"Lezin hitboxEXP\"\nlocal SAVE_FILE_NAME = \"LezinHitboxEXP_Save.json\"\n\n----------------------------------------------------\n-- PASTA SEGURA PARA CHAMS / ESP\n----------------------------------------------------\nlocal ChamsFolder = CoreGui:FindFirstChild(\"LEZIN_CHAMS_FOLDER\")\nif not ChamsFolder then\n    ChamsFolder = Instance.new(\"Folder\")\n    ChamsFolder.Name = \"LEZIN_CHAMS_FOLDER\"\n    ChamsFolder.Parent = CoreGui\nend\n\n----------------------------------------------------\n-- SINGLE-INSTANCE & CLEANUP HANDLER\n----------------------------------------------------\nif getgenv().HitboxAbuse_UI_Destroy then\n    pcall(getgenv().HitboxAbuse_UI_Destroy)\nend\n\nlocal function cleanupOldInstances()\n    local targetCore = pcall(function() return CoreGui.Name end) and CoreGui or localPlayer:WaitForChild(\"PlayerGui\")\n    for _, v in pairs(targetCore:GetChildren()) do\n        if v.Name == GUI_NAME then v:Destroy() end\n    end\n    if ChamsFolder then ChamsFolder:ClearAllChildren() end\n    if getgenv().HitboxAbuse_Heartbeat then\n        getgenv().HitboxAbuse_Heartbeat:Disconnect()\n    end\n    if getgenv().HitboxAbuse_RenderStep then\n        getgenv().HitboxAbuse_RenderStep:Disconnect()\n    end\n    if getgenv().Lezin360SpinConnection then\n        pcall(function() getgenv().Lezin360SpinConnection:Disconnect() end)\n        getgenv().Lezin360SpinConnection = nil\n    end\n    if getgenv().LezinHitboxStatusConnection then\n        pcall(function() getgenv().LezinHitboxStatusConnection:Disconnect() end)\n        getgenv().LezinHitboxStatusConnection = nil\n    end\nend\ncleanupOldInstances()\n\n----------------------------------------------------\n-- COLOR PALETTES & CONFIGURATION MAPS\n----------------------------------------------------\nlocal ColorOptions = {\"Red\", \"Green\", \"Blue\", \"White\", \"Pink\", \"Orange\", \"Yellow\", \"Purple\", \"Cyan\"}\nlocal MaterialOptions = {\"Plastic\", \"ForceField\", \"Neon\", \"Glass\", \"SmoothPlastic\"}\nlocal VisibilityOptions = {\"None\", \"Wall Check\", \"Visible Check\"}\nlocal TargetCategoryOptions = {\"Players\", \"NPCs\", \"Both\"}\n\nlocal ColorValues = {\n    [\"Red\"] = Color3.fromRGB(240, 40, 40),\n    [\"Green\"] = Color3.fromRGB(40, 220, 100),\n    [\"Blue\"] = Color3.fromRGB(0, 140, 255),\n    [\"White\"] = Color3.fromRGB(240, 240, 240),\n    [\"Pink\"] = Color3.fromRGB(255, 30, 90),\n    [\"Orange\"] = Color3.fromRGB(255, 150, 0),\n    [\"Yellow\"] = Color3.fromRGB(255, 220, 0),\n    [\"Purple\"] = Color3.fromRGB(150, 0, 230),\n    [\"Cyan\"] = Color3.fromRGB(0, 255, 255)\n}\n\nlocal settings = {\n    targetCategory = \"Players\",\n    targetSelection = \"All\",\n    targetPlayerName = \"\",\n    hitboxEnabled = false,\n    hitboxTeamCheck = false,\n    visibilityMode = \"None\",\n    deadCheck = false,\n    ffCheck = false,\n    hitboxShape = \"Block\",\n    hitboxMaterial = \"Plastic\",\n    hitboxSize = 12,\n    hitboxOpacity = 0.5,\n    teamColor = \"Green\",\n    enemyColor = \"Red\",\n    originalSizes = {},\n    nearestButtonToggle = false,\n    externalHitboxButton = false,\n    external360Button = false,\n    spinSpeed = 15,\n    statusDisplay = true,\n    \n    espEnabled = false,\n    espTeamCheck = false,\n    espChams = false,\n    espName = false,\n    espIcon = false,\n    espHealth = false,\n    espTracer = false,\n    espSkeleton = false,\n    espBox = false,\n    espDistance = false,\n    realisticView = false,\n    \n    nearestButtonX = 0.12, nearestButtonY = 0.20, nearestButtonOffsetX = 0, nearestButtonOffsetY = 0,\n    externalHitboxButtonX = 0.12, externalHitboxButtonY = 0.29, externalHitboxButtonOffsetX = 0, externalHitboxButtonOffsetY = 0,\n    external360ButtonX = 0.12, external360ButtonY = 0.38, external360ButtonOffsetX = 0, external360ButtonOffsetY = 0\n}\n\n----------------------------------------------------\n-- SISTEMA DE SAVE / LOAD\n----------------------------------------------------\nlocal function SaveSettings()\n    if writefile then\n        local toSave = {}\n        for k, v in pairs(settings) do\n            if type(v) ~= \"table\" then\n                toSave[k] = v\n            end\n        end\n        local success, encoded = pcall(function() return HttpService:JSONEncode(toSave) end)\n        if success then\n            pcall(function() writefile(SAVE_FILE_NAME, encoded) end)\n        end\n    end\nend\n\nlocal function LoadSettings()\n    if isfile and readfile and isfile(SAVE_FILE_NAME) then\n        local success, decoded = pcall(function() return HttpService:JSONDecode(readfile(SAVE_FILE_NAME)) end)\n        if success and type(decoded) == \"table\" then\n            for k, v in pairs(decoded) do\n                if settings[k] ~= nil and type(v) ~= \"table\" then \n                    settings[k] = v\n                end\n            end\n        end\n    end\nend\n\nLoadSettings()\n\n----------------------------------------------------\n-- UTILITIES & RAYCAST ENGINE\n----------------------------------------------------\nlocal function isTeammate(p)\n    if not (localPlayer and p) then return false end\n    if localPlayer.Team and p.Team then return localPlayer.Team == p.Team end\n    return false\nend\n\nlocal function checkWallVisibility(targetPos, sourcePos)\n    if not sourcePos or not targetPos then return true end\n    if (targetPos - sourcePos).Magnitude <= 0 then return true end\n    \n    local rayDirection = (targetPos - sourcePos)\n    local raycastParams = RaycastParams.new()\n    raycastParams.FilterType = Enum.RaycastFilterType.Exclude\n    raycastParams.IgnoreWater = true\n    \n    local ignoreList = {}\n    if localPlayer.Character then table.insert(ignoreList, localPlayer.Character) end\n    for _, p in ipairs(Players:GetPlayers()) do\n        if p.Character then table.insert(ignoreList, p.Character) end\n    end\n    raycastParams.FilterDescendantsInstances = ignoreList\n    \n    local result = Workspace:Raycast(sourcePos, rayDirection, raycastParams)\n    return result == nil\nend\n\nlocal function saveOriginalPartInfo(entityKey, part)\n    if not entityKey or not part then return end\n    if settings.originalSizes[entityKey] and settings.originalSizes[entityKey][part.Name] then return end\n    if not settings.originalSizes[entityKey] then settings.originalSizes[entityKey] = {} end\n    settings.originalSizes[entityKey][part.Name] = {\n        size = part.Size, transparency = part.Transparency,\n        canCollide = part.CanCollide, material = part.Material,\n        shape = part:IsA(\"Part\") and part.Shape or nil\n    }\nend\n\nlocal function restorePartForEntity(entityKey)\n    local entityData = settings.originalSizes[entityKey]\n    if entityData then\n        pcall(function()\n            for partName, original in pairs(entityData) do\n                local part = nil\n                if typeof(entityKey) == \"Instance\" and entityKey:IsA(\"Player\") then\n                    local char = entityKey.Character\n                    part = char and char:FindFirstChild(partName)\n                elseif typeof(entityKey) == \"Instance\" and entityKey:IsA(\"Model\") then\n                    part = entityKey:FindFirstChild(partName)\n                end\n                if part then\n                    part.Size = original.size\n                    part.Transparency = original.transparency or 0\n                    part.CanCollide = (original.