    local function BindJumpPowerPersistence(hum)
        if not hum then return end
        local enforcing = false
        local function enforceJumpPower()
            if enforcing or not hum.Parent then return end
            enforcing = true
            pcall(function()
                hum.UseJumpPower = true
                local targetPower = jumpSlider:GetValue()
                if math.abs(hum.JumpPower - targetPower) > 0.01 then
                    hum.JumpPower = targetPower
                end
            end)
            enforcing = false
        end
        hum:GetPropertyChangedSignal("JumpPower"):Connect(enforceJumpPower)
        hum:GetPropertyChangedSignal("UseJumpPower"):Connect(enforceJumpPower)
        hum.StateChanged:Connect(function(_, newState)
            if newState == Enum.HumanoidStateType.Jumping or newState == Enum.HumanoidStateType.Freefall then
                enforceJumpPower()
            end
        end)
        enforceJumpPower()
    end

    if Player.Character then
        BindJumpPowerPersistence(Player.Character:FindFirstChildOfClass("Humanoid"))
    end

    local function SetCharacterNonCollide(enabled)
        local char = Player.Character
        if not char then return end
        if enabled then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    if savedNoCollide[p] == nil then
                        savedNoCollide[p] = p.CanCollide
                    end
                    p.CanCollide = false
                end
            end
        else
            for p, oldState in pairs(savedNoCollide) do
                if p and p.Parent then
                    p.CanCollide = oldState
                end
            end
            savedNoCollide = {}
        end
    end

    local function SyncPlayerCollisionStates()
        local char = Player.Character
        if not char then return end
        if antiFlingActive then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= Player and plr.Character then
                    for _, otherPart in ipairs(plr.Character:GetDescendants()) do
                        if otherPart:IsA("BasePart") then
                            otherPart.CanCollide = false
                        end
                    end
                end
            end
        else
            SetCharacterNonCollide(false)
        end
    end

    local function HookHazardPart(part)
        if not part:IsA("BasePart") or hookedHazardParts[part] then return end
        hookedHazardParts[part] = true
        part.Touched:Connect(function(hit)
            if not godModeActive then return end
            local char = Player.Character
            if char and hit and hit:IsDescendantOf(char) then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hum then
                    pcall(function()
                        if hum:GetState() == Enum.HumanoidStateType.Dead then
                            hum:ChangeState(Enum.HumanoidStateType.Running)
                        end
                        hum.MaxHealth = math.huge
                        hum.Health = math.huge
                    end)
                end
                if hrp and lastSavedPos and hrp.Position.Y <= workspace.FallenPartsDestroyHeight + 22 then
                    pcall(function()
                        hrp.CFrame = CFrame.new(lastSavedPos + Vector3.new(0, 3.5, 0))
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
            end
        end)
    end

    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("BasePart") then
            HookHazardPart(desc)
        end
    end
    workspace.DescendantAdded:Connect(function(desc)
        if desc:IsA("BasePart") then
            HookHazardPart(desc)
        end
    end)

    local function ClearGodConnections()
        if godHealthConn then
            godHealthConn:Disconnect()
            godHealthConn = nil
        end
        if godDiedConn then
            godDiedConn:Disconnect()
            godDiedConn = nil
        end
    end

    local function EnforceGodOnHumanoid(hum)
        if not hum then return end
        pcall(function()
            if hum.MaxHealth and hum.MaxHealth < 1e6 and hum.MaxHealth > 0 then
                savedMaxHealth = hum.MaxHealth
            end
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
            hum.BreakJointsOnDeath = false
            hum.MaxHealth = math.huge
            hum.Health = math.huge
        end)
    end

    local function BindGodModeToCharacter(char)
        ClearGodConnections()
        if not godModeActive or not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hum then
            EnforceGodOnHumanoid(hum)
            godHealthConn = hum:GetPropertyChangedSignal("Health"):Connect(function()
                if godModeActive and hum and hum.Parent then
                    if hum.Health < math.huge then
                        pcall(function()
                            hum.MaxHealth = math.huge
                            hum.Health = math.huge
                        end)
                    end
                end
            end)
            godDiedConn = hum.Died:Connect(function()
                if godModeActive and hum and hum.Parent then
                    pcall(function()
                        hum:ChangeState(Enum.HumanoidStateType.Running)
                        hum.MaxHealth = math.huge
                        hum.Health = math.huge
                    end)
                end
            end)
        end
        if hrp then
            lastSavedPos = hrp.Position
        end
    end

    local function SetGodModeState(enabled)
        godModeActive = enabled == true
        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if godModeActive then
            BindGodModeToCharacter(char)
        else
            ClearGodConnections()
            lastSavedPos = nil
            if hum then
                pcall(function()
                    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
                    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
                    hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
                    hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, true)
                    hum.BreakJointsOnDeath = true
                    local restoreMax = (savedMaxHealth and savedMaxHealth > 0 and savedMaxHealth < 1e6) and savedMaxHealth or 100
                    hum.MaxHealth = restoreMax
                    hum.Health = math.min(hum.Health > 0 and hum.Health or restoreMax, restoreMax)
                end)
            end
        end
    end

    if Player.Character and godModeActive then
        SetGodModeState(true)
    end

