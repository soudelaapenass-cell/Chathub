    local function AttachStandardComponentAPI(apiObj, cfgTable)
        local compTracker = CreateConnectionTracker()
        apiObj._tracker = compTracker

        function apiObj:Get()
            if apiObj.GetValue then return apiObj:GetValue() end
            return nil
        end

        function apiObj:Set(v, ...)
            if apiObj.SetValue then
                return apiObj:SetValue(v, ...)
            elseif apiObj.SetText then
                return apiObj:SetText(v)
            end
        end

        function apiObj:SetVisible(vis)
            local v = vis == true
            if apiObj._frame and apiObj._frame.Parent then
                apiObj._frame.Visible = v
            end
            if cfgTable and cfgTable.StateKey then
                StateRegistry[cfgTable.StateKey] = StateRegistry[cfgTable.StateKey] or {}
                StateRegistry[cfgTable.StateKey].Visible = v
            end
        end

        function apiObj:IsVisible()
            return apiObj._frame and apiObj._frame.Visible or false
        end

        function apiObj:Destroy()
            compTracker:Clear()
            if apiObj._keybindId then
                UnregisterKeybindEntry(apiObj._keybindId)
            end
            for i = #ComponentRegistry, 1, -1 do
                if ComponentRegistry[i] == apiObj._regEntry then
                    table.remove(ComponentRegistry, i)
                    break
                end
            end
            if apiObj._frame and apiObj._frame.Parent then
                pcall(function() apiObj._frame:Destroy() end)
            end
        end

        local regEntry = {
            Frame = apiObj._frame,
            SearchText = cfgTable and (cfgTable.Text or cfgTable.Title or cfgTable.Name or cfgTable.Placeholder) or "",
            GetValue = apiObj.GetValue,
            SetValue = apiObj.SetValue,
            StateKey = cfgTable and cfgTable.StateKey or nil,
            SetTransparency = function(t)
                if apiObj._frame and apiObj._frame.Parent then
                    pcall(function()
                        apiObj._frame.BackgroundTransparency = t
                    end)
                end
            end
        }
        apiObj._regEntry = regEntry
        RegisterComponentEntry(regEntry)

        if cfgTable and cfgTable.Tooltip then
            BindTooltip(apiObj._frame, cfgTable.Tooltip)
        end

        if cfgTable and cfgTable.StateKey then
            StateRegistry[cfgTable.StateKey] = apiObj
        end

        return apiObj
    end

