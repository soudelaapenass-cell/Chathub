    local function SetCharacterNonCollide(enabled)
        local char = Player.Character
        if not char then return end
        if enabled then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    if savedNoCollide[p] == nil then
                        savedNoCollide[p] = p.CanCollide
                    end
                    p.CanCollide = false
                end
            end
        else
            for p, oldState in pairs(savedNoCollide) do
                if p and p.Parent then
                    p.CanCollide = oldState
                end
            end
            savedNoCollide = {}
        end
    end

    local function SyncPlayerCollisionStates()
        local char = Player.Character
        if not char then return end
        if antiFlingActive then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= Player and plr.Character then
                    for _, otherPart in ipairs(plr.Character:GetDescendants()) do
                        if otherPart:IsA("BasePart") then
