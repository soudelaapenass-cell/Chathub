    local toggleOnSoundId = options.ToggleOnSound or "rbxassetid://6895079853"
    local toggleOffSoundId = options.ToggleOffSound or "rbxassetid://6895079853"
    local dropdownSoundId = options.DropdownSound or "rbxassetid://6895079853"
    local clickSoundId = options.ClickSound or "rbxassetid://6895079853"
    local sfxEnabled = options.SoundEffects ~= false

    local guiParent = GetSafeGuiParent()
    local windowTracker = CreateConnectionTracker()
    local trackedStrokes = {}
    local trackedCorners = {}
    local trackedAccents = {}
    local trackedSurfaces = {}
    local trackedTexts = {}

    local function RegisterStroke(st, isAccent)
        table.insert(trackedStrokes, {stroke = st, isAccent = isAccent == true})
        return st
    end

    local function RegisterCorner(cr, scaleOverride)
        table.insert(trackedCorners, {corner = cr, scale = scaleOverride})
        return cr
    end

    local function RegisterAccent(inst, prop)
        table.insert(trackedAccents, {inst = inst, prop = prop or "BackgroundColor3"})
        return inst
    end

    local function RegisterSurface(inst)
        table.insert(trackedSurfaces, inst)
        return inst
    end

    local function RegisterText(inst, isMuted)
        table.insert(trackedTexts, {inst = inst, isMuted = isMuted == true})
        return inst
    end

    if customInventoryEnabled then
        pcall(function()
            StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
        end)
    end

    for _, container in ipairs({CoreGui, guiParent}) do
        if container then
            for _, suffix in ipairs({"", "_TopBlurGui", "_CustomInventory"}) do
                local oldGui = container:FindFirstChild(hubName .. suffix)
                if oldGui then
                    pcall(function() oldGui:Destroy() end)
                end
            end
        end
    end

    for _, oldS in ipairs(SoundService:GetChildren()) do
        if oldS:IsA("Sound") and string.find(oldS.Name, hubName .. "_SFX_", 1, true) then
            pcall(function() oldS:Destroy() end)
        end
    end

    local oldSound = SoundService:FindFirstChild(hubName .. "_BGM")
