    Window.LoadIntroImage = function(url, fileName, fallback)
        if type(getcustomasset) ~= "function" and type(getsynasset) ~= "function" then
            return fallback or ""
        end
        if type(writefile) ~= "function" then
            return fallback or ""
        end
        local assetGetter = type(getcustomasset) == "function" and getcustomasset or getsynasset
        local cached = false
        if type(isfile) == "function" then
            pcall(function() cached = isfile(fileName) end)
        end
        if not cached then
            local requestFunction = nil
            if type(request) == "function" then
                requestFunction = request
            elseif type(http_request) == "function" then
                requestFunction = http_request
            elseif type(syn) == "table" and type(syn.request) == "function" then
                requestFunction = syn.request
            end
            local body = nil
            if requestFunction then
                local ok, response = pcall(requestFunction, {Url = url, Method = "GET"})
                if ok and type(response) == "table" and response.Success ~= false then
                    body = response.Body
                end
            end
            if type(body) ~= "string" or #body < 100 then
                local ok, result = pcall(function() return game:HttpGet(url) end)
                if ok and type(result) == "string" and #result > 100 then body = result end
            end
            if type(body) == "string" and #body > 100 then
                pcall(writefile, fileName, body)
            end
        end
        local ok, asset = pcall(assetGetter, fileName)
        if ok and type(asset) == "string" then return asset end
        return fallback or ""
    end

