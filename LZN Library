    function Window:RemoveTab(name)
        local tab = PublicTabs[tostring(name)]
        if not tab then return false end
        if tab.Container then tab.Container:Destroy() end
        if tab.Button then tab.Button:Destroy() end
        PublicTabs[tostring(name)] = nil
        if ActivePublicTab == tab.API then
            ActivePublicTab = nil
            ContentContainer.Visible = true
            for _, remaining in pairs(PublicTabs) do Window:SetTab(remaining.API); break end
        end
        return true
    end

