    local function LoadBackgroundAsset(url, fileName)
        local assetGetter = type(getcustomasset) == "function" and getcustomasset
            or (type(getsynasset) == "function" and getsynasset)
        if not assetGetter or type(writefile) ~= "function" then
            warn("[LZN] getcustomasset/getsynasset e writefile são necessários para carregar imagens locais.")
            return nil
        end

        local function isImage(data)
            if type(data) ~= "string" or #data < 128 then return false end
            return data:sub(1, 8) == string.char(137) .. "PNG\r\n\26\n"
                or data:sub(1, 3) == string.char(255, 216, 255)
        end

        local cached = false
        if type(isfile) == "function" and type(readfile) == "function" then
            local ok, exists = pcall(isfile, fileName)
            if ok and exists then
                local readOk, bytes = pcall(readfile, fileName)
                cached = readOk and isImage(bytes)
            end
        end

        if not cached then
            local body
            local requestFns = {}
            if type(request) == "function" then table.insert(requestFns, request) end
            if type(http_request) == "function" then table.insert(requestFns, http_request) end
            if type(syn) == "table" and type(syn.request) == "function" then table.insert(requestFns, syn.request) end
            if type(http) == "table" and type(http.request) == "function" then table.insert(requestFns, http.request) end

            for _, req in ipairs(requestFns) do
                local ok, response = pcall(req, {
                    Url = url,
                    Method = "GET",
                    Headers = {["User-Agent"] = "Mozilla/5.0", ["Accept"] = "image/png,image/jpeg,*/*"}
                })
                if ok and type(response) == "table" then
                    local status = tonumber(response.StatusCode or response.Status or response.status_code)
                    local candidate = response.Body or response.body
                    if (not status or (status >= 200 and status < 300)) and isImage(candidate) then
                        body = candidate
                        break
                    end
                end
            end

            if not body then
                local ok, candidate = pcall(function() return game:HttpGet(url) end)
                if ok and isImage(candidate) then body = candidate end
            end

            if not body then
                warn("[LZN] Não foi possível baixar a imagem: " .. tostring(url))
                return nil
            end

            local writeOk, writeErr = pcall(writefile, fileName, body)
            if not writeOk then
                warn("[LZN] writefile falhou (" .. tostring(fileName) .. "): " .. tostring(writeErr))
                return nil
            end
        end

        local ok, localAsset = pcall(assetGetter, fileName)
        if ok and type(localAsset) == "string" and localAsset ~= "" then
            return localAsset
        end
        warn("[LZN] getcustomasset não conseguiu resolver: " .. tostring(fileName))
        return nil
    end

