        local list = Instance.new("Frame")
        list.Size = UDim2.new(1, 0, 0, #items * 30)
        list.Position = UDim2.new(0, 0, 0, 42)
        list.BackgroundColor3 = Color3.fromRGB(10, 13, 20)
        list.ZIndex = 9
        list.Parent = wrapper
        Instance.new("UICorner", list).CornerRadius = UDim.new(0, 10)
        AddGlow(list, Color3.fromRGB(0, 190, 255), 1.2, 0.3)

        local function toggle(forceClose)
            if forceClose then
                isOpen = false
            else
                isOpen = not isOpen
            end
            if isOpen then
                for _, closeFn in ipairs(OpenDropdowns) do
                    if closeFn ~= toggle then closeFn(true) end
                end
            end
            local targetH = isOpen and (42 + (#items * 30)) or 38
            dropBtn.Text = label .. ": " .. tostring(current) .. (isOpen and "  ▴" or "  ▾")
            TweenService:Create(wrapper, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, targetH)
            }):Play()
        end

        table.insert(OpenDropdowns, toggle)

        for i, item in ipairs(items) do
            local itemBtn = Instance.new("TextButton")
            itemBtn.Size = UDim2.new(1, 0, 0, 30)
            itemBtn.Position = UDim2.new(0, 0, 0, (i - 1) * 30)
            itemBtn.BackgroundTransparency = 1
            itemBtn.Text = tostring(item)
            itemBtn.TextColor3 = Color3.fromRGB(220, 235, 255)
            itemBtn.Font = Enum.Font.GothamMedium
            itemBtn.TextSize = 13
            itemBtn.ZIndex = 11
            itemBtn.Parent = list
            AddClickEffect(itemBtn)

            itemBtn.MouseButton1Click:Connect(function()
                current = item
                toggle(true)
                if cfg.Callback then cfg.Callback(item) end
            end)
        end

        dropBtn.MouseButton1Click:Connect(function()
            toggle(false)
        end)

        local obj = {}
        function obj:SetValue(v, customDisplay)
            current = customDisplay or v
            dropBtn.Text = label .. ": " .. tostring(current) .. (isOpen and "  ▴" or "  ▾")
        end
        function obj:Close() toggle(true) end
        return obj
    end

    function Window:AddStepper(cfg)
        cfg = cfg or {}
        local label = cfg.Text or "VALOR"
        local value = cfg.Default or 100
        local step = cfg.Step or 50
        local minVal = cfg.Min or 1
        local maxVal = cfg.Max or 999999999

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 44)
