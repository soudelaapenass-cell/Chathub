        return true
    end
    local previousContainer = ActiveContainer
    ActiveContainer = PlayerPage
    shaderToggle = Window:AddToggle({
        Text = "LZN shaders",
        Icon = "success",
        Default = false,
        Callback = function(state)
            local ok = SetLZNShadersEnabled(state)
            if not ok and shaderToggle then shaderToggle:Set(false) end
        end
    })
    ActiveContainer = previousContainer
    SetLZNShadersEnabled(false)

    -- Idioma automático: LocaleId é a fonte principal; RobloxLocaleId é fallback.
    local LocalizationService = game:GetService("LocalizationService")
    local locale = "en-us"
    pcall(function() locale = Player.LocaleId end)
    if type(locale) ~= "string" or locale == "" then
        pcall(function() locale = LocalizationService.RobloxLocaleId end)
    end
    locale = string.lower(tostring(locale or "en-us"))
    local localePrefix = string.sub(locale, 1, 2)
    Window.LocaleId = locale
    Window.Language = localePrefix
    Window.LanguageName = locale
    local autoTranslator = nil
    pcall(function() autoTranslator = LocalizationService:GetTranslatorForPlayerAsync(Player) end)
    local translated = {}
    local function AutoTranslateObject(object)
        if not autoTranslator or not object or not object.Parent then return end
        if not (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then return end
        local original = object.Text
        if type(original) ~= "string" or original == "" or translated[original] then return end
        local ok, result = pcall(function() return autoTranslator:Translate(object, original) end)
        if ok and type(result) == "string" and result ~= "" then
            translated[original] = result
            object.Text = result
        end
    end
    task.defer(function()
        for _, object in ipairs(ScreenGui:GetDescendants()) do AutoTranslateObject(object) end
        ScreenGui.DescendantAdded:Connect(function(object) task.defer(function() AutoTranslateObject(object) end) end)
    end)

    -- A apresentação fica ativada por padrão; só é ignorada se o usuário
    -- definir ShowLanguageIntro = false explicitamente.
    if options.ShowLanguageIntro ~= false then
        MainFrame.Visible = false
        ToggleHubBtn.Visible = false
        task.spawn(function()
            HubOpen = true
            if BackgroundMusic and BackgroundMusic.IsPlaying then BackgroundMusic:Pause() end

            local overlay = Instance.new("Frame")
            overlay.Name = "LZNLanguageIntro"
            overlay.Size = UDim2.fromScale(1, 1)
            overlay.Position = UDim2.fromScale(0, 0)
            overlay.AnchorPoint = Vector2.new(0, 0)
            overlay.BackgroundColor3 = Color3.new(0, 0, 0)
            overlay.BackgroundTransparency = 0
            overlay.BorderSizePixel = 0
            overlay.ZIndex = 1000
            FullScreenBlurGui.Enabled = true
            FullScreenBlurGui.IgnoreGuiInset = true
            FullScreenBlurGui.DisplayOrder = 999999
            overlay.Parent = FullScreenBlurGui

            local function addText(name, content, pos, size, fontSize, color)
                local label = Instance.new("TextLabel")
                label.Name = name
                label.BackgroundTransparency = 1
                label.BorderSizePixel = 0
                label.Size = size
                label.Position = pos
                label.Font = Enum.Font.GothamBold
                label.Text = content
                label.TextColor3 = color or Color3.new(1, 1, 1)
                label.TextSize = fontSize
                label.TextWrapped = true
                label.TextXAlignment = Enum.TextXAlignment.Center
                label.TextYAlignment = Enum.TextYAlignment.Center
                label.TextTransparency = 1
                label.ZIndex = 1001
                label.Parent = overlay
                return label
            end

            local function addImage(name, url, fileName, pos, size)
                local image = Instance.new("ImageLabel")
                image.Name = name
                image.BackgroundTransparency = 1
                image.BorderSizePixel = 0
                image.Size = size
                image.Position = pos
                image.ScaleType = Enum.ScaleType.Fit
                image.ImageTransparency = 1
                image.ZIndex = 1001
                image.Parent = overlay

                -- Image is assigned ONLY from getcustomasset/getsynasset.
                local localAsset = LoadBackgroundAsset(url, fileName)
                if localAsset then
                    image.Image = localAsset
                else
                    image.Visible = false
                end
                return image
            end

            local function fadeIn(objects, duration)
                for _, object in ipairs(objects) do
                    local property = object:IsA("ImageLabel") and "ImageTransparency" or "TextTransparency"
                    TweenService:Create(object, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        [property] = 0
                    }):Play()
                end
            end

            local function fadeOut(objects, duration)
                local tweens = {}
                for _, object in ipairs(objects) do
                    local property = object:IsA("ImageLabel") and "ImageTransparency" or "TextTransparency"
                    local tween = TweenService:Create(object, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                        [property] = 1
                    })
                    table.insert(tweens, tween)
                    tween:Play()
                end
                if tweens[1] then tweens[1].Completed:Wait() end
            end

            local function waitIfAlive(seconds)
                local elapsed = 0
                while elapsed < seconds and overlay.Parent do
                    local dt = task.wait(0.1)
                    elapsed += dt
                end
            end

            -- Slide 1: bilingual thank-you message with its image directly underneath.
            local thankPT = addText(
                "ThankYouPT",
                "PT-BR 🇧🇷\nobrigado(a) por usar minha library, vida🤭 quero dizer, anjo😅❤️",
                UDim2.new(0.08, 0, 0.20, 0),
                UDim2.new(0.84, 0, 0, 76),
                16
            )
            local thankEN = addText(
                "ThankYouEN",
                "EN 🇺🇸\nThank(s) you for using my library, life🤭 I mean, angel😅❤️",
                UDim2.new(0.08, 0, 0.36, 0),
                UDim2.new(0.84, 0, 0, 76),
                16
            )
            local thankImage = addImage(
                "ThankYouImage",
                "https://i.ibb.co/8nsVqWrh/1795746809383.jpg",
                "LZN_intro_thanks.jpg",
                UDim2.new(0.5, -105, 0.54, 0),
                UDim2.new(0, 210, 0, 190)
            )

            fadeIn({thankPT, thankEN, thankImage}, 0.55)
            waitIfAlive(4)
            fadeOut({thankPT, thankEN, thankImage}, 0.5)
            thankPT:Destroy()
            thankEN:Destroy()
            thankImage:Destroy()

            if not overlay.Parent then return end

            -- Slide 2: creator credits, with the two images side-by-side below the text.
            local creditPT = addText(
                "CreditPT",
                "PT-BR 🇧🇷\nlibrary criada por LZN (Lezin)♥️",
                UDim2.new(0.06, 0, 0.20, 0),
                UDim2.new(0.88, 0, 0, 68),
                17,
                Color3.fromRGB(255, 220, 120)
            )
            local creditEN = addText(
                "CreditEN",
                "EN 🇺🇸\nlibrary by LZN (Lezin)♥️",
                UDim2.new(0.06, 0, 0.34, 0),
                UDim2.new(0.88, 0, 0, 68),
                17,
                Color3.fromRGB(255, 220, 120)
            )
            local creditImage1 = addImage(
                "LZNLogoImage",
                "https://i.ibb.co/60rmXBNK/IMG-20261116-185612.png",
                "LZN_intro_logo.png",
                UDim2.new(0.5, -155, 0.53, 0),
                UDim2.new(0, 140, 0, 170)
            )
            local creditImage2 = addImage(
                "ManhattanCreditImage",
                "https://i.ibb.co/gLZkkcZR/manhattan.png",
                "LZN_intro_manhattan.png",
                UDim2.new(0.5, 15, 0.53, 0),
                UDim2.new(0, 140, 0, 170)
            )

            fadeIn({creditPT, creditEN, creditImage1, creditImage2}, 0.55)
            waitIfAlive(4)
            fadeOut({creditPT, creditEN, creditImage1, creditImage2}, 0.5)

            if overlay and overlay.Parent then overlay:Destroy() end
            if ScreenGui and ScreenGui.Parent then
                MainFrame.Visible = true
                ToggleHubBtn.Visible = true
                HubOpen = true
                HubScale.Scale = 0.72
                TweenService:Create(HubScale, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Scale = 1
                }):Play()
                if BackgroundMusic and BGMText.Text ~= "OFF" then BackgroundMusic:Resume() end
            end
        end)

    else
        MainFrame.Visible = true
        ToggleHubBtn.Visible = true
        HubOpen = true
    end

    UpdateHubHeight()
    return Window
end

return LZNLib
