.new(0.98, 0, 0, 28)\n    row.BackgroundColor3 = PANEL_COLOR\n    row.Parent = parentContainer\n    Instance.new(\"UICorner\", row).CornerRadius = UDim.new(0, 4)\n    Instance.new(\"UIStroke\", row).Color = BORDER_COLOR\n\n    local lbl = Instance.new(\"TextLabel\")\n    lbl.Size = UDim2.new(0.6, 0, 1, 0)\n    lbl.Position = UDim2.new(0, 8, 0, 0)\n    lbl.BackgroundTransparency = 1\n    lbl.Text = titleText\n    lbl.TextColor3 = TEXT_COLOR\n    lbl.Font = Enum.Font.GothamBold\n    lbl.TextSize = 9.5\n    lbl.TextXAlignment = Enum.TextXAlignment.Left\n    lbl.Parent = row\n\n    local box = Instance.new(\"TextBox\")\n    box.Size = UDim2.new(0, 55, 0, 18)\n    box.Position = UDim2.new(1, -63, 0.5, -9)\n    box.BackgroundColor3 = Color3.fromRGB(26, 26, 30)\n    box.Text = tostring(settings[settingKey])\n    box.TextColor3 = ACCENT_COLOR\n    box.Font = Enum.Font.GothamBold\n    box.TextSize = 9.5\n    box.ClearTextOnFocus = false\n    box.Parent = row\n    Instance.new(\"UICorner\", box).CornerRadius = UDim.new(0, 4)\n\n    local boxStroke = Instance.new(\"UIStroke\")\n    boxStroke.Thickness = 1.2\n    boxStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border\n    boxStroke.Color = Color3.fromRGB(255, 255, 255)\n    boxStroke.Parent = box\n    createShineEffect(boxStroke, ACCENT_COLOR)\n\n    box.FocusLost:Connect(function()\n        local n = tonumber(box.Text)\n        if n then settings[settingKey] = n else box.Text = tostring(settings[settingKey]) end\n        SaveSettings()\n    end)\nend\n\n----------------------------------------------------\n-- INSTANTIATE HITBOX TAB BINDINGS\n----------------------------------------------------\ncreateCompactCycle(HitboxTabFrame, \"Target Category\", \"targetCategory\", TargetCategoryOptions, function() globalResetHitboxes() end)\ncreatePlayerDropdown(HitboxTabFrame)\ncreateCompactToggle(HitboxTabFrame, \"Hitbox Master (L)\", \"hitboxEnabled\", function(val)\n    if not val then globalResetHitboxes() end\n    ExternalHitboxBtn.BackgroundColor3 = val and Color3.fromRGB(20, 75, 42) or Color3.fromRGB(25, 25, 25)\n    updateHitboxStatus(true)\n    SaveSettings()\nend)\ncreateCompactToggle(HitboxTabFrame, \"External Hitbox Button (L)\", \"externalHitboxButton\", function(val) ExternalHitboxBtn.Visible = val; SaveSettings() end)\ncreateCompactToggle(HitboxTabFrame, \"External 360 Button (Z)\", \"external360Button\", function(val) External360Btn.Visible = val; SaveSettings() end)\ncreateCompactToggle(HitboxTabFrame, \"Show Hitbox Status\", \"statusDisplay\", function(val)\n    StatusHolder.Visible = val\n    if val then updateHitboxStatus(true) end\n    SaveSettings()\nend)\ncreateCompactInput(HitboxTabFrame, \"360 Speed\", \"spinSpeed\")\ncreateCompactInput(HitboxTabFrame, \"Hitbox Size Radius\", \"hitboxSize\")\ncreateCompactInput(HitboxTabFrame, \"Hitbox Opacity\", \"hitboxOpacity\")\ncreateCompactCycle(HitboxTabFrame, \"Hitbox Shape\", \"hitboxShape\", {\"Block\", \"Ball\", \"Cylinder\"}, function() globalResetHitboxes() end)\ncreateCompactCycle(HitboxTabFrame, \"Hitbox Material\", \"hitboxMaterial\", MaterialOptions, function() globalResetHitboxes() end)\ncreateCompactToggle(HitboxTabFrame, \"Hitbox Team Check\", \"hitboxTeamCheck\", function() globalResetHitboxes() end)\ncreateCompactCycle(HitboxTabFrame, \"Visibility Filter\", \"visibilityMode\", VisibilityOptions, function() globalResetHitboxes() end)\ncreateCompactToggle(HitboxTabFrame, \"Hitbox Dead Check\", \"deadCheck\", function(val) if val then globalResetHitboxes() end end)\ncreateCompactToggle(HitboxTabFrame, \"Forcefield Check\", \"ffCheck\", function() globalResetHitboxes() end)\ncreateCompactToggle(HitboxTabFrame, \"Nearest Selector Button\", \"nearestButtonToggle\", function(val) NearestPlayerBtn.Visible = val; SaveSettings() end)\n\n----------------------------------------------------\n-- INSTANTIATE VISUALS TAB BINDINGS\n----------------------------------------------------\ncreateCompactToggle(VisualsTabFrame, \"Enable Player ESP\", \"espEnabled\", function(val) if not val then clearVisualESP() end end)\ncreateCompactToggle(VisualsTabFrame, \"ESP Team Check\", \"espTeamCheck\")\ncreateCompactToggle(VisualsTabFrame, \"ESP Chams\", \"espChams\")\ncreateCompactToggle(VisualsTabFrame, \"ESP Name\", \"espName\")\ncreateCompactToggle(VisualsTabFrame, \"ESP Icon\", \"espIcon\")\ncreateCompactToggle(VisualsTabFrame, \"ESP Health (Status)\", \"espHealth\")\ncreateCompactToggle(VisualsTabFrame, \"ESP Tracer\", \"espTracer\")\ncreateCompactToggle(VisualsTabFrame, \"ESP Skeleton\", \"espSkeleton\")\ncreateCompactToggle(VisualsTabFrame, \"ESP Box\", \"espBox\")\ncreateCompactToggle(VisualsTabFrame, \"ESP Distance\", \"espDistance\")\ncreateCompactToggle(VisualsTabFrame, \"View Realista\", \"realisticView\")\n\n----------------------------------------------------\n-- 360° EXTERNAL BUTTON LOGIC\n----------------------------------------------------\nlocal isSpinning360 = false\nlocal spinConnection = nil\n\nlocal function stopSpin360()\n    if spinConnection then pcall(function() spinConnection:Disconnect() end); spinConnection = nil end\n    isSpinning360 = false\n    getgenv().Lezin360SpinConnection = nil\nend\n\nlocal function spin360()\n    if isSpinning360 then return end\n    local character = localPlayer.Character\n    local rootPart = character and character:FindFirstChild(\"HumanoidRootPart\")\n    local humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\n    if not rootPart or not humanoid or humanoid.Health <= 0 then return end\n\n    isSpinning360 = true\n    local oldDevMouseLock = localPlayer.DevEnableMouseLock\n    local oldAutoRotate = humanoid.AutoRotate\n\n    pcall(function() localPlayer.DevEnableMouseLock = false end)\n    humanoid.AutoRotate = false\n\n    local speedInput = tonumber(settings.spinSpeed) or 15\n    speedInput = math.clamp(speedInput, 1, 1000)\n\n    local degPerSec = speedInput * 90\n    local targetRadians = math.rad(360)\n    local totalRadiansRotated = 0\n    local _, startYaw, _ = rootPart.CFrame:ToOrientation()\n\n    spinConnection = RunService.RenderStepped:Connect(function(dt)\n        getgenv().Lezin360SpinConnection = spinConnection\n        if not rootPart.Parent or not humanoid.Parent or humanoid.Health <= 0 then\n            pcall(function() localPlayer.DevEnableMouseLock = oldDevMouseLock end)\n            humanoid.AutoRotate = oldAutoRotate\n            stopSpin360()\n            return\n        end\n\n        local stepRadians = math.min(math.rad(degPerSec * dt), targetRadians - totalRadiansRotated)\n        totalRadiansRotated = math.min(totalRadiansRotated + stepRadians, targetRadians)\n        local currentPosition = rootPart.Position\n        rootPart.CFrame = CFrame.new(currentPosition) * CFrame.Angles(0, startYaw + totalRadiansRotated, 0)\n\n        if totalRadiansRotated >= targetRadians then\n            pcall(function() localPlayer.DevEnableMouseLock = oldDevMouseLock end)\n            humanoid.AutoRotate = oldAutoRotate\n            stopSpin360()\n        end\n    end)\nend\n\nExternal360Btn.Activated:Connect(spin360)\nExternalHitboxBtn.Activated:Connect(function() setExternalHitboxState(not settings.hitboxEnabled) end)\nsetExternalHitboxState(settings.hitboxEnabled)\n\n----------------------------------------------------\n-- NEAREST PLAYER SELECTION & CHAMS LOGIC\n----------------------------------------------------\nlocal function getNearestPlayer()\n    local nearest, nearestDist = nil, math.huge\n    local myChar = localPlayer.Character\n    local myHrp = myChar and myChar:FindFirstChild(\"HumanoidRootPart\")\n    if not myHrp then\n        local camPos = camera and camera.CFrame.Position\n        if not camPos then return nil end\n        for _, p in ipairs(Players:GetPlayers()) do\n            if p ~= localPlayer and p.Character and p.Character:FindFirstChild(\"HumanoidRootPart\") then\n                local humanoid = p.Character:FindFirstChildOfClass(\"Humanoid\")\n                if humanoid and humanoid.Health > 0 then\n                    local part = p.Character.HumanoidRootPart\n                    local dist = (part.Position - camPos).Magnitude\n                    if dist < nearestDist then nearestDist = dist; nearest = p end\n                end\n            end\n        end\n    else\n        for _, p in ipairs(Players:GetPlayers()) do\n            if p ~= localPlayer and p.Character and p.Character:FindFirstChild(\"HumanoidRootPart\") then\n                local humanoid = p.Character:FindFirstChildOfClass(\"Humanoid\")\n                if humanoid and humanoid.Health > 0 then\n                    local part = p.Character.HumanoidRootPart\n                    local dist = (part.Position - myHrp.Position).Magnitude\n                    if dist < nearestDist then nearestDist = dist; nearest = p end\n                end\n            end\n        end\n    end\n    return nearest\nend\n\nlocal function showTemporaryChamsOnPlayer(player, duration)\n    if not player or not player.Character then return end\n    duration = duration or 4\n    if player.Character:FindFirstChild(\"NearestHighlightTemp\") then player.Character.NearestHighlightTemp:Destroy() end\n\n    local hl = Instance.new(\"Highlight\")\n    hl.Name = \"NearestHighlightTemp\"\n    hl.FillColor = Color3.fromRGB(255, 60, 60)\n    hl.OutlineColor = Color3.fromRGB(200, 20, 20)\n    hl.FillTransparency = 1\n    hl.OutlineTransparency = 1\n    hl.Adornee = player.Character\n    hl.Parent = player.Character\n    hl.Enabled = true\n\n    local appearTween = TweenService:Create(hl, TweenInfo.new(0.18), {FillTransparency = 0.35, OutlineTransparency = 0.15})\n    appearTween:Play()\n\n    local fadeTime = 0.6\n    task.spawn(function()\n        task.wait(math.max(0, duration - fadeTime))\n        local fadeTween = TweenService:Create(hl, TweenInfo.new(fadeTime), {FillTransparency = 1, OutlineTransparency = 1})\n        fadeTween:Play()\n        fadeTween.Completed:Wait()\n        if hl and hl.Parent then pcall(function() hl:Destroy() end) end\n    end)\nend\n\nlocal function selectNearestAndChams()\n    local nearest = getNearestPlayer()\n    if not nearest then return end\n    settings.targetSelection = \"Specific\"\n    settings.targetPlayerName = nearest.Name\n    SaveSettings()\n\n    local dropdownBtn = nil\n    for _, child in ipairs(HitboxTabFrame:GetChildren()) do\n        if child:IsA(\"Frame\") then\n            for _, sub in ipairs(child:GetChildren()) do\n                if sub:IsA(\"TextButton\") and sub.Name == \"TargetDropdownBtn\" then dropdownBtn = sub; break end\n            end\n        elseif child:IsA(\"TextButton\") and child.Name == \"TargetDropdownBtn\" then\n            dropdownBtn = child; break\n        end\n        if dropdownBtn then break end\n    end\n    if dropdownBtn and dropdownBtn:IsA(\"TextButton\") then dropdownBtn.Text = nearest.Name end\n\n    showTemporaryChamsOnPlayer(nearest, 4)\n    globalResetHitboxes()\n    updateHitboxStatus(true)\nend\n\nNearestPlayerBtn.Activated:Connect(function() selectNearestAndChams() end)\n\n----------------------------------------------------\n-- CENTRALIZED STATE-SYNC ENGINE & ESP COMPLETO\n----------------------------------------------------\ngetgenv().HitboxAbuse_Heartbeat = RunService.RenderStepped:Connect(function()\n    if settings.realisticView then\n        local char = localPlayer.Character\n        if char then\n            local head = char:FindFirstChild(\"Head\")\n            if head then\n                camera.CameraSubject = head\n            end\n        end\n    else\n        local char = localPlayer.Character\n        if char then\n            local hum = char:FindFirstChildOfClass(\"Humanoid\")\n            if hum and camera.CameraSubject ~= hum then\n                camera.CameraSubject = hum\n            end\n        end\n    end\n\n    if settings.hitboxEnabled then\n        local entities = {}\n        \n        if settings.targetCategory == \"Players\" or settings.targetCategory == \"Both\" then\n            for _, pl in ipairs(Players:GetPlayers()) do\n                if pl ~= localPlayer then\n                    table.insert(entities, {key = pl, char = pl.Character, isPlayer = true, playerObj = pl})\n                end\n            end\n        end\n        \n        if settings.targetCategory == \"NPCs\" or settings.targetCategory == \"Both\" then\n            for _, obj in ipairs(Workspace:GetDescendants()) do\n                if obj:IsA(\"Model\") and obj ~= localPlayer.Character then\n                    local hum = obj:FindFirstChildOfClass(\"Humanoid\")\n                    local isPlayerChar = false\n                    for _, p in ipairs(Players:GetPlayers()) do\n                        if p.Character == obj then isPlayerChar = true break end\n                    end\n                    if hum and not isPlayerChar then\n                        local alreadyAdded = false\n                        for _, existing in ipairs(entities) do\n                            if existing.key == obj then alreadyAdded = true break end\n                        end\n                        if not alreadyAdded then\n                            table.insert(entities, {key = obj, char = obj, isPlayer = false, playerObj = nil})\n                        end\n                    end\n                end\n            end\n        end\n\n        for _, ent in ipairs(entities) do\n            local char = ent.char\n            local isAlive = false\n            local humanoid = char and char:FindFirstChildOfClass(\"Humanoid\")\n            if humanoid and humanoid.Health > 0 then isAlive = true end\n\n            if not isAlive then\n                if settings.originalSizes[ent.key] then restorePartForEntity(ent.key) end\n            else\n                local hasForcefield = char and char:FindFirstChildOfClass(\"ForceField\")\n                if (settings.deadCheck and not isAlive) or (settings.ffCheck and hasForcefield) then\n                    if settings.originalSizes[ent.key] then restorePartForEntity(ent.key) end\n                elseif char and not hasForcefield then\n                    local part = char:FindFirstChild(\"HumanoidRootPart\") or char:FindFirstChild(\"Head\") or char.PrimaryPart\n                    if part then\n                        local passesFilters = true\n                        if ent.isPlayer then\n                            if settings.hitboxTeamCheck and isTeammate(ent.playerObj) then passesFilters = false end\n                            if settings.targetSelection == \"Specific\" and settings.targetPlayerName ~= \"\" and settings.targetPlayerName ~= ent.playerObj.Name then passesFilters = false end\n                        else\n                            if settings.targetSelection == \"Specific\" and settings.targetPlayerName ~= \"\" then\n                                passesFilters = false\n                            end\n                        end\n\n                        if passesFilters and camera then\n                            if settings.visibilityMode == \"Wall Check\" then\n                                local myChar = localPlayer.Character\n                                local myRoot = myChar and myChar:FindFirstChild(\"HumanoidRootPart\")\n                                local startPos = myRoot and myRoot.Position or camera.CFrame.Position\n                                if not checkWallVisibility(part.Position, startPos) then passesFilters = false end\n                            elseif settings.visibilityMode == \"Visible Check\" then\n                                local _, onScreen = camera:WorldToViewportPoint(part.Position)\n                                if not onScreen then passesFilters = false else\n                                    if not checkWallVisibility(part.Position, camera.CFrame.Position) then passesFilters = false end\n                                end\n                            end\n                        end\n\n                        if passesFilters then\n                            if not settings.originalSizes[ent.key] or not settings.originalSizes[ent.key][part.Name] then saveOriginalPartInfo(ent.key, part) end\n                            part.Size = Vector3.new(settings.hitboxSize, settings.hitboxSize, settings.hitboxSize)\n                            part.CanCollide = false\n                            part.Transparency = 1 - settings.hitboxOpacity\n                            part.Material = Enum.Material[settings.hitboxMaterial] or Enum.Material.Plastic\n                            if part:IsA(\"Part\") then\n                                if settings.hitboxShape == \"Ball\" then part.Shape = Enum.PartType.Ball\n                                elseif settings.hitboxShape == \"Cylinder\" then part.Shape = Enum.PartType.Cylinder\n                                else part.Shape = Enum.PartType.Block end\n                            end\n                        else\n                            if settings.originalSizes[ent.key] and settings.originalSizes[ent.key][part.Name] then restorePartForEntity(ent.key) end\n                        end\n                    end\n                end\n            end\n        end\n    else\n        globalResetHitboxes()\n    end\n    \n    if settings.espEnabled then\n        for _, v in ipairs(Players:GetPlayers()) do\n            if v ~= localPlayer then\n                local char = v.Character\n                local humanoid = char and char:FindFirstChildOfClass(\"Humanoid\")\n                if char and humanoid and humanoid.Health > 0 then\n                    local hrp = char:FindFirstChild(\"HumanoidRootPart\")\n                    local head = char:FindFirstChild(\"Head\")\n                    \n                    if hrp and head then\n                        local isTeam = isTeammate(v)\n                        local shouldShow = true\n                        \n                        if settings.espTeamCheck and isTeam then shouldShow = false end\n                        if settings.targetSelection == \"Specific\" and settings.targetPlayerName ~= v.Name then shouldShow = false end\n                        \n                        local hl = char:FindFirstChild(\"EspHighlight\")\n                        local bb = head:FindFirstChild(\"EspBillboard\")\n                        \n                        if shouldShow then\n                            local currentColor = isTeam and ColorValues[settings.teamColor] or ColorValues[settings.enemyColor]\n                            \n                            if settings.espChams then\n                                if not hl then\n                                    hl = Instance.new(\"Highlight\")\n                                    hl.Name = \"EspHighlight\"\n                                    hl.FillTransparency = 0.5\n                                    hl.OutlineTransparency = 0.1\n                                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop\n                                    hl.Parent = ChamsFolder\n                                end\n                                hl.Adornee = char\n                                hl.Enabled = true\n                                hl.FillColor = currentColor\n                                hl.OutlineColor = currentColor\n                            else\n                                if hl then hl.Enabled = false end\n                            end\n                            \n                            if settings.espName or settings.espIcon or settings.espHealth or settings.espDistance then\n                                if not bb then\n                                    bb = Instance.new(\"BillboardGui\")\n                                    bb.Name = \"EspBillboard\"\n                                    bb.Size = UDim2.new(0, 160, 0, 75)\n                                    bb.AlwaysOnTop = true\n                                    bb.ExtentsOffset = Vector3.new(0, 2.5, 0)\n                                    bb.Parent = head\n                                    \n                                    local container = Instance.new(\"Frame\", bb)\n                                    container.Name = \"Container\"\n                                    container.Size = UDim2.new(1, 0, 1, 0)\n                                    container.BackgroundTransparency = 1\n                                    \n                                    local icon = Instance.new(\"ImageLabel\", container)\n                                    icon.Name = \"Icon\"\n                                    icon.Size = UDim2.new(0, 26, 0, 26)\n                                    icon.Position = UDim2.new(0, 6, 0, 0)\n                                    icon.BackgroundTransparency = 1\n                                    icon.Parent = container\n                                    Instance.new(\"UICorner\", icon).CornerRadius = UDim.new(1, 0)\n                                    \n                                    local nameLabel = Instance.new(\"TextLabel\", container)\n                                    nameLabel.Name = \"NameLabel\"\n                                    nameLabel.Size = UDim2.new(1, -35, 0, 16)\n                                    nameLabel.Position = UDim2.new(0, 36, 0, 4)\n                                    nameLabel.BackgroundTransparency = 1\n                                    nameLabel.Font = Enum.Font.GothamBold\n                                    nameLabel.TextSize = 10\n                                    nameLabel.TextXAlignment = Enum.TextXAlignment.Left\n                                    nameLabel.TextColor3 = TEXT_COLOR\n                                    \n                                    local distLabel = Instance.new(\"TextLabel\", container)\n                                    distLabel.Name = \"DistLabel\"\n                                    distLabel.Size = UDim2.new(1, -35, 0, 12)\n                                    distLabel.Position = UDim2.new(0, 36, 0, 18)\n                                    distLabel.BackgroundTransparency = 1\n                                    distLabel.Font = Enum.Font.GothamMedium\n                                    distLabel.TextSize = 8.5\n                                    distLabel.TextXAlignment = Enum.TextXAlignment.Left\n                                    distLabel.TextColor3 = SUBTEXT_COLOR\n                                    \n                                    local healthBack = Instance.new(\"Frame\", container)\n                                    healthBack.Name = \"HealthBack\"\n                                    healthBack.Size = UDim2.new(1, -12, 0, 6)\n                                    healthBack.Position = UDim2.new(0, 6, 0, 34)\n                                    healthBack.BackgroundColor3 = Color3.fromRGB(22, 22, 28)\n                                    healthBack.BorderSizePixel = 0\n                                    Instance.new(\"UICorner\", healthBack).CornerRadius = UDim.new(1, 0)\n                                    \n                                    local healthBar = Instance.new(\"Frame\", healthBack)\n                                    healthBar.Name = \"HealthBar\"\n                                    healthBar.Size = UDim2.new(1, 0, 1, 0)\n                                    healthBar.BackgroundColor3 = Color3.fromRGB(55, 235, 115)\n                                    healthBar.BorderSizePixel = 0\n                                    Instance.new(\"UICorner\", healthBar).CornerRadius = UDim.new(1, 0)\n                                end\n                                \n                                bb.Adornee = head\n                                bb.Enabled = true\n                                \n                                local container = bb:FindFirstChild(\"Container\")\n                                if container then\n                                    local icon = container:FindFirstChild(\"Icon\")\n                                    local nameLabel = container:FindFirstChild(\"NameLabel\")\n                                    local distLabel = container:FindFirstChild(\"DistLabel\")\n                                    local healthBack = container:FindFirstChild(\"HealthBack\")\n                                    local healthBar = healthBack and healthBack:FindFirstChild(\"HealthBar\")\n                                    \n                                    if icon then\n                                        icon.Visible = settings.espIcon\n                                        local ok, content = pcall(function() return \"rbxthumb://type=AvatarHeadShot&id=\" .. v.UserId .. \"&w=150&h=150\" end)\n                                        icon.Image = ok and content or \"\"\n                                    end\n                                    \n                                    if nameLabel then\n                                        nameLabel.Visible = settings.espName\n                                        nameLabel.Text = v.DisplayName or v.Name\n                                        nameLabel.TextColor3 = currentColor\n                                    end\n                                    \n                                    if distLabel then\n                                        distLabel.Visible = settings.espDistance\n                                        local myChar = localPlayer.Character\n                                        local myHrp = myChar and myChar:FindFirstChild(\"HumanoidRootPart\")\n                                        local distance = myHrp and math.floor((myHrp.Position - hrp.Position).Magnitude) or 0\n                                        distLabel.Text = string.format(\"Distância: %d studs\", distance)\n                                    end\n                                    \n                                    if healthBack and healthBar then\n                                        healthBack.Visible = settings.espHealth\n                                        local hp = math.clamp(humanoid.Health, 0, humanoid.MaxHealth)\n                                        local maxHp = math.max(humanoid.MaxHealth, 1)\n                                        local ratio = hp / maxHp\n                                        healthBar.Size = UDim2.new(ratio, 0, 1, 0)\n                                        \n                                        if ratio > 0.5 then\n                                            healthBar.BackgroundColor3 = Color3.fromRGB(55, 235, 115)\n                                        elseif ratio > 0.25 then\n                                            healthBar.BackgroundColor3 = Color3.fromRGB(240, 200, 40)\n                                        else\n                                            healthBar.BackgroundColor3 = Color3.fromRGB(240, 50, 50)\n                                        end\n                                    end\n                                end\n                            else\n                                if bb then bb.Enabled = false end\n                            end\n                        else\n                            if hl then hl.Enabled = false end\n                            if bb then bb.Enabled = false end\n                        end\n                    else\n                        if char:FindFirstChild(\"EspHighlight\") then char.EspHighlight:Destroy() end\n                        if head and head:FindFirstChild(\"EspBillboard\") then head.EspBillboard:Destroy() end\n                    end\n                else\n                    if char then\n                        if char:FindFirstChild(\"EspHighlight\") then char.EspHighlight:Destroy() end\n                        local head = char:FindFirstChild(\"Head\")\n                        if head and head:FindFirstChild(\"EspBillboard\") then head.EspBillboard:Destroy() end\n                    end\n                end\n            end\n        end\n    else\n        clearVisualESP()\n    end\nend)\n"
