            checkBox.BackgroundColor3 = Color3.fromRGB(28, 36, 52)
            checkBox.ZIndex = 27
            checkBox.Parent = itemBtn
            Instance.new("UICorner", checkBox).CornerRadius = UDim.new(0, 4)
            AddGlow(checkBox, accentColor, 1, 0.35)

            local itemLbl = Instance.new("TextLabel")
            itemLbl.Size = UDim2.new(1, -30, 1, 0)
            itemLbl.Position = UDim2.new(0, 28, 0, 0)
            itemLbl.BackgroundTransparency = 1
            itemLbl.Text = key
            itemLbl.TextColor3 = Color3.fromRGB(215, 232, 250)
            itemLbl.Font = Enum.Font.GothamBold
            itemLbl.TextSize = 11
            itemLbl.TextXAlignment = Enum.TextXAlignment.Left
            itemLbl.ZIndex = 27
            itemLbl.Parent = itemBtn

            table.insert(optionButtons, {
                key = key,
                btn = itemBtn,
                box = checkBox,
                lbl = itemLbl
            })

            itemBtn.MouseButton1Click:Connect(function()
                selectedMap[key] = not selectedMap[key]
                local nowSel = selectedMap[key] == true
                PlaySFX(nowSel and ToggleOnSFX or ToggleOffSFX, nowSel and 1.14 or 0.9)
                refreshOptionsVisual()
                if cfg.Callback then
                    cfg.Callback(getSelectedList(), item, nowSel)
                end
            end)
        end

        refreshOptionsVisual()

        dropBtn.MouseButton1Click:Connect(function()
            isOpen = not isOpen
            PlaySFX(DropdownSFX, isOpen and 1.12 or 0.92)
