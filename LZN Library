    local function BindJumpPowerPersistence(hum)
        if not hum then return end
        local enforcing = false
        local function enforceJumpPower()
            if enforcing or not hum.Parent then return end
            enforcing = true
            pcall(function()
                hum.UseJumpPower = true
                local targetPower = jumpSlider:GetValue()
                if math.abs(hum.JumpPower - targetPower) > 0.01 then
                    hum.JumpPower = targetPower
                end
            end)
            enforcing = false
        end
        hum:GetPropertyChangedSignal("JumpPower"):Connect(enforceJumpPower)
        hum:GetPropertyChangedSignal("UseJumpPower"):Connect(enforceJumpPower)
        hum.StateChanged:Connect(function(_, newState)
            if newState == Enum.HumanoidStateType.Jumping or newState == Enum.HumanoidStateType.Freefall then
                enforceJumpPower()
            end
        end)
        enforceJumpPower()
    end

