    local function EquipSlot(slotIdx)
        local itemName = hotbarSlots[slotIdx]
        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not itemName or not hum or not char then return end

        PlaySFX(ClickSFX, 1.05)

        if equippedSlotIdx == slotIdx then
            equippedSlotIdx = nil
            pcall(function()
                hum:UnequipTools()
                local bp = Player:FindFirstChildOfClass("Backpack")
                if bp then
                    for _, t in ipairs(char:GetChildren()) do
                        if t:IsA("Tool") then
                            t.Parent = bp
                        end
                    end
                end
            end)
            EquippedActionBar.Visible = false
            return
        end

        local tools = FindToolsByName(itemName)
        if #tools > 0 then
            local toolToEquip = tools[1]
            SaveToolTemplate(toolToEquip)
            equippedSlotIdx = slotIdx
            pcall(function()
                hum:UnequipTools()
                toolToEquip.Parent = char
                hum:EquipTool(toolToEquip)
                if toolToEquip.Parent ~= char then
                    toolToEquip.Parent = char
                end
            end)
            EquippedActionBar.Visible = true
        else
            local restored = GiveRealToolToPlayer(itemName, nil, true)
            if restored then
                equippedSlotIdx = slotIdx
                EquippedActionBar.Visible = true
            end
        end
    end

    local function CollectDroppedTool(tool)
        if not tool or not tool:IsA("Tool") or not tool.Parent then return end
        SaveToolTemplate(tool)
        local bp = Player:FindFirstChildOfClass("Backpack")
        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not bp or not char then return end

        droppedToolRegistry[tool] = nil
        pcall(function()
            tool.Parent = bp
            if hum then
                hum:EquipTool(tool)
            end
        end)

        local existsInHotbar = false
        for s = 1, 10 do
            if hotbarSlots[s] == tool.Name then
                existsInHotbar = true
                break
            end
        end
        if not existsInHotbar then
            for s = 1, 10 do
                if not hotbarSlots[s] then
                    hotbarSlots[s] = tool.Name
                    break
                end
            end
        end

        if RebuildHotbarAndBackpack then
            RebuildHotbarAndBackpack()
        end
    end

    DropMiniBtn.MouseButton1Click:Connect(function()
        if not equippedSlotIdx then return end
        local itemName = hotbarSlots[equippedSlotIdx]
