        GetChildren = function() return ActiveContainer:GetChildren() end
    }
    Window.StateManager = {Values = {}, Set = function(self, key, value) self.Values[key] = value end, Get = function(self, key) return self.Values[key] end}
    Window.ConfigManager = {
        Save = function(_, fileName)
            if type(writefile) ~= "function" then return false, "writefile indisponível" end
            local ok, encoded = pcall(function() return HttpService:JSONEncode({Theme = ThemeManager.Current, State = Window.StateManager.Values}) end)
            if not ok then return false, encoded end
            local path = tostring(fileName or "LZNConfig") .. ".json"
            local saved, err = pcall(writefile, path, encoded)
            return saved, err
        end,
        Load = function(_, fileName)
            if type(readfile) ~= "function" or type(isfile) ~= "function" then return false, "leitura de arquivos indisponível" end
            local path = tostring(fileName or "LZNConfig") .. ".json"
            if not isfile(path) then return false, "configuração não encontrada" end
            local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
            if not ok then return false, data end
            if data.State then Window.StateManager.Values = data.State end
            if data.Theme then ThemeManager:Apply(data.Theme) end
            return true
        end
    }

