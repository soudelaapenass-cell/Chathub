    local function AttachStrictToggleControl(pillFrame, dotFrame, initialState, onStateChanged)
        local state = initialState == true
        local draggingToggle = false
        local dragStartPos = nil
        local movedEnough = false

        local function applyVisual(newState, fire)
            local prevState = state
            state = newState
            TweenService:Create(pillFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundColor3 = state and Color3.fromRGB(0, 200, 145) or Color3.fromRGB(28, 36, 52)
            }):Play()
            TweenService:Create(dotFrame, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
            }):Play()
            if fire and prevState ~= state then
                if state then
                    PlaySFX(ToggleOnSFX, 1.15)
                else
                    PlaySFX(ToggleOffSFX, 0.88)
                end
            end
            if fire and onStateChanged then
                onStateChanged(state)
            end
        end

        pillFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingToggle = true
                dragStartPos = input.Position
                movedEnough = false
                TweenService:Create(dotFrame, TweenInfo.new(0.1), {Size = UDim2.new(0, 18, 0, 18)}):Play()
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if draggingToggle and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragStartPos then
                local deltaX = input.Position.X - dragStartPos.X
                if math.abs(deltaX) > 4 then
                    movedEnough = true
                    local pillW = math.max(pillFrame.AbsoluteSize.X - 20, 1)
                    local curOff = state and pillW or 0
                    local newOff = math.clamp(curOff + deltaX, 0, pillW)
                    dotFrame.Position = UDim2.new(0, 2 + newOff, 0.5, -8)
                end
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if draggingToggle and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                draggingToggle = false
                TweenService:Create(dotFrame, TweenInfo.new(0.12), {Size = UDim2.new(0, 16, 0, 16)}):Play()
                if movedEnough then
                    local pillW = math.max(pillFrame.AbsoluteSize.X - 20, 1)
                    local currentOffset = dotFrame.Position.X.Offset - 2
                    applyVisual(currentOffset >= (pillW * 0.5), true)
                else
                    applyVisual(not state, true)
                end
            end
        end)

        return {
            Set = function(v, fire) applyVisual(v == true, fire ~= false) end,
            Get = function() return state end
        }
    end

