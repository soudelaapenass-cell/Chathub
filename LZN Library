    local function CompleteDropAt(screenPos)
        if not dragSource then return end
        local src = dragSource
        dragSource = nil
        DragGhost.Visible = false

        if not isDraggingItem then
            if src.kind == "hotbar" then
                EquipSlot(src.key)
                if RebuildHotbarAndBackpack then RebuildHotbarAndBackpack() end
            elseif src.kind == "backpack" then
                local emptySlot = nil
                for i = 1, 10 do
                    if not hotbarSlots[i] then
                        emptySlot = i
                        break
                    end
                end
                if emptySlot then
                    PlaySFX(ClickSFX, 1.08)
                    RemoveBackpackCount(src.name, 1)
                    hotbarSlots[emptySlot] = src.name
                    GiveRealToolToPlayer(src.name, src.image, false)
                    if RebuildHotbarAndBackpack then RebuildHotbarAndBackpack() end
                end
            end
            isDraggingItem = false
            return
        end

        isDraggingItem = false
        PlaySFX(ClickSFX, 1.02)
        local droppedOnHotbarIdx = nil
        for i = 1, 10 do
            local sObj = slotButtons[i]
            if sObj and sObj.btn and sObj.btn.Visible then
                local p0 = sObj.btn.AbsolutePosition
                local p1 = p0 + sObj.btn.AbsoluteSize
                if screenPos.X >= p0.X and screenPos.X <= p1.X and screenPos.Y >= p0.Y and screenPos.Y <= p1.Y then
                    droppedOnHotbarIdx = i
                    break
                end
            end
        end

        local droppedOnBackpackPanel = false
        if BackpackPanel.Visible then
            local b0 = BackpackPanel.AbsolutePosition
            local b1 = b0 + BackpackPanel.AbsoluteSize
            if screenPos.X >= b0.X and screenPos.X <= b1.X and screenPos.Y >= b0.Y and screenPos.Y <= b1.Y then
                droppedOnBackpackPanel = true
            end
        end

        if droppedOnHotbarIdx then
            if src.kind == "hotbar" and src.key ~= droppedOnHotbarIdx then
                local tmp = hotbarSlots[droppedOnHotbarIdx]
                hotbarSlots[droppedOnHotbarIdx] = hotbarSlots[src.key]
                hotbarSlots[src.key] = tmp
                if equippedSlotIdx == src.key then
                    equippedSlotIdx = droppedOnHotbarIdx
                elseif equippedSlotIdx == droppedOnHotbarIdx then
                    equippedSlotIdx = src.key
                end
            elseif src.kind == "backpack" then
                local targetExisting = hotbarSlots[droppedOnHotbarIdx]
                RemoveBackpackCount(src.name, 1)
                if targetExisting then
                    local existingTools = FindToolsByName(targetExisting)
                    if #existingTools > 0 then
                        SaveToolTemplate(existingTools[1])
                    end
                    local tEntry = EnsureBackpackEntry(targetExisting, "rbxassetid://78521393913034")
                    tEntry.Count = tEntry.Count + 1
                    for _, exT in ipairs(existingTools) do
                        suppressedToolNames[targetExisting] = (suppressedToolNames[targetExisting] or 0) + 1
                        pcall(function() exT:Destroy() end)
                    end
                end
                hotbarSlots[droppedOnHotbarIdx] = src.name
                GiveRealToolToPlayer(src.name, src.image, false)
            end
        elseif droppedOnBackpackPanel and src.kind == "hotbar" then
            local hName = hotbarSlots[src.key]
            if hName then
                local tools = FindToolsByName(hName)
                if #tools > 0 then
                    SaveToolTemplate(tools[1])
                end
                local entry = EnsureBackpackEntry(hName, src.image)
                entry.Count = entry.Count + math.max(#tools, 1)
                for _, t in ipairs(tools) do
                    suppressedToolNames[hName] = (suppressedToolNames[hName] or 0) + 1
                    pcall(function() t:Destroy() end)
                end
                hotbarSlots[src.key] = nil
                if equippedSlotIdx == src.key then
                    equippedSlotIdx = nil
                    EquippedActionBar.Visible = false
                end
            end
        end

        if RebuildHotbarAndBackpack then RebuildHotbarAndBackpack() end
    end

