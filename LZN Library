    local function GetItemImage(tool)
        if tool and tool.TextureId and tool.TextureId ~= "" then
            return tool.TextureId
        end
        return "rbxassetid://78521393913034"
    end

    local function SaveToolTemplate(tool)
        if not tool or not tool:IsA("Tool") then return end
        local ok, cloned = pcall(function()
            local c = tool:Clone()
            c.Parent = nil
            return c
        end)
        if ok and cloned then
            if toolTemplates[tool.Name] then
                pcall(function() toolTemplates[tool.Name]:Destroy() end)
            end
            toolTemplates[tool.Name] = cloned
        end
    end

    local function BuildRealTool(itemName, fallbackImage)
        local tpl = toolTemplates[itemName]
        if tpl then
            local ok, clone = pcall(function()
                local c = tpl:Clone()
                c.Name = itemName
                return c
            end)
            if ok and clone then
                return clone
            end
        end
        local fallback = Instance.new("Tool")
        fallback.Name = itemName
        fallback.TextureId = (fallbackImage and fallbackImage ~= "") and fallbackImage or "rbxassetid://78521393913034"
        fallback.RequiresHandle = true
        local handle = Instance.new("Part")
        handle.Name = "Handle"
        handle.Size = Vector3.new(1, 1, 1)
        handle.Transparency = 1
        handle.CanCollide = false
        handle.Massless = true
        handle.Parent = fallback
        return fallback
    end

    local function GiveRealToolToPlayer(itemName, fallbackImage, equipNow)
        local bp = Player:FindFirstChildOfClass("Backpack")
        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not bp and not char then return nil end

        suppressedToolNames[itemName] = (suppressedToolNames[itemName] or 0) + 1
        local realTool = BuildRealTool(itemName, fallbackImage)
        if not realTool then
            suppressedToolNames[itemName] = math.max(0, (suppressedToolNames[itemName] or 1) - 1)
            return nil
        end

        if equipNow and char and hum then
            pcall(function()
                hum:UnequipTools()
                realTool.Parent = char
                hum:EquipTool(realTool)
            end)
        elseif bp then
            pcall(function()
                realTool.Parent = bp
            end)
        end

        lastKnownToolCounts[itemName] = (lastKnownToolCounts[itemName] or 0) + 1
        return realTool
    end

    local function FindToolsByName(itemName)
        local found = {}
        local bp = Player:FindFirstChildOfClass("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and t.Name == itemName then
                    table.insert(found, t)
                end
            end
        end
        if Player.Character then
            for _, t in ipairs(Player.Character:GetChildren()) do
                if t:IsA("Tool") and t.Name == itemName then
                    table.insert(found, t)
                end
            end
        end
        return found
    end

    local function EnsureBackpackEntry(itemName, textureId)
        for _, entry in ipairs(backpackItems) do
            if entry.Name == itemName then
                if textureId and textureId ~= "" then entry.Image = textureId end
                return entry
            end
        end
        local newEntry = {
            Name = itemName,
            Image = (textureId and textureId ~= "") and textureId or "rbxassetid://78521393913034",
            Count = 0
        }
        table.insert(backpackItems, newEntry)
        return newEntry
    end

    local function RemoveBackpackCount(itemName, qty)
        for idx = #backpackItems, 1, -1 do
            local entry = backpackItems[idx]
            if entry.Name == itemName then
                entry.Count = math.max(0, entry.Count - qty)
                if entry.Count <= 0 then
                    table.remove(backpackItems, idx)
                end
                break
            end
        end
    end

    local RebuildHotbarAndBackpack

    local function EquipSlot(slotIdx)
        local itemName = hotbarSlots[slotIdx]
        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not itemName or not hum or not char then return end

        PlaySFX(ClickSFX, 1.05)

        if equippedSlotIdx == slotIdx then
            equippedSlotIdx = nil
            pcall(function()
                hum:UnequipTools()
                local bp = Player:FindFirstChildOfClass("Backpack")
                if bp then
                    for _, t in ipairs(char:GetChildren()) do
                        if t:IsA("Tool") then
                            t.Parent = bp
                        end
                    end
                end
            end)
            EquippedActionBar.Visible = false
            return
        end

        local tools = FindToolsByName(itemName)
        if #tools > 0 then
            local toolToEquip = tools[1]
            SaveToolTemplate(toolToEquip)
            equippedSlotIdx = slotIdx
            pcall(function()
                hum:UnequipTools()
                toolToEquip.Parent = char
                hum:EquipTool(toolToEquip)
                if toolToEquip.Parent ~= char then
                    toolToEquip.Parent = char
                end
            end)
            EquippedActionBar.Visible = true
        else
            local restored = GiveRealToolToPlayer(itemName, nil, true)
            if restored then
                equippedSlotIdx = slotIdx
                EquippedActionBar.Visible = true
            end
        end
    end

    local function CollectDroppedTool(tool)
        if not tool or not tool:IsA("Tool") or not tool.Parent then return end
        SaveToolTemplate(tool)
        local bp = Player:FindFirstChildOfClass("Backpack")
        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not bp or not char then return end

        droppedToolRegistry[tool] = nil
        pcall(function()
            tool.Parent = bp
            if hum then
                hum:EquipTool(tool)
            end
        end)

        local existsInHotbar = false
        for s = 1, 10 do
            if hotbarSlots[s] == tool.Name then
                existsInHotbar = true
                break
            end
        end
        if not existsInHotbar then
            for s = 1, 10 do
                if not hotbarSlots[s] then
                    hotbarSlots[s] = tool.Name
                    break
                end
            end
        end

        if RebuildHotbarAndBackpack then
            RebuildHotbarAndBackpack()
        end
    end

    DropMiniBtn.MouseButton1Click:Connect(function()
        if not equippedSlotIdx then return end
        local itemName = hotbarSlots[equippedSlotIdx]
        if not itemName then return end
        PlaySFX(ClickSFX, 0.95)
        local qty = math.max(1, math.floor(tonumber(QtyBox.Text) or 1))
        local tools = FindToolsByName(itemName)
        local char = Player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local dropped = 0

        for _, t in ipairs(tools) do
            if dropped >= qty then break end
            SaveToolTemplate(t)
            pcall(function()
                if t.Parent == char and hum then
                    hum:UnequipTools()
                end
                t.CanBeDropped = true
                local baseCF = hrp and (hrp.CFrame * CFrame.new(0, 1.5, -3.5 - (dropped * 0.8))) or CFrame.new(0, 5, 0)
                for _, p in ipairs(t:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.Anchored = false
                        p.CanCollide = true
                        p.CFrame = baseCF
                    end
                end
                t.Parent = workspace
                droppedToolRegistry[t] = true
                for _, p in ipairs(t:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.Touched:Connect(function(hit)
                            if droppedToolRegistry[t] and char and hit and hit:IsDescendantOf(char) then
                                CollectDroppedTool(t)
                            end
                        end)
                    end
                end
            end)
            dropped = dropped + 1
        end

        if #tools - dropped <= 0 then
            hotbarSlots[equippedSlotIdx] = nil
            equippedSlotIdx = nil
            EquippedActionBar.Visible = false
        end
        if RebuildHotbarAndBackpack then RebuildHotbarAndBackpack() end
        if Window.NotifyAction then Window.NotifyAction("Inventário", "Item descartado: " .. tostring(dropped), "info") end
    end)

    StoreMiniBtn.MouseButton1Click:Connect(function()
        if not equippedSlotIdx then return end
        local itemName = hotbarSlots[equippedSlotIdx]
        if not itemName then return end
        PlaySFX(ClickSFX, 1.05)
        local qty = math.max(1, math.floor(tonumber(QtyBox.Text) or 1))
        local tools = FindToolsByName(itemName)
        if #tools == 0 then return end
        local moveCount = math.min(qty, #tools)
        SaveToolTemplate(tools[1])
        local entry = EnsureBackpackEntry(itemName, GetItemImage(tools[1]))
        for i = 1, moveCount do
            local t = tools[i]
            suppressedToolNames[itemName] = (suppressedToolNames[itemName] or 0) + 1
            pcall(function() t:Destroy() end)
            entry.Count = entry.Count + 1
        end
        if #tools - moveCount <= 0 then
            hotbarSlots[equippedSlotIdx] = nil
            equippedSlotIdx = nil
            EquippedActionBar.Visible = false
        end
        if RebuildHotbarAndBackpack then RebuildHotbarAndBackpack() end
        if Window.NotifyAction then Window.NotifyAction("Inventário", "Itens guardados: " .. tostring(moveCount), "info") end
    end)

