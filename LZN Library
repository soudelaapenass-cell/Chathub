    local function BuildSliderRow(parent, cfg, order)
        cfg = cfg or {}
        local minV = cfg.Min or 0
        local maxV = cfg.Max or 100
        local decimals = cfg.Decimals or 0
        local currentV = math.clamp(cfg.Default or minV, minV, maxV)
        local hasReset = cfg.ResetValue ~= nil
        local dragging = false
        local activeDragInput = nil
        local activeDragType = nil

        local function fmt(v)
            if decimals > 0 then
                return string.format("%." .. tostring(decimals) .. "f", v)
            end
            return tostring(math.floor(v + 0.5))
        end

        local row = Instance.new("Frame")
