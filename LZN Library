        Pill.BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(24, 30, 45)
        Pill.Parent = Frame
        Instance.new("UICorner", Pill).CornerRadius = UDim.new(1, 0)

        local Knob = Instance.new("Frame")
        Knob.Size = UDim2.new(0, 16, 0, 16)
        Knob.Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
        Knob.BackgroundColor3 = Color3.new(1, 1, 1)
        Knob.Parent = Pill
        Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

        local function UpdateVisual(val, fireCallback)
            state = val
            TweenService:Create(Pill, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
                BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(24, 30, 45)
            }):Play()
            TweenService:Create(Knob, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
            }):Play()
            TweenService:Create(Stroke, TweenInfo.new(0.2), {
                Transparency = state and 0.25 or 0.55
            }):Play()
            if fireCallback then
                callback(state)
            end
        end

        Frame.MouseButton1Click:Connect(function()
            UpdateVisual(not state, true)
        end)

        return {
            Set = function(_, val)
                UpdateVisual(val, true)
            end,
            Get = function()
                return state
            end
        }
    end

    function WindowObj:AddDropdown(cfg)
        cfg = cfg or {}
        local labelPrefix = cfg.Text or "Opção"
        local items = cfg.Items or {}
        local selected = cfg.Default or (items[1] or "Nenhum")
        local callback = cfg.Callback or function() end

        local Wrapper = Instance.new("Frame")
        Wrapper.Size = UDim2.new(1, 0, 0, 38)
        Wrapper.BackgroundTransparency = 1
        Wrapper.LayoutOrder = self:NextOrder()
        Wrapper.ClipsDescendants = true
        Wrapper.Parent = ContentContainer

        local MainBtn = Instance.new("TextButton")
        MainBtn.Size = UDim2.new(1, 0, 0, 38)
        MainBtn.BackgroundColor3 = Theme.Element
        MainBtn.Text = labelPrefix .. ": " .. tostring(selected) .. "  ▾"
        MainBtn.TextColor3 = Theme.TextMain
        MainBtn.Font = Enum.Font.GothamBold
        MainBtn.TextSize = 13
        MainBtn.ZIndex = 10
        MainBtn.Parent = Wrapper
        Instance.new("UICorner", MainBtn).CornerRadius = UDim.new(0, 10)
        AddGlow(MainBtn, Theme.Accent, 1, 0.5)
        AddClickEffect(MainBtn)

        local ListFrame = Instance.new("Frame")
        ListFrame.Size = UDim2.new(1, 0, 0, #items * 32)
        ListFrame.Position = UDim2.new(0, 0, 0, 42)
        ListFrame.BackgroundColor3 = Theme.DropBg
        ListFrame.ZIndex = 9
        ListFrame.Parent = Wrapper
        Instance.new("UICorner", ListFrame).CornerRadius = UDim.new(0, 10)
        AddGlow(ListFrame, Theme.Accent, 1.2, 0.3)

        local isOpen = false

        local function ToggleDrop(forceClose)
            if forceClose then
                isOpen = false
            else
                isOpen = not isOpen
            end
            if isOpen then
                self:CloseAllDropdowns(ToggleDrop)
            end
            local targetH = isOpen and (42 + (#items * 32)) or 38
            MainBtn.Text = labelPrefix .. ": " .. tostring(selected) .. (isOpen and "  ▴" or "  ▾")
            TweenService:Create(Wrapper, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, targetH)
            }):Play()
        end

        table.insert(self.OpenDropdowns, function()
            if isOpen then
                ToggleDrop(true)
            end
        end)

        MainBtn.MouseButton1Click:Connect(function()
            ToggleDrop(false)
        end)

        for i, item in ipairs(items) do
            local ItemBtn = Instance.new("TextButton")
            ItemBtn.Size = UDim2.new(1, 0, 0, 32)
            ItemBtn.Position = UDim2.new(0, 0, 0, (i - 1) * 32)
            ItemBtn.BackgroundTransparency = 1
            ItemBtn.Text = tostring(item)
            ItemBtn.TextColor3 = Theme.TextMain
            ItemBtn.Font = Enum.Font.GothamMedium
            ItemBtn.TextSize = 13
            ItemBtn.ZIndex = 11
            ItemBtn.Parent = ListFrame
            AddClickEffect(ItemBtn)

            ItemBtn.MouseButton1Click:Connect(function()
                selected = item
                ToggleDrop(true)
                callback(item)
            end)
        end

        return {
            SetDisplay = function(_, customText)
                selected = customText
                MainBtn.Text = labelPrefix .. ": " .. tostring(selected) .. (isOpen and "  ▴" or "  ▾")
            end,
            Close = function()
                ToggleDrop(true)
            end
        }
    end

    function WindowObj:AddStepper(cfg)
        cfg = cfg or {}
        local label = cfg.Text or "VALOR"
        local value = cfg.Default or 100
        local minVal = cfg.Min or 1
        local maxVal = cfg.Max or 999999999
        local stepRef = cfg.GetStep or function() return cfg.Step or 50 end
        local turbo = cfg.Turbo ~= false
        local callback = cfg.Callback or function() end

        local Frame = Instance.new("Frame")
        Frame.Size = UDim2.new(1, 0, 0, 44)
        Frame.BackgroundTransparency = 1
        Frame.LayoutOrder = self:NextOrder()
        Frame.Parent = ContentContainer

        local MinusBtn = Instance.new("TextButton")
        MinusBtn.Size = UDim2.new(0, 44, 1, 0)
        MinusBtn.BackgroundColor3 = Theme.ElementAlt
        MinusBtn.Text = "-"
        MinusBtn.TextColor3 = Theme.Danger
        MinusBtn.Font = Enum.Font.GothamBlack
        MinusBtn.TextSize = 22
        MinusBtn.Parent = Frame
        Instance.new("UICorner", MinusBtn).CornerRadius = UDim.new(0, 10)
        AddGlow(MinusBtn, Theme.Danger, 1.2, 0.4)
        AddClickEffect(MinusBtn)

        local PlusBtn = Instance.new("TextButton")
        PlusBtn.Size = UDim2.new(0, 44, 1, 0)
        PlusBtn.Position = UDim2.new(1, -44, 0, 0)
        PlusBtn.BackgroundColor3 = Theme.ElementAlt
        PlusBtn.Text = "+"
        PlusBtn.TextColor3 = Theme.Accent
        PlusBtn.Font = Enum.Font.GothamBlack
        PlusBtn.TextSize = 22
        PlusBtn.Parent = Frame
        Instance.new("UICorner", PlusBtn).CornerRadius = UDim.new(0, 10)
        AddGlow(PlusBtn, Theme.Accent, 1.2, 0.4)
        AddClickEffect(PlusBtn)

        local Display = Instance.new("TextLabel")
        Display.Size = UDim2.new(1, -100, 1, 0)
        Display.Position = UDim2.new(0, 50, 0, 0)
        Display.BackgroundColor3 = Theme.Header
        Display.TextColor3 = Theme.TextMain
        Display.TextScaled = true
        Display.Font = Enum.Font.GothamBold
        Display.Parent = Frame
        local Pad = Instance.new("UIPadding", Display)
        Pad.PaddingTop = UDim.new(0, 5)
        Pad.PaddingBottom = UDim.new(0, 5)
        Instance.new("UICorner", Display).CornerRadius = UDim.new(0, 10)
        AddGlow(Display, Theme.Accent, 1, 0.55)

        local function Refresh()
            value = math.clamp(value, minVal, maxVal)
            Display.Text = string.upper(label) .. "\n" .. string.format("%.0f", value)
            callback(value)
        end
        Refresh()

        local function BindHold(btn, dir)
            local holding = false
            btn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    holding = true
                    value = value + (dir * stepRef())
                    Refresh()
                    local holdTime = 0
                    while holding do
                        task.wait(0.05)
                        holdTime = holdTime + 0.05
                        if holdTime >= 0.3 then
                            local mult = turbo and math.max(1, math.floor(holdTime * 3)) or 1
                            value = value + (dir * stepRef() * mult)
                            Refresh()
                        end
                    end
                end
            end)
            btn.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    holding = false
                end
            end)
        end

        BindHold(MinusBtn, -1)
        BindHold(PlusBtn, 1)

        return {
            SetValue = function(_, newVal)
                value = newVal
                Refresh()
            end,
            GetValue = function()
                return value
            end
        }
    end

    function WindowObj:AddSlider(cfg)
        cfg = cfg or {}
        local text = cfg.Text or "Slider"
        local minVal = cfg.Min or 0
        local maxVal = cfg.Max or 100
        local value = math.clamp(cfg.Default or minVal, minVal, maxVal)
        local callback = cfg.Callback or function() end

        local Box = Instance.new("Frame")
        Box.Size = UDim2.new(1, 0, 0, 52)
        Box.BackgroundColor3 = Theme.Element
        Box.LayoutOrder = self:NextOrder()
        Box.Parent = ContentContainer
        Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 10)
        AddGlow(Box, Theme.Accent, 1, 0.5)

        local TopLabel = Instance.new("TextLabel")
        TopLabel.Size = UDim2.new(1, -24, 0, 22)
        TopLabel.Position = UDim2.new(0, 12, 0, 5)
        TopLabel.BackgroundTransparency = 1
        TopLabel.Text = text
        TopLabel.TextColor3 = Theme.TextMain
        TopLabel.Font = Enum.Font.GothamBold
        TopLabel.TextSize = 12
        TopLabel.TextXAlignment = Enum.TextXAlignment.Left
        TopLabel.Parent = Box

        local ValLabel = Instance.new("TextLabel")
        ValLabel.Size = UDim2.new(1, -24, 0, 22)
        ValLabel.Position = UDim2.new(0, 12, 0, 5)
        ValLabel.BackgroundTransparency = 1
        ValLabel.Text = tostring(value)
        ValLabel.TextColor3 = Theme.Accent
        ValLabel.Font = Enum.Font.GothamBold
        ValLabel.TextSize = 12
        ValLabel.TextXAlignment = Enum.TextXAlignment.Right
        ValLabel.Parent = Box

        local Track = Instance.new("TextButton")
        Track.Size = UDim2.new(1, -24, 0, 8)
        Track.Position = UDim2.new(0, 12, 0, 33)
        Track.BackgroundColor3 = Color3.fromRGB(22, 28, 42)
        Track.Text = ""
        Track.AutoButtonColor = false
        Track.Parent = Box
        Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

        local Fill = Instance.new("Frame")
        Fill.Size = UDim2.new((value - minVal) / math.max(1, maxVal - minVal), 0, 1, 0)
        Fill.BackgroundColor3 = Theme.Accent
        Fill.BorderSizePixel = 0
        Fill.Parent = Track
        Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

        local draggingSlider = false
        local function UpdateFromInput(input)
            local rel = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
            value = math.floor(minVal + (maxVal - minVal) * rel + 0.5)
            ValLabel.Text = tostring(value)
            Fill.Size = UDim2.new(rel, 0, 1, 0)
            callback(value)
        end

        Track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = true
                UpdateFromInput(input)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                UpdateFromInput(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = false
            end
        end)

        return {
            SetValue = function(_, newVal)
                value = math.clamp(newVal, minVal, maxVal)
                local rel = (value - minVal) / math.max(1, maxVal - minVal)
                ValLabel.Text = tostring(value)
                Fill.Size = UDim2.new(rel, 0, 1, 0)
                callback(value)
            end
        }
    end

    function WindowObj:AddTextbox(cfg)
        cfg = cfg or {}
        local placeholder = cfg.Placeholder or "Digite aqui..."
        local callback = cfg.Callback or function() end

        local Box = Instance.new("Frame")
        Box.Size = UDim2.new(1, 0, 0, 38)
        Box.BackgroundColor3 = Theme.Element
        Box.LayoutOrder = self:NextOrder()
        Box.Parent = ContentContainer
        Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 10)
        AddGlow(Box, Theme.Accent, 1, 0.5)

        local Input = Instance.new("TextBox")
        Input.Size = UDim2.new(1, -20, 1, 0)
        Input.Position = UDim2.new(0, 10, 0, 0)
        Input.BackgroundTransparency = 1
        Input.PlaceholderText = placeholder
        Input.PlaceholderColor3 = Theme.TextMuted
        Input.Text = cfg.Default or ""
        Input.TextColor3 = Theme.TextMain
        Input.Font = Enum.Font.GothamMedium
        Input.TextSize = 13
