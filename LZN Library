                    StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
                end)
                SyncPlayerToolsToInventory()
            end
            task.wait(0.25)
        end
    end)

    RunService.Heartbeat:Connect(function()
        local char = Player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if hrp then
            for dTool, active in pairs(droppedToolRegistry) do
                if active and dTool and dTool.Parent == workspace then
                    local handle = dTool:FindFirstChild("Handle") or dTool:FindFirstChildWhichIsA("BasePart")
                    if handle and (handle.Position - hrp.Position).Magnitude <= 5.5 then
                        CollectDroppedTool(dTool)
                    end
                elseif not dTool or dTool.Parent ~= workspace then
                    droppedToolRegistry[dTool] = nil
                end
            end
        end

        if godModeActive and char and hum and hrp then
            pcall(function()
                if hum:GetState() == Enum.HumanoidStateType.Dead then
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
                hum.BreakJointsOnDeath = false
                hum.MaxHealth = math.huge
                hum.Health = math.huge
                local vel = hrp.AssemblyLinearVelocity
                if math.abs(vel.Y) > 110 then
                    hrp.AssemblyLinearVelocity = Vector3.new(vel.X * 0.4, 0, vel.Z * 0.4)
                end
                if hrp.Position.Y > workspace.FallenPartsDestroyHeight + 20 then
                    lastSavedPos = hrp.Position
                elseif lastSavedPos then
                    hrp.CFrame = CFrame.new(lastSavedPos + Vector3.new(0, 3.5, 0))
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end)
        end

        if antiFlingActive and hrp then
            pcall(function()
                if hrp.AssemblyAngularVelocity.Magnitude > 35 then
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end)
        end

        if platformActive and platformPart and hrp then
            if not platformFixedY then
                platformFixedY = hrp.Position.Y - 3.6
            end
            platformPart.Position = Vector3.new(hrp.Position.X, platformFixedY, hrp.Position.Z)
        end
    end)

    UpdateHubHeight()
    return Window
end

return LZNLib
