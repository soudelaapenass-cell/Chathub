    local function SetTabColor(iconFrame, labelObj, btnObj, active)
        local col = active and accentColor or mutedTextColor
        labelObj.TextColor3 = col
        if btnObj then
            btnObj.BackgroundTransparency = active and 0.22 or 0.52
        end
        for _, child in ipairs(iconFrame:GetChildren()) do
