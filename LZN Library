        AddClickEffect(btn)

        local function setState(newState)
            state = newState
            btn.Text = baseText .. (state and "  [ON]" or "  [OFF]")
            TweenService:Create(btn, TweenInfo.new(0.2), {
                BackgroundTransparency = state and 0.25 or 1,
                TextColor3 = state and Color3.fromRGB(0, 255, 170) or Color3.fromRGB(190, 210, 230)
            }):Play()
            stroke.Color = state and Color3.fromRGB(0, 255, 170) or Color3.fromRGB(0, 170, 255)
            if cfg.Callback then cfg.Callback(state) end
        end

        btn.MouseButton1Click:Connect(function()
            setState(not state)
        end)

        local obj = {}
        function obj:Set(v) setState(v) end
        function obj:Get() return state end
        return obj
