    local function ApplyThemeValues(themeTbl)
        if type(themeTbl) ~= "table" then return end
        if themeTbl.Accent then accentColor = themeTbl.Accent end
        if themeTbl.Secondary then secondaryColor = themeTbl.Secondary end
        if themeTbl.Background then bgColor = themeTbl.Background end
        if themeTbl.Surface then surfaceColor = themeTbl.Surface end
        if themeTbl.Header then headerColor = themeTbl.Header end
        if themeTbl.Text then textColor = themeTbl.Text end
        if themeTbl.MutedText then mutedTextColor = themeTbl.MutedText end
        if themeTbl.Font then activeFont = themeTbl.Font end
        if themeTbl.CornerRadius then cornerRadiusPx = themeTbl.CornerRadius end
        if themeTbl.AnimSpeed then animSpeed = themeTbl.AnimSpeed end
        if themeTbl.BorderThickness then borderThickness = themeTbl.BorderThickness end
        if themeTbl.BorderTransparency then borderTransparency = themeTbl.BorderTransparency end
        if themeTbl.BackgroundTransparency then bgTransparency = themeTbl.BackgroundTransparency end
        if themeTbl.ElementTransparency then elementTransparency = themeTbl.ElementTransparency end

        MainFrame.BackgroundColor3 = bgColor
        MainFrame.BackgroundTransparency = bgTransparency
        HubBackground.ImageTransparency = bgTransparency
        HeaderFrame.BackgroundColor3 = headerColor
        tooltipStroke.Color = accentColor

        for _, item in ipairs(trackedStrokes) do
            if item.stroke and item.stroke.Parent then
                if item.isAccent then
                    item.stroke.Color = accentColor
                end
                item.stroke.Thickness = borderThickness
                item.stroke.Transparency = borderTransparency
            end
        end

        for _, item in ipairs(trackedCorners) do
            if item.corner and item.corner.Parent then
                local mult = item.scale or 1
                item.corner.CornerRadius = UDim.new(0, math.max(0, cornerRadiusPx * mult))
            end
        end

        for _, item in ipairs(trackedAccents) do
            if item.inst and item.inst.Parent then
                pcall(function()
                    item.inst[item.prop] = accentColor
                end)
            end
        end

        for _, item in ipairs(trackedSurfaces) do
            if item.Parent and item ~= MainFrame then
                pcall(function()
                    item.BackgroundColor3 = surfaceColor
                end)
            end
        end

        for _, item in ipairs(trackedTexts) do
            if item.inst and item.inst.Parent then
                pcall(function()
                    item.inst.TextColor3 = item.isMuted and mutedTextColor or textColor
                    item.inst.Font = activeFont
                end)
            end
        end
    end

