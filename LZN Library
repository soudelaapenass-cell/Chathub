        local function buildTranslator()
            local moduleRef = options.AutoTranslateModule
            if not moduleRef then
                moduleRef = ReplicatedStorage:FindFirstChild("AutoTranslate", true)
            end
            if not moduleRef and type(getgenv) == "function" then
                pcall(function()
                    local env = getgenv()
                    moduleRef = env.AutoTranslateModule or env.LZN_AutoTranslateModule
                end)
            end
            if type(moduleRef) == "string" then
                local numericRef = tonumber(moduleRef)
                if numericRef then
                    moduleRef = numericRef
                else
                    local path = moduleRef:gsub("^game%.ReplicatedStorage%.?", "")
                    local current = ReplicatedStorage
                    for segment in string.gmatch(path, "[^%.]+") do
                        current = current and current:FindFirstChild(segment)
                    end
                    if current then moduleRef = current end
                end
            end
            local moduleObject = options.AutoTranslate
            if not moduleObject and moduleRef then
                local ok, result = pcall(require, moduleRef)
                if ok then moduleObject = result end
            end
            if type(moduleObject) ~= "table" or type(moduleObject.new) ~= "function" then
                local localizationService = game:GetService("LocalizationService")
                local ok, playerTranslator = pcall(function()
                    return localizationService:GetTranslatorForPlayerAsync(Player)
                end)
                if ok then return playerTranslator end
                return nil
            end
            local ok, instance = pcall(function()
                return moduleObject.new({
                    TargetLang = selectedLanguage.Code,
                    SourceLang = "auto",
                    DelayBetweenRequests = 0.08
                })
            end)
            if ok then return instance end
            return nil
        end

        local translator = nil
        local translatedTextCache = {}
        local function translateGuiObject(object)
            if not translator or not object or not object.Parent then return end
            if not (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then return end
            local original = object.Text
            if type(original) ~= "string" or original == "" or translatedTextCache[original] ~= nil then
                if translatedTextCache[original] and object.Parent then object.Text = translatedTextCache[original] end
                return
            end
            if original:match("^rbxassetid://") or original:match("^#%x%x%x%x%x%x$") then return end
            local ok = pcall(function()
                if type(translator.TranslateAsync) == "function" then
                    translator:TranslateAsync(original, function(translatedText, err)
                        if not err and type(translatedText) == "string" and object.Parent then
                            translatedTextCache[original] = translatedText
                            object.Text = translatedText
                        end
                    end)
                elseif type(translator.Translate) == "function" then
                    local translatedText = translator:Translate(object, original)
                    if type(translatedText) == "string" and object.Parent then
                        translatedTextCache[original] = translatedText
                        object.Text = translatedText
                    end
                end
            end)
            if not ok then return end
        end

