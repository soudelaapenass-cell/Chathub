        nameLbl.Position = UDim2.new(0, 17, 0, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = cfg.Text or "Slider"
        nameLbl.TextColor3 = Color3.fromRGB(220, 236, 252)
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.TextSize = 10
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
        nameLbl.Parent = topBar

        local valLbl = Instance.new("TextLabel")
        valLbl.Size = UDim2.new(0.38, 0, 1, 0)
        valLbl.Position = UDim2.new(0.62, 0, 0, 0)
        valLbl.BackgroundTransparency = 1
        valLbl.Text = fmt(currentV)
        valLbl.TextColor3 = Color3.fromRGB(255, 196, 0)
        valLbl.Font = Enum.Font.GothamBlack
        valLbl.TextSize = 10
        valLbl.TextXAlignment = Enum.TextXAlignment.Right
        valLbl.Parent = topBar

        local hit = Instance.new("TextButton")
        hit.Size = UDim2.new(1, -18, 0, 20)
        hit.Position = UDim2.new(0, 9, 0, 23)
        hit.BackgroundTransparency = 1
        hit.Text = ""
        hit.Parent = sliderCard

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, 0, 0, 5)
        track.Position = UDim2.new(0, 0, 0.5, -2)
        track.BackgroundColor3 = Color3.fromRGB(22, 30, 46)
        track.BorderSizePixel = 0
        track.Parent = hit
        Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(0, 0, 1, 0)
        fill.BackgroundColor3 = accentColor
        fill.BorderSizePixel = 0
        fill.Parent = track
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

        local thumb = Instance.new("Frame")
        thumb.Size = UDim2.new(0, 12, 0, 12)
        thumb.Position = UDim2.new(0, -6, 0.5, -6)
        thumb.BackgroundColor3 = Color3.new(1, 1, 1)
        thumb.BorderSizePixel = 0
        thumb.Parent = track
        Instance.new("UICorner", thumb).CornerRadius = UDim.new(1, 0)
        local thumbGlow = AddGlow(thumb, accentColor, 1.5, 0.1)

        local function setHighlight(active)
            TweenService:Create(cardStroke, TweenInfo.new(0.16), {
                Transparency = active and 0.08 or 0.45,
                Thickness = active and 1.8 or 1.1
            }):Play()
            TweenService:Create(sliderCard, TweenInfo.new(0.16), {
                BackgroundTransparency = active and 0.1 or 0.25
            }):Play()
            thumb.Size = active and UDim2.new(0, 16, 0, 16) or UDim2.new(0, 12, 0, 12)
            local thumbSize = active and 16 or 12
            thumb.Position = UDim2.new(fill.Size.X.Scale, -(thumbSize / 2), 0.5, -(thumbSize / 2))
            thumbGlow.Transparency = active and 0 or 0.1
        end

        local function applyValue(v, fireCb)
            currentV = math.clamp(v, minV, maxV)
            if decimals == 0 then
                currentV = math.floor(currentV + 0.5)
            else
                local mult = 10 ^ decimals
                currentV = math.floor(currentV * mult + 0.5) / mult
            end
            local ratio = math.clamp((currentV - minV) / math.max(maxV - minV, 0.0001), 0, 1)
            fill.Size = UDim2.new(ratio, 0, 1, 0)
            local sz = dragging and 16 or 12
            thumb.Position = UDim2.new(ratio, -(sz / 2), 0.5, -(sz / 2))
            valLbl.Text = fmt(currentV)
            if fireCb and cfg.Callback then
                cfg.Callback(currentV)
            end
        end

        local dragOffsetX = 0

        local function updateFromInput(posX)
            local rel = math.clamp((posX - dragOffsetX - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
            applyValue(minV + (rel * (maxV - minV)), true)
        end

        local dragStartPosition = nil
        local dragMoved = false

        local function finishSliderDrag()
            if not dragging then return end
            local changedByUser = dragMoved
            dragging = false
            activeDragInput = nil
            activeDragType = nil
            dragStartPosition = nil
            dragOffsetX = 0
            dragMoved = false
            setHighlight(false)
            if changedByUser then
                Window.NotifyAction(cfg.Text or "Slider", "Valor: " .. fmt(currentV), "info")
            end
        end

        hit.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
            if dragging then return end
            dragging = true
            activeDragInput = input
            activeDragType = input.UserInputType
            dragStartPosition = input.Position
            dragMoved = false
            setHighlight(true)
            local thumbCenterX = thumb.AbsolutePosition.X + thumb.AbsoluteSize.X * 0.5
            local thumbCenterY = thumb.AbsolutePosition.Y + thumb.AbsoluteSize.Y * 0.5
            local pressedThumb = math.abs(input.Position.X - thumbCenterX) <= 15 and math.abs(input.Position.Y - thumbCenterY) <= 15
            dragOffsetX = pressedThumb and (input.Position.X - thumbCenterX) or 0
            if not pressedThumb then
                dragMoved = true
                updateFromInput(input.Position.X)
            end
            input.Changed:Connect(function(property)
                if property == "UserInputState" and input.UserInputState == Enum.UserInputState.End then
                    if activeDragInput == input then finishSliderDrag() end
                end
            end)
        end)

        UserInputService.TouchMoved:Connect(function(input)
            if not dragging or activeDragType ~= Enum.UserInputType.Touch then return end
            if input ~= activeDragInput and (not activeDragInput.TouchId or input.TouchId ~= activeDragInput.TouchId) then return end
            if dragStartPosition and (input.Position - dragStartPosition).Magnitude >= 0.1 then
                dragMoved = true
                updateFromInput(input.Position.X)
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if not dragging or not activeDragInput then return end
            local isMouseMove = activeDragType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement
            local isActiveTouch = activeDragType == Enum.UserInputType.Touch and input.UserInputType == Enum.UserInputType.Touch and (input == activeDragInput or (activeDragInput.TouchId and input.TouchId == activeDragInput.TouchId))
            if not isMouseMove and not isActiveTouch then return end
            if dragStartPosition and (input.Position - dragStartPosition).Magnitude >= 0.1 then
                dragMoved = true
                updateFromInput(input.Position.X)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if not dragging or not activeDragInput then return end
            if input == activeDragInput or (activeDragType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1) then
                finishSliderDrag()
            end
        end)

        if hasReset then
            local resetBtn = Instance.new("TextButton")
            resetBtn.Size = UDim2.new(0, 38, 1, 0)
            resetBtn.Position = UDim2.new(1, -38, 0, 0)
            resetBtn.BackgroundColor3 = Color3.fromRGB(16, 22, 34)
            resetBtn.BackgroundTransparency = 0.25
            resetBtn.Text = ""
            resetBtn.Parent = row
            Instance.new("UICorner", resetBtn).CornerRadius = UDim.new(0, 10)
            AddGlow(resetBtn, Color3.fromRGB(255, 165, 50), 1.1, 0.4)
            AddClickEffect(resetBtn)

