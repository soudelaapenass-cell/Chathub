        local list = Instance.new("Frame")
        list.Size = UDim2.new(1, 0, 0, #items * 30)
        list.Position = UDim2.new(0, 0, 0, 42)
        list.BackgroundColor3 = Color3.fromRGB(10, 13, 20)
        list.ZIndex = 25
        list.Parent = wrapper
        Instance.new("UICorner", list).CornerRadius = UDim.new(0, 10)
        AddGlow(list, accentColor, 1.2, 0.3)

        local optionButtons = {}

        local function refreshOptionsVisual()
            for _, entry in ipairs(optionButtons) do
                local active = selectedMap[entry.key] == true
                entry.btn.BackgroundColor3 = active and Color3.fromRGB(0, 120, 175) or Color3.fromRGB(14, 19, 30)
                entry.btn.BackgroundTransparency = active and 0.25 or 0.9
                entry.lbl.TextColor3 = active and Color3.fromRGB(0, 255, 185) or Color3.fromRGB(215, 232, 250)
                entry.box.BackgroundColor3 = active and Color3.fromRGB(0, 255, 170) or Color3.fromRGB(28, 36, 52)
            end
            dropBtn.Text = formatHeader()
        end

        for i, item in ipairs(items) do
