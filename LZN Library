local function GetRequest(url)
    local req = (type(request) == "function" and request)
        or (type(http_request) == "function" and http_request)
        or (syn and type(syn.request) == "function" and syn.request)
        or (http and type(http.request) == "function" and http.request)

    if req then
        local ok, response = pcall(function()
            return req({
                Url = url,
                Method = "GET",
                Headers = {
                    ["User-Agent"] = "Roblox/WinInet",
                    ["Accept"] = "application/json"
                }
            })
        end)
        if ok and response then
            local body = response.Body or response.body
            if type(body) == "string" and #body > 0 then
                local decodedOk, data = pcall(function() return HttpService:JSONDecode(body) end)
                if decodedOk and type(data) == "table" then
                    return data
                end
            end
        end
    end

    local okGet, raw = pcall(function()
        return game:HttpGet(url)
    end)
    if okGet and type(raw) == "string" and #raw > 0 then
        local decodedOk, data = pcall(function() return HttpService:JSONDecode(raw) end)
        if decodedOk and type(data) == "table" then
            return data
        end
    end

    return nil
end

local function ResolveRealGameName(productInfo)
    if productInfo and type(productInfo.Name) == "string" and #productInfo.Name > 0 then
        local low = string.lower(productInfo.Name)
        if low ~= "ugc" and low ~= "place" then
            return productInfo.Name
        end
    end

    if game.GameId and game.GameId > 0 then
        local universeData = GetRequest("https://games.roblox.com/v1/games?universeIds=" .. tostring(game.GameId))
        local uInfo = universeData and universeData.data and universeData.data[1]
        if uInfo and type(uInfo.name) == "string" and #uInfo.name > 0 and string.lower(uInfo.name) ~= "ugc" then
            return uInfo.name
        end
    end

    local okPlace, placeInfo = pcall(function()
        return MarketplaceService:GetProductInfo(game.PlaceId, Enum.InfoType.Asset)
    end)
    if okPlace and placeInfo and type(placeInfo.Name) == "string" and #placeInfo.Name > 0 and string.lower(placeInfo.Name) ~= "ugc" then
        return placeInfo.Name
    end

    if type(game.Name) == "string" and #game.Name > 0 and string.lower(game.Name) ~= "ugc" then
        return game.Name
    end

    return "Mapa #" .. tostring(game.PlaceId)
end

