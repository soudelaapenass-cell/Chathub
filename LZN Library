        list.ZIndex = 25
        list.Parent = wrapper
        Instance.new("UICorner", list).CornerRadius = UDim.new(0, 10)
        AddGlow(list, Color3.fromRGB(0, 190, 255), 1.2, 0.3)

        local function toggle(forceClose)
            if forceClose then
                isOpen = false
            else
                isOpen = not isOpen
                PlaySFX(DropdownSFX, isOpen and 1.12 or 0.92)
            end
            local targetH = isOpen and (42 + (#items * 30)) or 38
            dropBtn.Text = label .. ": " .. tostring(current) .. (isOpen and "  ▴" or "  ▾")
            TweenService:Create(wrapper, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, targetH)
            }):Play()
        end

        for i, item in ipairs(items) do
            local itemBtn = Instance.new("TextButton")
            itemBtn.Size = UDim2.new(1, 0, 0, 30)
            itemBtn.Position = UDim2.new(0, 0, 0, (i - 1) * 30)
            itemBtn.BackgroundTransparency = 1
            itemBtn.Text = tostring(item)
            itemBtn.TextColor3 = Color3.fromRGB(220, 235, 255)
            itemBtn.Font = Enum.Font.GothamMedium
            itemBtn.TextSize = 12
            itemBtn.ZIndex = 26
            itemBtn.Parent = list
            AddClickEffect(itemBtn)

            itemBtn.MouseButton1Click:Connect(function()
                PlaySFX(ClickSFX, 1.08)
                current = item
                toggle(true)
                if cfg.Callback then cfg.Callback(item) end
            end)
        end

        dropBtn.MouseButton1Click:Connect(function()
            toggle(false)
        end)

        local obj = {}
        function obj:SetValue(v)
            current = v
            dropBtn.Text = label .. ": " .. tostring(current) .. (isOpen and "  ▴" or "  ▾")
        end
        return obj
    end

    function Window:AddMultiDropdown(cfg)
        cfg = cfg or {}
        local label = cfg.Text or "Múltiplos"
        local items = cfg.Options or {}
        local selectedMap = {}
        local isOpen = false

        if type(cfg.Default) == "table" then
            for _, v in ipairs(cfg.Default) do
                selectedMap[tostring(v)] = true
            end
        end

        local function getSelectedList()
            local res = {}
            for _, item in ipairs(items) do
                local key = tostring(item)
                if selectedMap[key] then
                    table.insert(res, item)
                end
            end
            return res
        end

        local function formatHeader()
            local sel = getSelectedList()
            local preview = #sel > 0 and table.concat(sel, ", ") or "Nenhum"
            return label .. ": " .. preview .. (isOpen and "  ▴" or "  ▾")
        end

        local wrapper = Instance.new("Frame")
        wrapper.Size = UDim2.new(1, 0, 0, 38)
        wrapper.BackgroundTransparency = 1
        wrapper.LayoutOrder = NextOrder()
        wrapper.ClipsDescendants = true
        wrapper.ZIndex = 24
        wrapper.Parent = ActiveContainer

        local dropBtn = Instance.new("TextButton")
        dropBtn.Size = UDim2.new(1, 0, 0, 38)
        dropBtn.BackgroundColor3 = Color3.fromRGB(14, 18, 28)
        dropBtn.BackgroundTransparency = 0.25
        dropBtn.Text = formatHeader()
        dropBtn.TextColor3 = Color3.fromRGB(220, 235, 255)
        dropBtn.Font = Enum.Font.GothamBold
        dropBtn.TextSize = 11
        dropBtn.TextTruncate = Enum.TextTruncate.AtEnd
