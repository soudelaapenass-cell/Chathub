    local function SafeCallback(callback, ...)
        if type(callback) == "function" then
            local args = {...}
            local ok, err = pcall(function() callback(unpack(args)) end)
            if not ok then warn("[LZN Library] Callback error: " .. tostring(err)) end
            return ok
        end
        return false
    end

    local function MakeComponentHandle(instance, getter, setter)
        local handle = {Instance = instance}
        function handle:SetText(value)
            if instance and instance.Parent then
                local target = (instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox")) and instance or nil
                if target then target.Text = tostring(value) end
                local label = instance:FindFirstChildWhichIsA("TextLabel", true)
                if label then label.Text = tostring(value) end
            end
            return handle
        end
        function handle:SetVisible(value)
            if instance then instance.Visible = value == true end
            return handle
        end
        function handle:SetValue(value, fire)
            if setter then setter(value, fire ~= false) end
            return handle
        end
        function handle:GetValue()
            if getter then return getter() end
            return nil
        end
        function handle:Destroy()
            if instance then instance:Destroy() end
        end
        function handle:Get()
            return instance
        end
        return handle
    end

    local function NormalizeComponent(result)
        if typeof(result) == "Instance" then return MakeComponentHandle(result) end
        if type(result) ~= "table" then return result end
        if result.__lznHandle then return result end
        result.__lznHandle = true
        local oldSetText = result.SetText
        local oldSetValue = result.SetValue or result.Set
        local oldGetValue = result.GetValue or result.Get or result.GetText
        local oldDestroy = result.Destroy
        function result:SetText(value)
            if oldSetText then pcall(oldSetText, self, value)
            elseif self.Instance then MakeComponentHandle(self.Instance):SetText(value) end
            return self
        end
        function result:SetVisible(value)
            local instance = self.Instance
            if instance then instance.Visible = value == true end
            return self
        end
        function result:SetValue(value, fire)
            if oldSetValue then pcall(oldSetValue, self, value, fire) end
            return self
        end
        function result:GetValue()
            if oldGetValue then local ok, value = pcall(oldGetValue, self); if ok then return value end end
            return nil
        end
        function result:Destroy()
            if oldDestroy then pcall(oldDestroy, self) end
            if self.Instance and self.Instance.Parent then self.Instance:Destroy() end
        end
        return result
    end

