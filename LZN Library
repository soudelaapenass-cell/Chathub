    local function CountAllTools()
        local counts = {}
        local bp = Player:FindFirstChild("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and not suppressedToolNames[t.Name] then
                    CacheToolTemplate(t)
                    counts[t.Name] = (counts[t.Name] or 0) + 1
                end
            end
        end
        local char = Player.Character
        if char then
            for _, t in ipairs(char:GetChildren()) do
                if t:IsA("Tool") and not suppressedToolNames[t.Name] then
                    CacheToolTemplate(t)
                    counts[t.Name] = (counts[t.Name] or 0) + 1
                end
            end
        end
        return counts
    end

    local function AssignSlotToEmptyOrSame(itemName)
        if suppressedToolNames[itemName] then return end
        for s = 1, 10 do
            if hotbarSlots[s] == itemName then
                return
            end
        end
        for s = 1, 10 do
            if hotbarSlots[s] == nil then
                hotbarSlots[s] = itemName
                return
            end
        end
    end

    local function SyncInventoryState()
        local counts = CountAllTools()

        for name, cnt in pairs(counts) do
            if cnt > 0 and not suppressedToolNames[name] then
                AssignSlotToEmptyOrSame(name)
            end
        end

        for s = 1, 10 do
            local name = hotbarSlots[s]
            if name and (not counts[name] or counts[name] <= 0) then
                hotbarSlots[s] = nil
                if equippedSlotIdx == s then
                    equippedSlotIdx = nil
                end
            end
        end

        backpackItems = {}
        for name, cnt in pairs(counts) do
            if cnt > 0 and not suppressedToolNames[name] then
                table.insert(backpackItems, {Name = name, Count = cnt})
            end
        end
        table.sort(backpackItems, function(a, b) return a.Name < b.Name end)

        lastKnownToolCounts = counts
    end

