            end
        }
    end

    function WindowObj:CreatePopup(cfg)
        cfg = cfg or {}
        local title = cfg.Title or "SELECIONE"
        local buttons = cfg.Buttons or {}
        local height = 52 + (#buttons * 46)

        local Popup = Instance.new("Frame")
        Popup.Size = UDim2.new(0, 260, 0, height)
        Popup.Position = UDim2.new(0.5, 0, 0.5, 0)
        Popup.AnchorPoint = Vector2.new(0.5, 0.5)
        Popup.BackgroundColor3 = Theme.DropBg
        Popup.Visible = false
        Popup.ZIndex = 120
        Popup.Parent = ScreenGui
        Instance.new("UICorner", Popup).CornerRadius = UDim.new(0, 14)
        AddGlow(Popup, Theme.Accent, 2, 0.1)
        AddGradient(Popup, Theme.BgGrad1, Theme.BgDark, 135)
        MakeDraggable(Popup)

        local PTitle = Instance.new("TextLabel")
        PTitle.Size = UDim2.new(1, 0, 0, 42)
        PTitle.BackgroundTransparency = 1
        PTitle.Text = title
        PTitle.TextColor3 = Theme.TextMain
        PTitle.Font = Enum.Font.GothamBold
        PTitle.TextSize = 14
        PTitle.ZIndex = 121
        PTitle.Parent = Popup

        for i, bCfg in ipairs(buttons) do
            local PBtn = Instance.new("TextButton")
            PBtn.Size = UDim2.new(0.84, 0, 0, 38)
            PBtn.Position = UDim2.new(0.08, 0, 0, 46 + (i - 1) * 46)
            PBtn.BackgroundColor3 = bCfg.Primary and Color3.fromRGB(0, 140, 255) or Theme.ElementAlt
            PBtn.Text = bCfg.Text or "Opção"
            PBtn.TextColor3 = bCfg.Primary and Color3.new(1, 1, 1) or Theme.TextMain
            PBtn.Font = Enum.Font.GothamBold
            PBtn.TextSize = 13
            PBtn.ZIndex = 121
            PBtn.Parent = Popup
            Instance.new("UICorner", PBtn).CornerRadius = UDim.new(0, 10)
            AddClickEffect(PBtn)

            if bCfg.Primary then
                AddGlow(PBtn, Theme.AccentLight, 1.2, 0.3)
                AddGradient(PBtn, Color3.fromRGB(0, 170, 255), Theme.AccentDark, 90)
            else
                AddGlow(PBtn, Theme.Accent, 1.2, 0.4)
            end

            PBtn.MouseButton1Click:Connect(function()
                Popup.Visible = false
                if bCfg.Callback then
                    bCfg.Callback()
                end
            end)
        end

        return {
            Show = function()
                Popup.Visible = true
            end,
            Hide = function()
                Popup.Visible = false
            end
        }
    end

    return WindowObj
end

return LZNLib
