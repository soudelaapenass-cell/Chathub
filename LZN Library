                    elseif draggingHue then
                        h = math.clamp((input.Position.Y - hueBar.AbsolutePosition.Y) / math.max(hueBar.AbsoluteSize.Y, 1), 0, 1)
                        updateColor(true)
                    end
                end
            end))

            cTracker:Add(UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    draggingSV = false
                    draggingHue = false
                end
            end))

            local api = {_frame = wrapper}
            function api:SetValue(newColor, fire)
                if typeof(newColor) == "Color3" then
                    h, s, v = Color3.toHSV(newColor)
                    updateColor(fire ~= false)
