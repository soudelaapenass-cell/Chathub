        local function applyLanguage()
            translator = buildTranslator()
            Window.Language = selectedLanguage.Code
            Window.LanguageName = selectedLanguage.Name
            if not translator then
                warn("[LZN Library] Idioma selecionado: " .. tostring(selectedLanguage.Code) .. ". Para traduzir os textos, forneça options.AutoTranslateModule com o ModuleScript/ID ou publique um ModuleScript chamado AutoTranslate em ReplicatedStorage.")
                return
            end
            for _, object in ipairs(ScreenGui:GetDescendants()) do
                translateGuiObject(object)
            end
            for _, object in ipairs(FullScreenBlurGui:GetDescendants()) do
                translateGuiObject(object)
            end
            table.insert(translateConnections, ScreenGui.DescendantAdded:Connect(function(object)
                task.defer(function() translateGuiObject(object) end)
            end))
            table.insert(translateConnections, FullScreenBlurGui.DescendantAdded:Connect(function(object)
                task.defer(function() translateGuiObject(object) end)
            end))
        end

