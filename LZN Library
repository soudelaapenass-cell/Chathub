d Colors.Yellow or Colors.Border}):Play() end)\n\n    vb.MouseButton1Click:Connect(function()\n        currentScriptData = data\n        currentScriptForView = data.script or \"-- No script provided\"\n        currentUrlForView = GetScriptUrl(data)\n        \n        MT.Text = \"📜 \"..(data.title or \"Script\")\n        GB.Text = \"🎮 \"..gname\n        SB.Text = data.isPatched and T(\"Patched\") or T(\"Working\")\n        SB.BackgroundColor3 = data.isPatched and Colors.Red or Colors.Primary\n        \n        ML.Text = string.format(\"❤️ %s | 👎 %s\", FormatNumber(likes), FormatNumber(dislikes))\n        SC.Text = currentScriptForView\n\n        SaveScriptBtn.Text = IsScriptSaved(data) and T(\"AlreadySaved\") or T(\"SaveScript\")\n\n        CommentsTabBtn.Text = string.format(T(\"Comments\"), 0)\n        SwitchModalTab(\"Desc\")\n        ModalOverlay.Visible = true\n\n        if data.slug then FetchScriptDetails(data.slug) end\n        if data._id then FetchAndRenderComments(data._id) end\n    end)\n\n    rb.MouseButton1Click:Connect(function()\n        local s = data.script or \"\"\n        if s ~= \"\" then\n            PromptExecute(data.title or \"Script\", function(confirmed)\n                if confirmed then\n                    rb.Text = \"⏳...\"\n                    task.spawn(function()\n                        local ok = pcall(function() loadstring(s)() end)\n                        rb.Text = ok and \"✓ Executed\" or \"✕ Error\"\n                        task.delay(1, function() rb.Text = T(\"Execute\") end)\n                    end)\n                end\n            end)\n        end\n    end)\n    return true\nend\n\nlocal function LoadSavedScriptsTab()\n    ClearContent(\"Saved\")\n    TabData.Saved = { page = 1, hasMore = false, isLoading = false, totalLoaded = 0, totalApi = 0, query = nil, seen = {} }\n    \n    if #SavedScriptsList > 0 then\n        for idx, item in ipairs(SavedScriptsList) do\n            CreateCard(item, idx, \"Saved\")\n        end