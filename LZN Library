        local function animatePopup(open)
            if popupTween then popupTween:Cancel() end
            popupOpen = open
            if open then
                local p = picker.Position
                picker.Visible = true
                picker.BackgroundTransparency = 1
                picker.Size = UDim2.new(0, 238, 0, 250)
