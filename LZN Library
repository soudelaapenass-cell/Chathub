    local function ShowTooltip(textStr, anchorPos)
        if not tooltipEnabled or not textStr or textStr == "" then return end
        TooltipLabel.Text = tostring(textStr)
        local textBounds = TooltipLabel.TextBounds
        local w = math.clamp(textBounds.X + 20, 70, 240)
        local h = math.clamp(textBounds.Y + 12, 24, 60)
        TooltipFrame.Size = UDim2.new(0, w, 0, h)
        local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
        local x = math.clamp((anchorPos and anchorPos.X or 100) + 12, 8, math.max(8, vp.X - w - 8))
        local y = math.clamp((anchorPos and anchorPos.Y or 100) - h - 8, 8, math.max(8, vp.Y - h - 8))
        TooltipFrame.Position = UDim2.new(0, x, 0, y)
        TooltipFrame.Visible = true
    end

    local function HideTooltip()
        activeTooltipSource = nil
        TooltipFrame.Visible = false
    end

    local function BindTooltip(guiObj, textStr)
        if not textStr or textStr == "" then return end
        windowTracker:Add(guiObj.MouseEnter:Connect(function()
            activeTooltipSource = textStr
            local mLoc = UserInputService:GetMouseLocation()
            ShowTooltip(textStr, mLoc)
        end))
        windowTracker:Add(guiObj.MouseMoved:Connect(function(x, y)
            if activeTooltipSource == textStr then
                ShowTooltip(textStr, Vector2.new(x, y))
            end
        end))
        windowTracker:Add(guiObj.MouseLeave:Connect(function()
            if activeTooltipSource == textStr then
                HideTooltip()
            end
        end))
    end

