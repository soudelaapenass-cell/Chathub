                AddClickEffect(extBtn)

                local isPressing, isDragging, dragStart, startPos, activeInput = false, false, nil, nil, nil
                extBtn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        isPressing = true
                        isDragging = false
                        activeInput = input
                        dragStart = input.Position
                        startPos = extBtn.Position
                        if cfg.Hold then
                            task.spawn(function()
                                task.wait(0.28)
                                while isPressing and not isDragging do
                                    if cfg.Callback then cfg.Callback() end
                                    task.wait(0.06)
                                end
                            end)
                        end
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if isPressing and input == activeInput then
                        local delta = input.Position - dragStart
                        if delta.Magnitude > 8 then isDragging = true end
                        if isDragging then
                            extBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                        end
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if isPressing and input == activeInput then
                        if not isDragging and cfg.Callback then
                            cfg.Callback()
                        end
                        isPressing = false
                        isDragging = false
                        activeInput = nil
                    end
                end)

                spawnBtn.BackgroundTransparency = 0.2
                spawnBtn.BackgroundColor3 = Color3.fromRGB(0, 130, 230)
                extStroke.Color = Color3.fromRGB(140, 230, 255)
            end
        end)
