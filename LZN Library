    local function EquipSlot(slotIdx)
        local itemName = hotbarSlots[slotIdx]
        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not itemName or not hum or not char then return end

        PlaySFX(ClickSFX, 1.05)

        if equippedSlotIdx == slotIdx then
            equippedSlotIdx = nil
            pcall(function()
                hum:UnequipTools()
                local bp = Player:FindFirstChildOfClass("Backpack")
                if bp then
                    for _, t in ipairs(char:GetChildren()) do
                        if t:IsA("Tool") then
                            t.Parent = bp
                        end
                    end
                end
            end)
            EquippedActionBar.Visible = false
            return
        end

        local tools = FindToolsByName(itemName)
        if #tools > 0 then
            local toolToEquip = tools[1]
            SaveToolTemplate(toolToEquip)
            equippedSlotIdx = slotIdx
            pcall(function()
                hum:UnequipTools()
                toolToEquip.Parent = char
                hum:EquipTool(toolToEquip)
                if toolToEquip.Parent ~= char then
                    toolToEquip.Parent = char
                end
            end)
            EquippedActionBar.Visible = true
        else
            local restored = GiveRealToolToPlayer(itemName, nil, true)
            if restored then
                equippedSlotIdx = slotIdx
                EquippedActionBar.Visible = true
            end
        end
    end

    local function CollectDroppedTool(tool)
        if not tool or not tool:IsA("Tool") or not tool.Parent then return end
        SaveToolTemplate(tool)
        local bp = Player:FindFirstChildOfClass("Backpack")
        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not bp or not char then return end

        droppedToolRegistry[tool] = nil
        pcall(function()
            tool.Parent = bp
            if hum then
                hum:EquipTool(tool)
            end
        end)

        local existsInHotbar = false
        for s = 1, 10 do
            if hotbarSlots[s] == tool.Name then
                existsInHotbar = true
                break
            end
        end
        if not existsInHotbar then
            for s = 1, 10 do
                if not hotbarSlots[s] then
                    hotbarSlots[s] = tool.Name
                    break
                end
            end
        end

        if RebuildHotbarAndBackpack then
            RebuildHotbarAndBackpack()
        end
    end

    DropMiniBtn.MouseButton1Click:Connect(function()
        if not equippedSlotIdx then return end
        local itemName = hotbarSlots[equippedSlotIdx]
        if not itemName then return end
        PlaySFX(ClickSFX, 0.95)
        local qty = math.max(1, math.floor(tonumber(QtyBox.Text) or 1))
        local tools = FindToolsByName(itemName)
        local char = Player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local dropped = 0

        for _, t in ipairs(tools) do
            if dropped >= qty then break end
            SaveToolTemplate(t)
            pcall(function()
                if t.Parent == char and hum then
                    hum:UnequipTools()
                end
                t.CanBeDropped = true
                local baseCF = hrp and (hrp.CFrame * CFrame.new(0, 1.5, -3.5 - (dropped * 0.8))) or CFrame.new(0, 5, 0)
                for _, p in ipairs(t:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.Anchored = false
                        p.CanCollide = true
                        p.CFrame = baseCF
                    end
                end
                t.Parent = workspace
                droppedToolRegistry[t] = true
                for _, p in ipairs(t:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.Touched:Connect(function(hit)
                            if droppedToolRegistry[t] and char and hit and hit:IsDescendantOf(char) then
                                CollectDroppedTool(t)
                            end
                        end)
                    end
                end
            end)
            dropped = dropped + 1
        end

        if #tools - dropped <= 0 then
            hotbarSlots[equippedSlotIdx] = nil
            equippedSlotIdx = nil
            EquippedActionBar.Visible = false
        end
        if RebuildHotbarAndBackpack then RebuildHotbarAndBackpack() end
        if Window.NotifyAction then Window.NotifyAction("Inventário", "Item descartado: " .. tostring(dropped), "info") end
    end)

    StoreMiniBtn.MouseButton1Click:Connect(function()
