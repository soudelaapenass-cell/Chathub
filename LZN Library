        local binding = Window.KeybindManager:Bind(key, cfg.Callback)
        button.MouseButton1Click:Connect(function() listening = true; button.Text = tostring(cfg.Text or "Atalho") .. ": ..." end)
        local connection
        connection = UserInputService.InputBegan:Connect(function(input, processed)
            if not listening or processed then return end
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                listening = false
                binding:Destroy()
                key = input.KeyCode
                binding = Window.KeybindManager:Bind(key, cfg.Callback)
                button.Text = tostring(cfg.Text or "Atalho") .. ": " .. key.Name
                Window.NotifyAction(cfg.Text or "Atalho", "Tecla definida: " .. key.Name, "info")
            end
        end)
        local handle = MakeComponentHandle(button)
        function handle:GetValue() return key end
        function handle:Destroy() binding:Destroy(); if connection then connection:Disconnect() end; button:Destroy() end
        return handle
    end

    function Window:AddBindToggle(cfg)
        cfg = cfg or {}
        local state = cfg.Default == true
        local toggle = self:AddToggle({Text = cfg.Text or "Atalho", Default = state, Callback = function(v) state = v; SafeCallback(cfg.Callback, v) end})
        local key = cfg.Key or Enum.KeyCode.RightShift
        local connection = UserInputService.InputBegan:Connect(function(input, processed)
            if not processed and input.KeyCode == key then
                state = not state
                if toggle and toggle.Set then toggle:Set(state) end
            end
        end)
        local oldDestroy = toggle.Destroy
        function toggle:Destroy() connection:Disconnect(); if oldDestroy then oldDestroy(self) end; if self.Instance and self.Instance.Parent then self.Instance:Destroy() end end
        return toggle
    end

