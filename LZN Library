        AddClickEffect(plusBtn)

        local display = Instance.new("TextLabel")
        display.Size = UDim2.new(1, -100, 1, 0)
        display.Position = UDim2.new(0, 50, 0, 0)
        display.BackgroundColor3 = Color3.fromRGB(12, 16, 25)
        display.Text = label .. "\n" .. string.format("%.0f", value)
        display.TextColor3 = Color3.fromRGB(240, 248, 255)
        display.TextScaled = true
        display.Font = Enum.Font.GothamBold
        display.Parent = frame
        local pad = Instance.new("UIPadding", display)
        pad.PaddingTop = UDim.new(0, 5)
        pad.PaddingBottom = UDim.new(0, 5)
        Instance.new("UICorner", display).CornerRadius = UDim.new(0, 10)
        AddGlow(display, Color3.fromRGB(0, 170, 255), 1, 0.55)

        local function updateDisplay()
            value = math.clamp(value, minVal, maxVal)
            display.Text = label .. "\n" .. string.format("%.0f", value)
            if cfg.Callback then cfg.Callback(value) end
        end

        local function setupHold(btn, isPlus)
            local holding = false
            btn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    holding = true
                    value = value + (isPlus and step or -step)
                    updateDisplay()
                    local holdTime = 0
                    while holding do
                        task.wait(0.05)
                        holdTime = holdTime + 0.05
                        if holdTime >= 0.3 then
                            local turbo = step * math.floor(holdTime * 3)
                            value = value + (isPlus and turbo or -turbo)
                            updateDisplay()
                        end
                    end
                end
            end)
            btn.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    holding = false
                end
            end)
        end

        setupHold(minusBtn, false)
        setupHold(plusBtn, true)

        local obj = {}
        function obj:SetStep(s) step = s end
        function obj:GetValue() return value end
        function obj:SetValue(v)
            value = v
            updateDisplay()
        end
        return obj
    end

