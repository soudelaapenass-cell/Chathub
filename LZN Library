    local function SetCharacterNonCollide(enabled)
        local char = Player.Character
        if not char then return end
        if enabled then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    if savedNoCollide[p] == nil then
                        savedNoCollide[p] = p.CanCollide
                    end
                    p.CanCollide = false
                end
            end
        else
            for p, oldState in pairs(savedNoCollide) do
                if p and p.Parent then
                    p.CanCollide = oldState
                end
            end
            savedNoCollide = {}
        end
    end

    local function SyncPlayerCollisionStates()
        local char = Player.Character
        if not char then return end
        if antiFlingActive then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= Player and plr.Character then
                    for _, otherPart in ipairs(plr.Character:GetDescendants()) do
                        if otherPart:IsA("BasePart") then
                            otherPart.CanCollide = false
                        end
                    end
                end
            end
        else
            SetCharacterNonCollide(false)
        end
    end

    local function HookHazardPart(part)
        if not part:IsA("BasePart") or hookedHazardParts[part] then return end
        hookedHazardParts[part] = true
        part.Touched:Connect(function(hit)
            if not godModeActive then return end
            local char = Player.Character
            if char and hit and hit:IsDescendantOf(char) then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hum then
                    pcall(function()
                        if hum:GetState() == Enum.HumanoidStateType.Dead then
                            hum:ChangeState(Enum.HumanoidStateType.Running)
                        end
                        hum.MaxHealth = math.huge
                        hum.Health = math.huge
                    end)
                end
                if hrp and lastSavedPos and hrp.Position.Y <= workspace.FallenPartsDestroyHeight + 22 then
                    pcall(function()
                        hrp.CFrame = CFrame.new(lastSavedPos + Vector3.new(0, 3.5, 0))
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
            end
        end)
    end

