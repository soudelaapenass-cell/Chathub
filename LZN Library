    local function RegisterComponent(instance, object)
        local id = HttpService:GenerateGUID(false)
        ComponentRegistry[id] = {Instance = instance, Object = object}
        object.Id = id
        local oldDestroy = object.Destroy
        function object:Destroy()
            if oldDestroy then pcall(oldDestroy, self) end
            if instance and instance.Parent then instance:Destroy() end
            ComponentRegistry[id] = nil
        end
        function object:SetVisible(value)
            if instance then instance.Visible = value == true end
        end
        if not object.SetText then
            function object:SetText(value)
                if not instance then return end
                local label = (instance:IsA("TextLabel") or instance:IsA("TextButton")) and instance or nil
                if label then label.Text = tostring(value) else
                    for _, child in ipairs(instance:GetDescendants()) do
                        if child:IsA("TextLabel") or child:IsA("TextButton") then child.Text = tostring(value); break end
                    end
                end
            end
        end
        if not object.GetValue and object.Get then function object:GetValue() return self.Get() end end
        if not object.SetValue and object.Set then function object:SetValue(value) return self.Set(value, true) end end
        return object
    end

