    local function UpdateHubHeight()
        if manualResized then return end
        local curW = expandedMode and math.clamp(baseHubW + 130, minHubW, maxHubW) or baseHubW
        if expandedMode then
            local expH = math.clamp(baseHubH + 95, minHubH, maxHubH)
            TweenService:Create(MainFrame, TweenInfo.new(animSpeed, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, curW, 0, expH)
            }):Play()
            return
        end
        if CurrentPage ~= "Home" then
            TweenService:Create(MainFrame, TweenInfo.new(animSpeed, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, curW, 0, compactMode and 385 or 425)
            }):Play()
            return
        end
        local rawH = contentTopY + ContentLayout.AbsoluteContentSize.Y + (isBottomTabs and 44 or 16)
        local clampedH = math.clamp(rawH, 180, compactMode and 415 or 455)
        TweenService:Create(MainFrame, TweenInfo.new(animSpeed * 1.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, curW, 0, clampedH)
        }):Play()
    end

