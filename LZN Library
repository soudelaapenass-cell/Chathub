                trackFill.Size = UDim2.new(ratio, 0, 1, 0)
                knob.Position = UDim2.new(ratio, -5, 0.5, -5)
            end
        end)

        pcall(function() AudioSound:Play() end)
        SyncPlayPauseVisual()
