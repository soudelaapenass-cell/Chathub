            heartGuis[obj] = bg
        end
    else
        if highlights[obj] then
            highlights[obj]:Destroy()
            highlights[obj] = nil
        end
        if heartGuis[obj] then
            heartGuis[obj]:Destroy()
            heartGuis[obj] = nil
        end
    end
end

