local throwAction = function()
    local force = tonumber(tbThrowForce.Text) or 100
    local cam = workspace.CurrentCamera
    local targets = {}
    local fromHeld = next(heldObjects) ~= nil

    if fromHeld then
        for obj in pairs(heldObjects) do
            targets[obj] = true
        end
    elseif multiSelectToggle and next(selectedObjects) then
        for obj in pairs(selectedObjects) do
            targets[obj] = true
        end
    end

    if not next(targets) then
        notify(L.notifNoHeldThrow)
        return
    end

    local names = {}
    for obj in pairs(targets) do
        if obj and obj.Parent then
            table.insert(names, obj.Name)
            if obj:IsA("BasePart") then
                obj.CanCollide = true
                obj.AssemblyLinearVelocity = cam.CFrame.LookVector * force
            elseif obj:IsA("Model") then
                for _, part in ipairs(obj:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = true end
                end
                local rootPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
                if rootPart then rootPart.AssemblyLinearVelocity = cam.CFrame.LookVector * force end
            end
            updateHighlight(obj, false)
            playTelekinesisEffect(obj, true)
        end
    end

    for obj in pairs(heldObjects) do
        heldObjects[obj] = nil
    end
    relativeCFrames = {}
    clearTelekinesisBeams()
    if fromHeld then
        notify(L.notifThrown .. force .. ": " .. table.concat(names, ", "))
    else
        notify(L.notifThrownMulti .. table.concat(names, ", "))
        clearSelectionAndHighlights()
    end
end
