local function getObjectBasePart(obj)
    if not obj or not obj.Parent then return nil end
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true) end
    return nil
end

local function ensureTelekinesisBeam(obj)
    if telekinesisBeams[obj] then return end
    local targetPart = getObjectBasePart(obj)
    local character = player.Character
    local root = character and (character:FindFirstChild("Head") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso"))
