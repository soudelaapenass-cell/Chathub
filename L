local function playTelekinesisEffect(obj, releasing)
    if not obj or not obj.Parent then return end
    local part
    if obj:IsA("BasePart") then
        part = obj
    elseif obj:IsA("Model") then
        part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
    end
    if not part then return end

    local attachment = Instance.new("Attachment")
    attachment.Name = "LZN_TelekinesisFX"
    attachment.Parent = part

    local particles = Instance.new("ParticleEmitter")
    particles.Name = "LZN_EnergyBurst"
    particles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    particles.Color = ColorSequence.new(
        releasing and Color3.fromRGB(255, 95, 125) or Color3.fromRGB(80, 220, 255),
        Color3.fromRGB(190, 120, 255)
    )
    particles.LightEmission = 0.8
    particles.Lifetime = NumberRange.new(0.35, 0.8)
    particles.Speed = NumberRange.new(2, 5)
    particles.SpreadAngle = Vector2.new(180, 180)
    particles.Rate = 0
    particles.Rotation = NumberRange.new(0, 360)
    particles.RotSpeed = NumberRange.new(-100, 100)
    particles.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.22),
        NumberSequenceKeypoint.new(0.6, 0.12),
        NumberSequenceKeypoint.new(1, 0)
    })
    particles.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.05),
        NumberSequenceKeypoint.new(1, 1)
    })
    particles.Parent = attachment
    particles:Emit(releasing and 14 or 24)

    local glow = Instance.new("Highlight")
    glow.Name = "LZN_TelekinesisGlow"
    glow.Adornee = obj
    glow.FillColor = releasing and Color3.fromRGB(255, 90, 125) or Color3.fromRGB(70, 210, 255)
    glow.OutlineColor = Color3.fromRGB(200, 140, 255)
    glow.FillTransparency = 0.35
    glow.OutlineTransparency = 0.1
    glow.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    glow.Parent = screenGui
    TweenService:Create(glow, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        FillTransparency = 1,
        OutlineTransparency = 1
    }):Play()
    task.delay(0.7, function()
        if glow and glow.Parent then glow:Destroy() end
        if attachment and attachment.Parent then attachment:Destroy() end
    end)
end

local grabAction = function()
    if next(heldObjects) then
        local names = {}
        for obj, _ in pairs(heldObjects) do
            table.insert(names, obj.Name)
            playTelekinesisEffect(obj, true)
            if obj:IsA("BasePart") then obj.CanCollide = true
            elseif obj:IsA("Model") then
                for _, p in ipairs(obj:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = true end end
            end
            if not showPartToggle then updateHighlight(obj, false) end
        end
        heldObjects = {}
        notify(L.notifGrabOn .. table.concat(names, ", "))
        return
    end

    heldObjects = {}
    relativeCFrames = {}
    
    if currentHoverHighlight then
        currentHoverHighlight:Destroy()
        currentHoverHighlight = nil
        currentHoveredPart = nil
    end

    if multiSelectToggle and next(selectedObjects) then
        local centerPos = Vector3.new(0,0,0)
        local count = 0
        local namesList = {}
        
        for obj, _ in pairs(selectedObjects) do
            heldObjects[obj] = true
            playTelekinesisEffect(obj, false)
            table.insert(namesList, obj.Name)
            if not originalCFrames[obj] then
                pcall(function() originalCFrames[obj] = obj:GetPivot() end)
            end
            if obj:IsA("BasePart") then obj.CanCollide = true
            elseif obj:IsA("Model") then
                for _, p in ipairs(obj:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = true end end
            end
            local pos = obj:IsA("BasePart") and obj.Position or (obj:IsA("Model") and obj:GetPivot().Position)
            if pos then centerPos = centerPos + pos count = count + 1 end
        end
        
        if count > 0 then
            centerPos = centerPos / count
        end
        
        heldDistance = 10
        
        local refCFrame = CFrame.new(centerPos)
        for obj, _ in pairs(heldObjects) do
            local objCF = obj:IsA("BasePart") and obj.CFrame or (obj:IsA("Model") and obj:GetPivot())
            if objCF then
                relativeCFrames[obj] = refCFrame:Inverse() * objCF
            end
        end
        
        rotationOffset = CFrame.new()
        notify(L.notifGrabApp .. table.concat(namesList, ", "))
        clearSelectionAndHighlights()
    else
        local target = getTargetUnderCrosshairOrMouse()
        if target then
            heldObjects[target] = true
            playTelekinesisEffect(target, false)
            heldDistance = 10
            
            if not originalCFrames[target] then
                pcall(function() originalCFrames[target] = target:GetPivot() end)
            end
            if target:IsA("BasePart") then
                target.CanCollide = true
            elseif target:IsA("Model") then
                for _, p in ipairs(target:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = true end
                end
            end
            relativeCFrames[target] = CFrame.new()
            rotationOffset = CFrame.new()
            notify(L.notifGrabbed .. target.Name .. "]")
        else
            notify(L.notifNoObj)
        end
    end
end
