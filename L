local function isValidTarget(target)
    if not target then return false end
    if target:IsDescendantOf(player.Character) then return false end
    return true
end

local function getTargetUnderCrosshairOrMouse()
    local cam = workspace.CurrentCamera
    if crosshairToggle then
        local screenPos = Vector2.new(cam.ViewportSize.X / 2 + crosshairPosOffset.X, cam.ViewportSize.Y / 2 + crosshairPosOffset.Y)
        local unitRay = cam:ScreenPointToRay(screenPos.X, screenPos.Y)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {player.Character}
        local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 500, params)
        if result and result.Instance and isValidTarget(result.Instance) then
            local target = result.Instance
            if target.Parent:FindFirstChildOfClass("Humanoid") then
                return target.Parent
            end
            return target
        end
    else
        local target = mouse.Target
        if target and isValidTarget(target) then
            if target.Parent:FindFirstChildOfClass("Humanoid") then
                return target.Parent
            end
            return target
        end
    end
    return nil
end

local function updateHighlight(obj, enable)
    if enable then
        if not highlights[obj] then
            local hl = Instance.new("Highlight")
            hl.Adornee = obj
            hl.FillColor = Color3.fromRGB(0, 180, 255)
            hl.FillTransparency = 0.5
            hl.OutlineColor = Color3.fromRGB(0, 230, 255)
            hl.OutlineTransparency = 0.1
            hl.Parent = screenGui
            highlights[obj] = hl
        end
        if not heartGuis[obj] then
            local bg = Instance.new("BillboardGui")
            bg.Size = UDim2.new(0, 40, 0, 40)
            bg.StudsOffset = Vector3.new(0, 3, 0)
            bg.AlwaysOnTop = true
            bg.Adornee = obj:IsA("BasePart") and obj or (obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")))
            bg.Parent = screenGui
            
