            totalCount = totalCount + 1
            local itemBtn = Instance.new("TextButton")
            itemBtn.Size = UDim2.new(1, -6, 0, 32)
            itemBtn.Position = UDim2.new(0, 3, 0, y)
            itemBtn.BackgroundColor3 = Color3.fromRGB(22, 28, 42)
