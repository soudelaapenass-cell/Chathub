        beamRootAttachment.Parent = root
    end

    local targetAttachment = Instance.new("Attachment")
    targetAttachment.Name = "LZN_TelekinesisTarget"
    targetAttachment.Parent = targetPart

    local beam = Instance.new("Beam")
    beam.Name = "LZN_TelekinesisBeam"
    beam.Attachment0 = beamRootAttachment
