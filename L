            itemBtn.Parent = selectListFrame
            local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, 6) c.Parent = itemBtn
            local s = Instance.new("UIStroke") s.Color = Color3.fromRGB(0, 150, 220) s.Transparency = 0.7 s.Parent = itemBtn
            
            local vp = Instance.new("ViewportFrame")
            vp.Size = UDim2.new(0, 28, 0, 28)
            vp.Position = UDim2.new(0, 2, 0, 2)
            vp.BackgroundTransparency = 1
            vp.Parent = itemBtn
            
            pcall(function()
                local clone = obj:Clone()
                for _, desc in ipairs(clone:GetDescendants()) do
                    if desc:IsA("Script") or desc:IsA("LocalScript") or desc:IsA("ModuleScript") then
                        desc:Destroy()
                    end
                end
                if clone:IsA("BasePart") then
                    clone.Anchored = true
                    clone.CFrame = CFrame.new(0, 0, 0)
                    clone.Parent = vp
                elseif clone:IsA("Model") then
                    clone.Parent = vp
                    if not clone.PrimaryPart then
                        local p = clone:FindFirstChildOfClass("BasePart")
                        if p then clone.PrimaryPart = p end
                    end
                    pcall(function() clone:PivotTo(CFrame.new(0,0,0)) end)
                end
                local cam = Instance.new("Camera")
                vp.CurrentCamera = cam
                cam.Parent = vp
                local cf, size = clone:GetBoundingBox()
                local maxDim = math.max(size.X, size.Y, size.Z)
                local dist = math.clamp(maxDim * 2, 2, 50)
                cam.CFrame = CFrame.new(Vector3.new(0, dist * 0.5, dist), Vector3.new(0, 0, 0))
            end)
            
            itemBtn.MouseButton1Click:Connect(function()
                flashButton(itemBtn)
                playClickSfx()
                local name = obj.Name
                selectedObjects[obj] = nil
                updateHighlight(obj, false)
                updateSelectedListUI()
                notify(L.itemRemoved .. name .. "]")
            end)
            y = y + 35
        end
    end
    countLabel.Text = L.selectedCount .. totalCount
    selectListFrame.CanvasSize = UDim2.new(0, 0, 0, y)
end

local function clearSelectionAndHighlights()
    for obj, _ in pairs(selectedObjects) do
        updateHighlight(obj, false)
    end
    selectedObjects = {}
    updateSelectedListUI()
end

