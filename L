local function closePopup()
    if not langGui or not langGui.Parent then
        if blur and blur.Parent then
            blur:Destroy()
        end
        return
    end

    local fadeOutInfo = TweenInfo.new(
        0.55,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.In
    )

    local tweens = {}

    local function addTween(object, properties)
        if object and object.Parent then
            local tween = TweenService:Create(
                object,
                fadeOutInfo,
                properties
            )

            table.insert(tweens, tween)
            tween:Play()
        end
    end

    for _, object in ipairs(langGui:GetDescendants()) do
        if object:IsA("TextButton") then
            addTween(object, {
                BackgroundTransparency = 1,
                TextTransparency = 1,
                TextStrokeTransparency = 1
            })

        elseif object:IsA("TextLabel") then
            addTween(object, {
                BackgroundTransparency = 1,
                TextTransparency = 1,
                TextStrokeTransparency = 1
            })

        elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
            addTween(object, {
                BackgroundTransparency = 1,
                ImageTransparency = 1
            })

        elseif object:IsA("Frame") then
            addTween(object, {
                BackgroundTransparency = 1
            })

        elseif object:IsA("UIStroke") then
            addTween(object, {
                Transparency = 1
            })
        end
    end

    if blur and blur.Parent then
        addTween(blur, {
            Size = 0
        })
    end

    task.wait(0.6)

    if langGui and langGui.Parent then
        langGui:Destroy()
    end

    if blur and blur.Parent then
        blur:Destroy()
    end
end

