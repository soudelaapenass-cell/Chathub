local frameCount = 0
local lastFpsUpdate = tick()

RunService.RenderStepped:Connect(function(dt)
    frameCount = frameCount + 1
    totalUsageTime = totalUsageTime + dt
    pcall(function()
        if getgenv() then
            getgenv().LZN_Hub_SavedTime = totalUsageTime
        end
    end)
    
    if tick() - lastFpsUpdate >= 0.5 then
        local currentFps = math.floor(frameCount / (tick() - lastFpsUpdate))
        fpsLabel.Text = "FPS: " .. tostring(currentFps)
        frameCount = 0
        lastFpsUpdate = tick()
    end
    
    local hrs = math.floor(totalUsageTime / 3600)
    local mins = math.floor((totalUsageTime % 3600) / 60)
    local secs = math.floor(totalUsageTime % 60)
    timeLabel.Text = string.format("Tempo: %02d:%02d:%02d", hrs, mins, secs)
    roleTag.Text = getRoleTag()

    local selCount = 0
    for _ in pairs(selectedObjects) do selCount = selCount + 1 end
    local grabActive = next(heldObjects) ~= nil
    local spinActive = spinToggle or spinFullToggle

    swSelectedLabel.Text = L.selectedCount .. selCount
    swGrabLabel.Text = L.grabStatus .. (grabActive and L.active or L.inactive)
    swSpinLabel.Text = L.spinStatus .. (spinActive and L.active or L.inactive)
    
    if showPartToggle and not next(heldObjects) then
        local target = getTargetUnderCrosshairOrMouse()
        if target ~= currentHoveredPart then
            if currentHoverHighlight then
                currentHoverHighlight:Destroy()
                currentHoverHighlight = nil
            end
            currentHoveredPart = target
            if currentHoveredPart and not highlights[currentHoveredPart] and not frozenObjects[currentHoveredPart] and not selectedObjects[currentHoveredPart] then
                local hl = Instance.new("Highlight")
                hl.Adornee = currentHoveredPart
                hl.FillColor = Color3.fromRGB(0, 180, 255)
                hl.FillTransparency = 0.5
                hl.OutlineColor = Color3.fromRGB(0, 230, 255)
                hl.OutlineTransparency = 0.1
                hl.Parent = screenGui
                currentHoverHighlight = hl
            end
        end
    else
        if currentHoverHighlight then
            currentHoverHighlight:Destroy()
            currentHoverHighlight = nil
        end
        currentHoveredPart = nil
    end

    local spinDeltaY = 0
    local spinDeltaX = 0
    if spinToggle then
        spinDeltaY = math.rad(spinSpeed * dt * 60)
    end
    if spinFullToggle then
        spinDeltaY = math.rad(spinSpeed * dt * 60)
        spinDeltaX = math.rad(spinSpeed * dt * 60)
    end
    
    if spinDeltaY ~= 0 or spinDeltaX ~= 0 then
        rotationOffset = rotationOffset * CFrame.Angles(spinDeltaX, spinDeltaY, 0)
    end

    for obj, cf in pairs(frozenObjects) do
        if obj and obj.Parent then
            if spinDeltaY ~= 0 or spinDeltaX ~= 0 then
                local currentCF = obj:IsA("BasePart") and obj.CFrame or (obj:IsA("Model") and obj:GetPivot())
                if currentCF then
                    local updatedCF = currentCF * CFrame.Angles(spinDeltaX, spinDeltaY, 0)
                    frozenObjects[obj] = updatedCF
                    if obj:IsA("BasePart") then
                        obj.AssemblyLinearVelocity = Vector3.new(0,0,0)
                        obj.AssemblyAngularVelocity = Vector3.new(0,0,0)
                        obj.CFrame = updatedCF
                    elseif obj:IsA("Model") then
                        pcall(function()
                            if obj.PrimaryPart then
                                obj.PrimaryPart.AssemblyLinearVelocity = Vector3.new(0,0,0)
                                obj.PrimaryPart.AssemblyAngularVelocity = Vector3.new(0,0,0)
                            end
                            obj:PivotTo(updatedCF)
                        end)
                    end
                end
            else
                if obj:IsA("BasePart") then
                    obj.AssemblyLinearVelocity = Vector3.new(0,0,0)
                    obj.AssemblyAngularVelocity = Vector3.new(0,0,0)
                    obj.CFrame = cf
                elseif obj:IsA("Model") then
                    pcall(function()
                        if obj.PrimaryPart then
                            obj.PrimaryPart.AssemblyLinearVelocity = Vector3.new(0,0,0)
                            obj.PrimaryPart.AssemblyAngularVelocity = Vector3.new(0,0,0)
                        end
                        obj:PivotTo(cf)
                    end)
                end
            end
        else
            frozenObjects[obj] = nil
        end
    end

    if next(heldObjects) then
        local cam = workspace.CurrentCamera
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local baseTargetCF = root and (CFrame.new(root.Position + cam.CFrame.LookVector * heldDistance) * rotationOffset) or (cam.CFrame * CFrame.new(0, 0, -heldDistance) * rotationOffset)
        
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        local filterList = {player.Character}
        for obj, _ in pairs(heldObjects) do
            table.insert(filterList, obj)
            if obj:IsA("BasePart") then
                obj.CanCollide = true
            elseif obj:IsA("Model") then
                for _, p in ipairs(obj:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = true end
                end
            end
        end
        rayParams.FilterDescendantsInstances = filterList
        
        local origin = cam.CFrame.Position
        local desiredPos = baseTargetCF.Position
        local rayResult = workspace:Raycast(origin, desiredPos - origin, rayParams)
        
        if rayResult then
            baseTargetCF = CFrame.new(rayResult.Position - (desiredPos - origin).Unit * 1.5) * (baseTargetCF - baseTargetCF.Position)
        end
        
        for obj, _ in pairs(heldObjects) do
            if obj and obj.Parent and not frozenObjects[obj] then
                local relCF = relativeCFrames[obj] or CFrame.new()
                local targetCFrame = baseTargetCF * relCF
                
                if not originalCFrames[obj] then
                    pcall(function() originalCFrames[obj] = obj:GetPivot() end)
                end
                
                local currentCF = obj:IsA("BasePart") and obj.CFrame or obj:GetPivot()
                local nextCF

                if realisticLineToggle then
                    local state = realisticSpringStates[obj]
                    if not state then
                        state = {
                            position = currentCF.Position,
                            velocity = Vector3.new(0, 0, 0)
                        }
                        realisticSpringStates[obj] = state
                    end

                    local step = math.min(dt, 1 / 30)
                    local stiffness = 38
                    local damping = 5.2
                    local acceleration = (targetCFrame.Position - state.position) * stiffness - state.velocity * damping
                    state.velocity = state.velocity + acceleration * step
                    state.position = state.position + state.velocity * step
                    nextCF = CFrame.new(state.position) * targetCFrame.Rotation
                else
                    realisticSpringStates[obj] = nil
                    nextCF = currentCF:Lerp(targetCFrame, math.clamp(dt * 15, 0, 1))
                end

                if obj:IsA("BasePart") then
                    obj.CanCollide = true
                    if realisticLineToggle then
                        obj.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        obj.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    else
                        obj.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        obj.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    end
                    obj.CFrame = nextCF
                elseif obj:IsA("Model") then
                    for _, p in ipairs(obj:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = true end
                    end
                    obj:PivotTo(nextCF)
                end
            end
        end
    end
end)
